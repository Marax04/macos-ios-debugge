# Build artefacts — rebuilt by CI, never published.
/target/
**/target/
*.pdb
*.exe
*.dll
*.so
*.dylib
*.rlib
*.d

# Decompiler corpus OUTPUT: ~11k generated .c files, regenerated by the driver.
tests/decompiler_corpus/out/
tests/decompiler_corpus/runs/

# Local scratch / notes that are not part of the source.
/vmbox/
/oldcreates/
*.log
*.tmp

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python bytecode from the measurement scripts
__pycache__/
*.pyc

# File con nome anomalo (spazio finale) che git non riesce a indicizzare.
# Escluso, non rimosso: non e' materiale del progetto ma non e' mio da cancellare.
0 should be *

# Artefatti RIGENERABILI del corpus decompiler (89k file misurati).
# Il repo pubblica sorgenti e configurazione, non output prodotti dal driver:
# si ricreano con `dump_decompile.exe` e non hanno valore in cronologia.
tests/decompiler_corpus/behav/
tests/decompiler_corpus/fuzz_e2e/
tests/decompiler_corpus/out_audit_*/
tests/decompiler_corpus/out*/

# Immagini VM macOS per i test iOS/Darwin. BaseSystem.dmg da solo pesa 752 MB:
# GitHub rifiuta ogni singolo file oltre 100 MB, quindi il push dell'intero
# repo fallirebbe. Sono artefatti scaricabili, non sorgenti del progetto.
tests/mcios/
*.dmg
*.qcow2
*.iso
*.vmdk

# Protettori commerciali usati come bersagli di test (Themida, Code Virtualizer):
# software di terzi sotto licenza, non ridistribuibile in un repo pubblico.
tools/*.zip
