/// Look up an emulator back-end descriptor by short name.
pub struct EmuBackendsRegistryFindTool;

impl EmuBackendsRegistryFindTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_backends_registry_find".to_string(),
            description: "Look up a wired emulator back-end descriptor by its short name \
                          via rustre_emu::backends_registry::find.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuBackendsRegistryFindTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".to_string()))?;
        let descriptor = rustre_emu::backends_registry::find(name);
        let found = descriptor.is_some();
        let (crate_name, primary_type) = descriptor
            .map(|d| (d.crate_name.to_string(), d.primary_type.to_string()))
            .unwrap_or_default();
        Ok(ToolResult::text(json!({
            "name": name,
            "found": found,
            "crate_name": crate_name,
            "primary_type": primary_type,
            "source": "rustre_emu::backends_registry::find",
        }).to_string()))
    }
}

