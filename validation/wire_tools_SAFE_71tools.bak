// â”€â”€â”€ rustre-trace-pt wrappers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Decode a raw Intel PT buffer and return summary of packets + trace.
pub struct TracePtDecodeBufferTool;

impl TracePtDecodeBufferTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_pt_decode_buffer".to_string(),
            description:
                "Decode a raw Intel Processor Trace (PT) byte buffer into packets \
                 and a reconstructed StreamTrace. Returns packet count, unique IP \
                 count and instruction count."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TracePtDecodeBufferTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = extract_byte_array(&args, "bytes", "hex")?;
        let (packets, trace) = rustre_trace_pt::decode_pt_buffer_verbose(&data);
        let unique = rustre_trace_pt::pt_to_coverage(&trace).len();
        Ok(ToolResult::text(
            json!({
                "bytes_in":       data.len(),
                "packet_count":   packets.len(),
                "unique_ips":     unique,
                "source":         "rustre_trace_pt::decode_pt_buffer_verbose",
            })
            .to_string(),
        ))
    }
}

/// Extract unique IP coverage from a raw PT buffer.
pub struct TracePtCoverageTool;

impl TracePtCoverageTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_pt_coverage".to_string(),
            description:
                "Decode raw Intel PT bytes and return sorted unique instruction \
                 pointer values (edge/block coverage set)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TracePtCoverageTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = extract_byte_array(&args, "bytes", "hex")?;
        let trace = rustre_trace_pt::decode_pt_buffer(&data);
        let cov = rustre_trace_pt::pt_to_coverage(&trace);
        let mut ips: Vec<u64> = cov.into_iter().collect();
        ips.sort_unstable();
        Ok(ToolResult::text(
            json!({
                "bytes_in":   data.len(),
                "unique_ips": ips.len(),
                "ips":        ips,
                "source":     "rustre_trace_pt::pt_to_coverage",
            })
            .to_string(),
        ))
    }
}

/// Convert raw PT buffer to a DRcov v2 coverage file (hex-encoded bytes).
pub struct TracePtDrcovTool;

impl TracePtDrcovTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_pt_drcov".to_string(),
            description:
                "Decode raw Intel PT bytes and emit a DynamoRIO drcov v2 coverage \
                 file. The binary output is hex-encoded in the result."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes":       { "type": "array", "items": { "type": "integer" } },
                    "hex":         { "type": "string" },
                    "module_name": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TracePtDrcovTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = extract_byte_array(&args, "bytes", "hex")?;
        let module = args
            .get("module_name")
            .and_then(Value::as_str)
            .unwrap_or("unknown");
        let trace = rustre_trace_pt::decode_pt_buffer(&data);
        let bytes = rustre_trace_pt::pt_to_drcov_bytes(&trace, module);
        Ok(ToolResult::text(
            json!({
                "bytes_in":     data.len(),
                "drcov_len":    bytes.len(),
                "drcov_hex":    hex_encode(&bytes),
                "module_name":  module,
                "source":       "rustre_trace_pt::pt_to_drcov_bytes",
            })
            .to_string(),
        ))
    }
}

/// Generate a full Python stub (`.pyi`-style) for a `PythonReModule`.
pub struct PluginPythonGenerateStubTool;

impl PluginPythonGenerateStubTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "plugin_python_generate_stub".to_string(),
            description: "Build a PythonReModule with an optional function/class/constant and return its generated Python stub.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "module_name": {"type": "string"},
                    "doc": {"type": "string"},
                    "function_name": {"type": "string"},
                    "class_name": {"type": "string"},
                    "constant_name": {"type": "string"},
                    "constant_repr": {"type": "string"}
                },
                "required": ["module_name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PluginPythonGenerateStubTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let module_name = args.get("module_name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'module_name'".into()))?;
        let mut m = rustre_plugin_python::PythonReModule::new(module_name);
        if let Some(doc) = args.get("doc").and_then(Value::as_str) {
            m = m.with_doc(doc);
        }
        if let Some(fname) = args.get("function_name").and_then(Value::as_str) {
            m.register_function(rustre_plugin_python::PyFunction::new(fname, ""));
        }
        if let Some(cname) = args.get("class_name").and_then(Value::as_str) {
            m.register_class(rustre_plugin_python::PyClass::new(cname, ""));
        }
        if let Some(kname) = args.get("constant_name").and_then(Value::as_str) {
            let repr = args.get("constant_repr").and_then(Value::as_str).unwrap_or("None");
            m.register_constant(kname, repr);
        }
        Ok(ToolResult::text(
            json!({
                "stub": m.generate_stub(),
                "source": "rustre_plugin_python::PythonReModule::generate_stub",
            })
            .to_string(),
        ))
    }
}

/// List methods of a `PyClass` filtered by tag.
pub struct PluginPythonClassMethodsTaggedTool;

impl PluginPythonClassMethodsTaggedTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "plugin_python_class_methods_tagged".to_string(),
            description: "Build a PyClass with tagged methods and return the names of methods matching a given tag.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "class_name": {"type": "string"},
                    "tag": {"type": "string"},
                    "method_name": {"type": "string"},
                    "method_tag": {"type": "string"}
                },
                "required": ["class_name", "tag"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PluginPythonClassMethodsTaggedTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let class_name = args.get("class_name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'class_name'".into()))?;
        let tag = args.get("tag").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'tag'".into()))?;
        let mut cls = rustre_plugin_python::PyClass::new(class_name, "");
        if let Some(mname) = args.get("method_name").and_then(Value::as_str) {
            let mtag = args.get("method_tag").and_then(Value::as_str).unwrap_or(tag);
            let mf = rustre_plugin_python::PyFunction::new(mname, "").tag(mtag);
            cls = cls.method(mf);
        }
        let names: Vec<String> = cls
            .methods_tagged(tag)
            .iter()
            .map(|f| f.name.clone())
            .collect();
        Ok(ToolResult::text(
            json!({
                "matches": names,
                "source": "rustre_plugin_python::PyClass::methods_tagged",
            })
            .to_string(),
        ))
    }
}

/// Format an `ErrorContext` + `PyError` pair for diagnostics.
pub struct PluginPythonFormatErrorTool;

impl PluginPythonFormatErrorTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "plugin_python_format_error".to_string(),
            description: "Build an ErrorContext + PyError (kind = type|value|key|attribute|import|runtime|other) and return their formatted display strings.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "kind": {"type": "string"},
                    "message": {"type": "string"},
                    "class": {"type": "string"},
                    "plugin": {"type": "string"},
                    "script": {"type": "string"},
                    "function": {"type": "string"}
                },
                "required": ["kind", "message"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PluginPythonFormatErrorTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let kind = args.get("kind").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'kind'".into()))?;
        let message = args.get("message").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'message'".into()))?;
        let err = match kind.to_ascii_lowercase().as_str() {
            "type" => rustre_plugin_python::PyError::Type(message.to_string()),
            "value" => rustre_plugin_python::PyError::Value(message.to_string()),
            "key" => rustre_plugin_python::PyError::Key(message.to_string()),
            "attribute" => rustre_plugin_python::PyError::Attribute(message.to_string()),
            "import" => rustre_plugin_python::PyError::Import(message.to_string()),
            "runtime" => rustre_plugin_python::PyError::Runtime(message.to_string()),
            _ => rustre_plugin_python::PyError::Other {
                class: args.get("class").and_then(Value::as_str).unwrap_or("Exception").to_string(),
                message: message.to_string(),
            },
        };
        let mut ctx = rustre_plugin_python::ErrorContext::empty();
        if let Some(p) = args.get("plugin").and_then(Value::as_str) {
            ctx = ctx.with_plugin(p);
        }
        if let Some(s) = args.get("script").and_then(Value::as_str) {
            ctx = ctx.with_script(s);
        }
        if let Some(f) = args.get("function").and_then(Value::as_str) {
            ctx = ctx.with_function(f);
        }
        Ok(ToolResult::text(
            json!({
                "kind": err.kind(),
                "message": err.message(),
                "error_display": err.to_string(),
                "context_display": ctx.to_string(),
                "source": "rustre_plugin_python::{ErrorContext,PyError}",
            })
            .to_string(),
        ))
    }
}

// â”€â”€â”€ rustre-script â€” hex/bytes/xor builtins â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Convert a hex string to raw bytes via `rustre_script::builtin_hex_to_bytes`.
pub struct ScriptHexToBytesTool;

impl ScriptHexToBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_hex_to_bytes".to_string(),
            description:
                "Decode a hex string (with or without `0x` prefix) into raw bytes \
                 using the rustre-script builtin `hex_to_bytes`."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": {
                    "hex": { "type": "string", "description": "Hex-encoded byte string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptHexToBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let sv = rustre_script::builtin_hex_to_bytes(&[
            rustre_script::ScriptValue::String(hex.to_string()),
        ])
        .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let bytes = match sv {
            rustre_script::ScriptValue::Bytes(b) => b,
            other => {
                return Err(McpError::InternalError(format!(
                    "hex_to_bytes returned non-bytes: {}",
                    other.type_name()
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "bytes": bytes,
                "hex":   hex_encode(&bytes),
                "len":   bytes.len(),
                "source": "rustre_script::builtin_hex_to_bytes",
            })
            .to_string(),
        ))
    }
}

/// Encode bytes as a lowercase hex string via `rustre_script::builtin_bytes_to_hex`.
