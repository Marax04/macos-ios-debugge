#[async_trait]
impl ToolHandler for IlLiftRegisterAllLiftersTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let mut reg = rustre_il_lift::LifterRegistry::new();
        rustre_il_lift::register_all_lifters(&mut reg);
        let mut arches: Vec<String> =
            reg.arch_names().into_iter().map(str::to_string).collect();
        arches.sort();
        Ok(ToolResult::text(
            json!({
                "ok": true,
