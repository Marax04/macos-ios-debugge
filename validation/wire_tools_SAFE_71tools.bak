            .ok_or_else(|| McpError::InvalidParams("missing 'rule'".into()))?
            .clone();
        let rule: rustre_triage_die::RuleCondition = serde_json::from_value(rule_val)
            .map_err(|e| McpError::InvalidParams(format!("invalid rule: {e}")))?;
