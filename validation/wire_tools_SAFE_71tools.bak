/// Wrapper for `rustre_dotnet_decompile::stack_effect`.
pub struct DotnetDecompileStackEffectTool;

impl DotnetDecompileStackEffectTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_decompile_stack_effect".to_string(),
            description: "Return CIL opcode stack effect (pops/pushes) or null if unknown."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "opcode": { "type": "string" } },
                "required": ["opcode"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetDecompileStackEffectTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let opcode = args
            .get("opcode")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'opcode'".to_string()))?;
        let effect = rustre_dotnet_decompile::stack_effect(opcode);
        let payload = match effect {
            Some(e) => json!({
                "opcode": opcode,
                "pops": e.pops,
                "pushes": e.pushes,
                "source": "rustre_dotnet_decompile::stack_effect",
            }),
            None => json!({
                "opcode": opcode,
                "pops": Value::Null,
                "pushes": Value::Null,
                "source": "rustre_dotnet_decompile::stack_effect",
            }),
        };
        Ok(ToolResult::text(payload.to_string()))
    }
}

