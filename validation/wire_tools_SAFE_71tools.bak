        let b = args.get("b").and_then(Value::as_u64).unwrap_or(0);
        let e = rustre_symb::SpecSymExpr::Add(
            Box::new(rustre_symb::SpecSymExpr::Const { val: a, width: rustre_symb::SymWidth::W64 }),
