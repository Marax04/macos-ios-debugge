/// Extract a confidence score in `[0.0, 1.0]` from a free-form LLM response
/// via `rustre_agent::AgentResponseParser::parse_confidence`.
pub struct AgentParseConfidenceTool;

impl AgentParseConfidenceTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "agent_parse_confidence".to_string(),
            description: "Extract a confidence score in [0.0, 1.0] from an LLM \
                          response string via rustre_agent::AgentResponseParser::parse_confidence."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "response": { "type": "string" } },
                "required": ["response"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AgentParseConfidenceTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let response = args.get("response").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'response'".into()))?;
        let confidence = rustre_agent::AgentResponseParser::parse_confidence(response);
        Ok(ToolResult::text(json!({
            "confidence": confidence,
            "source": "rustre_agent::AgentResponseParser::parse_confidence",
        }).to_string()))
    }
}

