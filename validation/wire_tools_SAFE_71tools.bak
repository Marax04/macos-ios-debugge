// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ PE editor wire tools Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

fn pe_editor_hex_decode(s: &str) -> Result<Vec<u8>, McpError> {
    let cleaned: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    if !cleaned.len().is_multiple_of(2) {
        return Err(McpError::InvalidParams("hex length must be even".into()));
    }
    (0..cleaned.len())
        .step_by(2)
        .map(|i| {
            u8::from_str_radix(&cleaned[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))
        })
        .collect()
}

fn pe_editor_hex_encode(b: &[u8]) -> String {
    let mut s = String::with_capacity(b.len() * 2);
    for byte in b {
        s.push_str(&format!("{byte:02x}"));
    }
    s
}

pub struct PeXorSectionTool;

impl PeXorSectionTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_editor_xor_section".to_string(),
            description:
                "XOR a byte buffer with a repeating key via rustre_pe_editor::xor_section. \
                 Inputs are hex-encoded strings; returns the XOR'd bytes as hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data_hex": {"type": "string", "description": "Hex-encoded data buffer"},
                    "key_hex":  {"type": "string", "description": "Hex-encoded XOR key (non-empty)"}
                },
                "required": ["data_hex", "key_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeXorSectionTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data_hex = args.get("data_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'data_hex'".into()))?;
        let key_hex = args.get("key_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'key_hex'".into()))?;
        let mut data = pe_editor_hex_decode(data_hex)?;
        let key = pe_editor_hex_decode(key_hex)?;
        if key.is_empty() {
            return Err(McpError::InvalidParams("key must be non-empty".into()));
        }
        rustre_pe_editor::xor_section(&mut data, &key);
        Ok(ToolResult::text(
            json!({
                "len": data.len(),
                "out_hex": pe_editor_hex_encode(&data),
                "source": "rustre_pe_editor::xor_section",
            })
            .to_string(),
        ))
    }
}

pub struct PeCertHeaderBytesTool;

impl PeCertHeaderBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_editor_cert_header_bytes".to_string(),
            description:
                "Serialize a WIN_CERTIFICATE header via \
                 rustre_pe_editor::CertificateHeader::new(payload_len).to_bytes() \
                 and return the 8-byte little-endian header as hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "payload_len": {"type": "integer", "minimum": 0, "description": "PKCS#7 payload length in bytes"}
                },
                "required": ["payload_len"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeCertHeaderBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let payload_len = args.get("payload_len").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'payload_len' u32".into()))?;
        let payload_len = u32::try_from(payload_len)
            .map_err(|_| McpError::InvalidParams("payload_len exceeds u32".into()))?;
        let hdr = rustre_pe_editor::CertificateHeader::new(payload_len);
        let bytes = hdr.to_bytes();
        Ok(ToolResult::text(
            json!({
                "dw_length": hdr.dw_length,
                "w_revision": hdr.w_revision,
                "w_certificate_type": hdr.w_certificate_type,
                "bytes_hex": pe_editor_hex_encode(&bytes),
                "source": "rustre_pe_editor::CertificateHeader::new().to_bytes()",
            })
            .to_string(),
        ))
    }
}

pub struct PeRc4ProcessTool;

impl PeRc4ProcessTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_editor_rc4_process".to_string(),
            description:
                "RC4 encrypt/decrypt a hex buffer with a hex key via rustre_pe_editor::Rc4::new(key).process(data)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data_hex": {"type": "string"},
                    "key_hex":  {"type": "string"}
                },
                "required": ["data_hex", "key_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeRc4ProcessTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data_hex = args.get("data_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'data_hex'".into()))?;
        let key_hex = args.get("key_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'key_hex'".into()))?;
        let mut data = pe_editor_hex_decode(data_hex)?;
        let key = pe_editor_hex_decode(key_hex)?;
        if key.is_empty() {
            return Err(McpError::InvalidParams("key must be non-empty".into()));
