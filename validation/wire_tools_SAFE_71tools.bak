// ── rustre-mem kx7 wrappers (32 new) ───────────────────────────────────────
fn __mem_kx7_addr(v: u64) -> rustre_core::address::Address { rustre_core::address::Address::new(v) }
fn __mem_kx7_check_page(page: u64) -> Result<(), McpError> {
    if page == 0 || !page.is_power_of_two() { return Err(McpError::InternalError("page_size must be a nonzero power of two".into())); }
    Ok(())
}

pub struct MemKx7ShannonEntropyHexTool;
impl MemKx7ShannonEntropyHexTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_shannon_entropy_hex".to_string(), description: "rustre_mem::shannon_entropy on hex-decoded bytes.".to_string(), input_schema: json!({"type":"object","required":["hex"],"properties":{"hex":{"type":"string"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7ShannonEntropyHexTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let hex = args.get("hex").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?; let d = __mem_hex_decode_v2(hex); Ok(ToolResult::text(json!({"entropy":rustre_mem::shannon_entropy(&d),"source":"rustre_mem::shannon_entropy"}).to_string())) } }

