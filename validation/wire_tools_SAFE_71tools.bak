pub struct MemKx7EntropyWindowsMaxTool;
impl MemKx7EntropyWindowsMaxTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_entropy_windows_max".to_string(), description: "Maximum shannon_entropy over non-overlapping windows.".to_string(), input_schema: json!({"type":"object","required":["hex","window"],"properties":{"hex":{"type":"string"},"window":{"type":"integer","minimum":1}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7EntropyWindowsMaxTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let d = __mem_hex_decode_v2(args.get("hex").and_then(Value::as_str).unwrap_or("")); let w = args.get("window").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'window'".into()))? as usize; if w == 0 { return Err(McpError::InternalError("'window' must be > 0".into())); } let mut max_e: f64 = 0.0; let mut count = 0usize; let mut i = 0; while i < d.len() { let end = (i + w).min(d.len()); let e = rustre_mem::shannon_entropy(&d[i..end]); if e > max_e { max_e = e; } count += 1; i = end; } Ok(ToolResult::text(json!({"max_entropy":max_e,"windows":count,"source":"rustre_mem::shannon_entropy"}).to_string())) } }

pub struct MemKx7EntropyWindowsAvgTool;
impl MemKx7EntropyWindowsAvgTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_entropy_windows_avg".to_string(), description: "Average shannon_entropy across non-overlapping windows.".to_string(), input_schema: json!({"type":"object","required":["hex","window"],"properties":{"hex":{"type":"string"},"window":{"type":"integer","minimum":1}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7EntropyWindowsAvgTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let d = __mem_hex_decode_v2(args.get("hex").and_then(Value::as_str).unwrap_or("")); let w = args.get("window").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'window'".into()))? as usize; if w == 0 { return Err(McpError::InternalError("'window' must be > 0".into())); } let mut sum = 0.0f64; let mut count = 0usize; let mut i = 0; while i < d.len() { let end = (i + w).min(d.len()); sum += rustre_mem::shannon_entropy(&d[i..end]); count += 1; i = end; } let avg = if count > 0 { sum / count as f64 } else { 0.0 }; Ok(ToolResult::text(json!({"avg_entropy":avg,"windows":count,"source":"rustre_mem::shannon_entropy"}).to_string())) } }

pub struct MemKx7EntropyWindowsAboveTool;
impl MemKx7EntropyWindowsAboveTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_entropy_windows_above".to_string(), description: "Number of windows whose shannon_entropy is >= threshold.".to_string(), input_schema: json!({"type":"object","required":["hex","window","threshold"],"properties":{"hex":{"type":"string"},"window":{"type":"integer","minimum":1},"threshold":{"type":"number"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7EntropyWindowsAboveTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let d = __mem_hex_decode_v2(args.get("hex").and_then(Value::as_str).unwrap_or("")); let w = args.get("window").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'window'".into()))? as usize; let th = args.get("threshold").and_then(Value::as_f64).unwrap_or(7.0); if w == 0 { return Err(McpError::InternalError("'window' must be > 0".into())); } let mut hits = 0usize; let mut count = 0usize; let mut i = 0; while i < d.len() { let end = (i + w).min(d.len()); if rustre_mem::shannon_entropy(&d[i..end]) >= th { hits += 1; } count += 1; i = end; } Ok(ToolResult::text(json!({"hits":hits,"windows":count,"threshold":th,"source":"rustre_mem::shannon_entropy"}).to_string())) } }

pub struct MemKx7EntropySliceTool;
impl MemKx7EntropySliceTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_entropy_slice".to_string(), description: "shannon_entropy over hex[offset..offset+len].".to_string(), input_schema: json!({"type":"object","required":["hex","offset","len"],"properties":{"hex":{"type":"string"},"offset":{"type":"integer"},"len":{"type":"integer"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7EntropySliceTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let d = __mem_hex_decode_v2(args.get("hex").and_then(Value::as_str).unwrap_or("")); let off = args.get("offset").and_then(Value::as_u64).unwrap_or(0) as usize; let len = args.get("len").and_then(Value::as_u64).unwrap_or(0) as usize; if off > d.len() { return Err(McpError::InternalError("offset out of bounds".into())); } let end = (off + len).min(d.len()); let e = rustre_mem::shannon_entropy(&d[off..end]); Ok(ToolResult::text(json!({"entropy":e,"actual_len":end-off,"source":"rustre_mem::shannon_entropy"}).to_string())) } }

