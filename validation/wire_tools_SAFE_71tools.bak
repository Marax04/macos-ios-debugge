/// Parse a PDB Info stream (stream 1) from raw bytes and return GUID/age.
pub struct SymbolsPdbParseInfoTool;

impl SymbolsPdbParseInfoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_pdb_parse_info".to_string(),
            description:
                "Parse the PDB Info stream from raw PDB bytes and return \
                 version/signature/age/GUID (via PdbStreamReader::parse_pdb_info)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsPdbParseInfoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let info = rustre_symbols_pdb::PdbStreamReader::parse_pdb_info(&data);
        Ok(ToolResult::text(
            json!({
                "found": info.is_some(),
                "info": info.as_ref().map(|i| json!({
                    "version": i.version,
                    "signature": i.signature,
                    "age": i.age,
                    "guid_hex": hex_encode(&i.guid),
                })),
                "bytes": data.len(),
                "source": "rustre_symbols_pdb::PdbStreamReader::parse_pdb_info",
            })
            .to_string(),
        ))
    }
}

/// Open a PDB from raw bytes and return a symbol-count summary.
pub struct SymbolsPdbFromBytesTool;

impl SymbolsPdbFromBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_pdb_from_bytes".to_string(),
            description:
                "Parse a full PDB from bytes (PdbReader::from_bytes) and return \
                 GUID/age plus symbol/type/module counts."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsPdbFromBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        match rustre_symbols_pdb::PdbReader::from_bytes(&data) {
            Ok(r) => Ok(ToolResult::text(
                json!({
                    "ok": true,
                    "guid": r.guid().to_string_fmt(),
                    "age": r.age().0,
                    "symbols": r.symbols().len(),
                    "types": r.types().len(),
                    "modules": r.modules().len(),
                    "source": "rustre_symbols_pdb::PdbReader::from_bytes",
                })
                .to_string(),
            )),
            Err(e) => Ok(ToolResult::text(
                json!({
                    "ok": false,
                    "error": e.to_string(),
                    "source": "rustre_symbols_pdb::PdbReader::from_bytes",
                })
                .to_string(),
            )),
        }
    }
}

