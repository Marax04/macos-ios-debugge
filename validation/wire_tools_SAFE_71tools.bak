fn __du_parse_granularity(s: &str) -> Result<rustre_debug_unicorn::CoverageGranularity, McpError> { use rustre_debug_unicorn::CoverageGranularity as G; match s { "instruction" => Ok(G::Instruction), "cache_line" => Ok(G::CacheLine), "page" => Ok(G::Page), _ => Err(McpError::InvalidParams("granularity must be instruction|cache_line|page".into())) } }
fn __du_parse_faultkind(s: &str) -> Result<rustre_debug_unicorn::FaultKind, McpError> { use rustre_debug_unicorn::FaultKind as K; match s { "mem_read_replace" => Ok(K::MemReadReplace), "mem_read_fault" => Ok(K::MemReadFault), "mem_write_fault" => Ok(K::MemWriteFault), "bit_flip" => Ok(K::BitFlip), "register_corrupt" => Ok(K::RegisterCorrupt), "force_branch" => Ok(K::ForceBranch), _ => Err(McpError::InvalidParams("unknown fault_kind".into())) } }
fn __du_parse_watchkind_v2(s: &str) -> Result<rustre_debug_unicorn::WatchKind, McpError> { use rustre_debug_unicorn::WatchKind as K; match s { "read" => Ok(K::Read), "write" => Ok(K::Write), "read_write" | "rw" => Ok(K::ReadWrite), _ => Err(McpError::InvalidParams("watch_kind must be read|write|read_write".into())) } }

