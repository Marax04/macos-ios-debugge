/// Brute-force all 25 Caesar rotations on ASCII text and return sorted results.
pub struct DeobfStringCaesarBruteforceTool;

impl DeobfStringCaesarBruteforceTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "deobf_string_caesar_bruteforce".to_string(),
            description:
                "Brute-force all 25 Caesar rotations of the input string, scored by \
                 English frequency (rustre_deobf_string::caesar_brute_force)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "text": { "type": "string" } },
                "required": ["text"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DeobfStringCaesarBruteforceTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let text = args.get("text").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'text'".into()))?;
        let results = rustre_deobf_string::caesar_brute_force(text);
        let json_results: Vec<Value> = results.iter().map(|r| json!({
            "rotation": r.rotation,
            "decrypted": r.decrypted,
            "score": r.score,
            "confidence": r.confidence,
        })).collect();
        Ok(ToolResult::text(json!({
            "candidates": json_results,
            "source": "rustre_deobf_string::caesar_brute_force",
        }).to_string()))
    }
}

