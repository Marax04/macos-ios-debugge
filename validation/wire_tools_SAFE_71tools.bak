            description: "EMA via rustre_deobf_iadl::convergence_detector::exponential_moving_average.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["history", "alpha"],
                "properties": {
                    "history": { "type": "array", "items": { "type": "number" } },
                    "alpha": { "type": "number" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for IadlConvergenceEmaTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let history: Vec<f64> = args.get("history").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'history'".into()))?
            .iter().filter_map(Value::as_f64).collect();
        let alpha = args.get("alpha").and_then(Value::as_f64)
            .ok_or_else(|| McpError::InvalidParams("missing 'alpha'".into()))?;
        let out = rustre_deobf_iadl::convergence_detector::exponential_moving_average(&history, alpha);
        Ok(ToolResult::text(json!({ "ema": out }).to_string()))
    }
}

