/// Strip TPIU 16-byte framing to recover the trace stream for a target ID.
pub struct TraceCoresightTpiuDemuxTool;

impl TraceCoresightTpiuDemuxTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_coresight_tpiu_demux".to_string(),
            description:
                "Strip TPIU 16-byte framing from a raw CoreSight capture and \
                 return bytes for `target_id`, via \
                 rustre_trace_coresight::coresight_packets::tpiu_demux."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes":     { "type": "array", "items": { "type": "integer" } },
                    "hex":       { "type": "string" },
                    "target_id": { "type": "integer", "minimum": 0, "maximum": 255 }
                },
                "required": ["target_id"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceCoresightTpiuDemuxTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let tid_u64 = args
            .get("target_id")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("target_id missing".to_string()))?;
        let target_id = u8::try_from(tid_u64)
            .map_err(|_| McpError::InvalidParams("target_id out of u8 range".to_string()))?;
        let out = rustre_trace_coresight::coresight_packets::tpiu_demux(&data, target_id);
        Ok(ToolResult::text(
            json!({
                "target_id":   target_id,
                "byte_count":  out.len(),
                "bytes_hex":   hex_encode(&out),
                "source":      "rustre_trace_coresight::coresight_packets::tpiu_demux",
            })
            .to_string(),
        ))
    }
}

/// Decode a raw CoreSight STM stream and return all decoded packets.
pub struct TraceCoresightStmDecodeStreamTool;

impl TraceCoresightStmDecodeStreamTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_coresight_stm_decode_stream".to_string(),
            description:
                "Decode an entire CoreSight STM byte stream via \
                 rustre_trace_coresight::coresight_stm_decoder::decode_stm_stream."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceCoresightStmDecodeStreamTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let pkts = rustre_trace_coresight::coresight_stm_decoder::decode_stm_stream(&data);
        let pkts_json = serde_json::to_value(&pkts)
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "packet_count": pkts.len(),
                "packets":      pkts_json,
                "source":       "rustre_trace_coresight::coresight_stm_decoder::decode_stm_stream",
            })
            .to_string(),
        ))
    }
}

// â”€â”€â”€ extra rustre-ttd-replayer wire tools â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

pub struct TtdReplayerParseHexTool;

impl TtdReplayerParseHexTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replayer_parse_hex".to_string(),
            description: "Parse a hex string (with or without 0x prefix) into u64 via rustre_ttd_replayer::parse_hex."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "s": {"type": "string", "description": "Hex string, optional 0x prefix"}
                },
                "required": ["s"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplayerParseHexTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args.get("s").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 's'".into()))?;
        let parsed = rustre_ttd_replayer::parse_hex(s);
        Ok(ToolResult::text(
            json!({
                "input": s,
                "value": parsed,
                "ok": parsed.is_some(),
                "source": "rustre_ttd_replayer::parse_hex",
            })
            .to_string(),
        ))
    }
}

pub struct TtdReplayerBuildSyscallSummariesTool;

impl TtdReplayerBuildSyscallSummariesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replayer_build_syscall_summaries".to_string(),
            description: "Build per-syscall aggregate summaries over a synthetic trace of n events via rustre_ttd_replayer::build_syscall_summaries."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "n": {"type": "integer", "description": "Number of synthetic syscall entry/exit pairs (default 8)"}
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplayerBuildSyscallSummariesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_ttd_replayer::{TraceBuilder, MemWriteRecord, DEFAULT_SNAPSHOT_INTERVAL, build_syscall_summaries};
        let n = args.get("n").and_then(Value::as_u64).unwrap_or(8);
        let mut b = TraceBuilder::new(DEFAULT_SNAPSHOT_INTERVAL);
        for i in 0..n {
            b.syscall_entry(i, [0; 6]);
            b.syscall_exit(0, vec![MemWriteRecord::new(0x1000 + i * 8, vec![0u8; 8])]);
        }
        let trace = b.build();
        let map = build_syscall_summaries(&trace);
        Ok(ToolResult::text(
            json!({
                "syscall_count": map.len(),
                "total_bytes_written": map.values().map(|s| s.total_bytes_written).sum::<usize>(),
                "source": "rustre_ttd_replayer::build_syscall_summaries",
            })
            .to_string(),
        ))
    }
}

pub struct TtdReplayerScanForWritesTool;

impl TtdReplayerScanForWritesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replayer_scan_for_writes".to_string(),
            description: "Scan a synthetic trace for writes overlapping [addr, addr+size) via rustre_ttd_replayer::scan_for_writes."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "addr": {"type": "integer", "description": "Base address to watch"},
                    "size": {"type": "integer", "description": "Watch range size in bytes"},
                    "n": {"type": "integer", "description": "Number of synthetic events (default 8)"}
                },
                "required": ["addr", "size"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplayerScanForWritesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_ttd_replayer::{TraceBuilder, MemWriteRecord, DEFAULT_SNAPSHOT_INTERVAL, scan_for_writes};
        let addr = args.get("addr").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".into()))?;
        let size = args.get("size").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'size'".into()))? as usize;
        let n = args.get("n").and_then(Value::as_u64).unwrap_or(8);
        let mut b = TraceBuilder::new(DEFAULT_SNAPSHOT_INTERVAL);
        for i in 0..n {
            b.syscall_entry(1, [0; 6]);
            b.syscall_exit(0, vec![MemWriteRecord::new(addr + i * 4, vec![0xAAu8; 4])]);
        }
        let trace = b.build();
        let hits = scan_for_writes(&trace, addr, size);
        Ok(ToolResult::text(
            json!({
                "hit_count": hits.len(),
                "first_tick": hits.first().map(|h| h.tick),
                "last_tick": hits.last().map(|h| h.tick),
                "source": "rustre_ttd_replayer::scan_for_writes",
            })
            .to_string(),
        ))
    }
}

/// Scan a byte buffer for the AES S-box signature (forward and inverse).
pub struct CryptoIdScanAesSboxTool;

impl CryptoIdScanAesSboxTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "crypto_id_scan_aes_sbox".to_string(),
            description:
                "Scan raw bytes for the AES forward and inverse S-box tables via \
                 rustre_crypto_id::scan_for_aes_sbox."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for CryptoIdScanAesSboxTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let hits = rustre_crypto_id::scan_for_aes_sbox(&data);
        let arr: Vec<Value> = hits
            .iter()
            .map(|h| {
                json!({
                    "algorithm": h.algorithm,
                    "constant_name": h.constant_name,
                    "offset": h.offset,
                    "confidence": h.confidence,
                    "match_length": h.match_length,
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "count": arr.len(),
                "hits": arr,
                "bytes_scanned": data.len(),
            })
            .to_string(),
        ))
    }
}

