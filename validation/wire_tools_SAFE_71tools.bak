        let s = args
            .get("code_hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'code_hex' string".into()))?;
        let bytes = wire_hex_decode_cil(s)?;
        match rustre_arch_cil::cil_max_local_slot(&bytes) {
