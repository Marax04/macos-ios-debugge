#[async_trait]
impl ToolHandler for SymbZ3ParseModelTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args
            .get("output")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".to_string()))?;
        let model = rustre_symb_z3::SmtLib2Parser::parse_model(output);
        let obj: serde_json::Map<String, Value> = model
