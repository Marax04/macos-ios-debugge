// â”€â”€â”€ patch_pe_security_set â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Expose `pe_security_set_from_path` as an MCP tool.
pub struct PatchPeSecuritySetTool;

impl PatchPeSecuritySetTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_pe_security_set".to_string(),
            description:
                "Toggle PE DllCharacteristics security bits (ASLR, DEP, CFG, \
                 force_integrity) and recompute the PE optional-header checksum."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path":            { "type": "string",  "description": "Absolute path to the PE binary" },
                    "aslr":            { "type": "boolean" },
                    "dep":             { "type": "boolean" },
                    "cfg":             { "type": "boolean" },
                    "force_integrity": { "type": "boolean" },
                    "dry_run":         { "type": "boolean", "description": "Do not write to disk (default true)" },
                    "backup":          { "type": "boolean", "description": "Create .bak file (default false)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchPeSecuritySetTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let toggles = rustre_patch::PeFlagToggle {
            aslr:            args.get("aslr").and_then(Value::as_bool),
            dep:             args.get("dep").and_then(Value::as_bool),
            cfg:             args.get("cfg").and_then(Value::as_bool),
            force_integrity: args.get("force_integrity").and_then(Value::as_bool),
        };
        let dry_run = args.get("dry_run").and_then(Value::as_bool).unwrap_or(true);
        let backup  = args.get("backup").and_then(Value::as_bool).unwrap_or(false);
        let outcome = rustre_patch::pe_security_set_from_path(path, toggles, dry_run, backup)
            .map_err(|e| McpError::InternalError(format!("pe_security_set: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path":                    path,
                "old_dll_characteristics": outcome.old_dll_characteristics,
                "new_dll_characteristics": outcome.new_dll_characteristics,
                "old_checksum":            outcome.old_checksum,
                "new_checksum":            outcome.new_checksum,
                "dry_run":                 outcome.dry_run,
                "backup_path":             outcome.backup_path,
                "source":                  "rustre_patch::pe_security_set_from_path",
            })
            .to_string(),
        ))
    }
}

// â”€â”€â”€ patch_binary_diff â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Expose `rustre_patch::diff` as an MCP tool.
pub struct PatchBinaryDiffTool;

impl PatchBinaryDiffTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_binary_diff".to_string(),
            description:
                "Compute a binary delta between old and new byte buffers \
                 (hex-encoded) and return the encoded delta blob as hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["old_hex", "new_hex"],
                "properties": {
                    "old_hex": { "type": "string", "description": "Hex-encoded old buffer" },
                    "new_hex": { "type": "string", "description": "Hex-encoded new buffer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchBinaryDiffTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let old_hex = args.get("old_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'old_hex'".into()))?;
        let new_hex = args.get("new_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'new_hex'".into()))?;
        let old = rustre_patch::parse_hex_bytes(old_hex)
            .map_err(|e| McpError::InvalidParams(format!("old_hex: {e}")))?;
        let new = rustre_patch::parse_hex_bytes(new_hex)
            .map_err(|e| McpError::InvalidParams(format!("new_hex: {e}")))?;
        let delta = rustre_patch::diff(&old, &new);
        Ok(ToolResult::text(
            json!({
                "old_len":   old.len(),
                "new_len":   new.len(),
                "delta_len": delta.len(),
                "delta_hex": hex_encode(&delta),
                "source":    "rustre_patch::diff",
            })
            .to_string(),
        ))
    }
}

// â”€â”€â”€ patch_binary_patch â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Expose `rustre_patch::patch` as an MCP tool.
pub struct PatchBinaryPatchTool;

impl PatchBinaryPatchTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_binary_patch".to_string(),
            description:
                "Decode a binary delta blob and apply it to an old buffer, \
                 returning the reconstructed buffer as hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["old_hex", "delta_hex"],
                "properties": {
                    "old_hex":   { "type": "string", "description": "Hex-encoded old buffer" },
                    "delta_hex": { "type": "string", "description": "Hex-encoded delta blob" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchBinaryPatchTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let old_hex = args.get("old_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'old_hex'".into()))?;
        let delta_hex = args.get("delta_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'delta_hex'".into()))?;
        let old = rustre_patch::parse_hex_bytes(old_hex)
            .map_err(|e| McpError::InvalidParams(format!("old_hex: {e}")))?;
        let delta = rustre_patch::parse_hex_bytes(delta_hex)
            .map_err(|e| McpError::InvalidParams(format!("delta_hex: {e}")))?;
        let new = rustre_patch::patch(&old, &delta)
            .map_err(|e| McpError::InternalError(format!("patch: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "old_len": old.len(),
                "new_len": new.len(),
                "new_hex": hex_encode(&new),
                "source":  "rustre_patch::patch",
            })
            .to_string(),
        ))
    }
}

// â”€â”€â”€ patch_bytes_at_va â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Expose `rustre_patch::patch_bytes_at_va` as an MCP tool.
pub struct PatchBytesAtVaTool;

impl PatchBytesAtVaTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_bytes_at_va".to_string(),
            description:
                "Write raw hex bytes at a virtual address in a PE file on disk, \
                 resolving the VA to a file offset via the PE section map."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path", "va", "bytes_hex"],
                "properties": {
                    "path":      { "type": "string",  "description": "Absolute path to the PE binary" },
                    "va":        { "type": "integer", "description": "Virtual address to patch" },
                    "bytes_hex": { "type": "string",  "description": "Hex-encoded replacement bytes" },
                    "dry_run":   { "type": "boolean", "description": "Do not write to disk (default true)" },
                    "backup":    { "type": "boolean", "description": "Create .bak file (default false)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchBytesAtVaTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let va = args.get("va").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'va'".into()))?;
        let bytes_hex = args.get("bytes_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'bytes_hex'".into()))?;
        let bytes = rustre_patch::parse_hex_bytes(bytes_hex)
            .map_err(|e| McpError::InvalidParams(format!("bytes_hex: {e}")))?;
        let dry_run = args.get("dry_run").and_then(Value::as_bool).unwrap_or(true);
        let backup  = args.get("backup").and_then(Value::as_bool).unwrap_or(false);
        let outcome = rustre_patch::patch_bytes_at_va(path, va, &bytes, dry_run, backup)
            .map_err(|e| McpError::InternalError(format!("patch_bytes_at_va: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path":          path,
                "va":            va,
                "file_offset":   outcome.file_offset,
                "bytes_written": outcome.bytes_written,
                "section":       outcome.section,
                "dry_run":       outcome.dry_run,
                "backup_path":   outcome.backup_path,
                "source":        "rustre_patch::patch_bytes_at_va",
            })
            .to_string(),
        ))
    }
}

