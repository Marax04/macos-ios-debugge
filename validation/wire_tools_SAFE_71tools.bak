/// Wrapper for `rustre_symbols::try_demangle`.
pub struct SymbolsTryDemangleTool;

impl SymbolsTryDemangleTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_try_demangle".to_string(),
            description: "Attempt to demangle a symbol name via rustre_symbols::try_demangle."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsTryDemangleTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("name: required".to_string()))?;
        let demangled = rustre_symbols::try_demangle(name);
        let changed = demangled.as_deref().is_some_and(|d| d != name);
        Ok(ToolResult::text(
            json!({
                "input": name,
                "demangled": demangled,
                "changed": changed,
                "source": "rustre_symbols::try_demangle",
            })
            .to_string(),
        ))
    }
}

/// Wrapper that builds a `rustre_symbols::Symbol` and tests `contains(addr)`.
pub struct SymbolsSymbolContainsTool;

impl SymbolsSymbolContainsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_symbol_contains".to_string(),
            description: "Build a rustre_symbols::Symbol at (address,size) and test whether target is inside it via Symbol::contains."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "address": { "type": "integer" },
                    "size": { "type": "integer" },
                    "target": { "type": "integer" }
                },
                "required": ["address", "target"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsSymbolContainsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let address = args
            .get("address")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("address: required u64".to_string()))?;
        let target = args
            .get("target")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("target: required u64".to_string()))?;
        let size = args.get("size").and_then(Value::as_u64);
        let mut sym = rustre_symbols::Symbol::new(
            "wire_probe".to_string(),
            address,
            rustre_symbols::SymKind::Function,
        );
        sym.size = size;
        let contains = sym.contains(target);
        let end = sym.end_address();
        Ok(ToolResult::text(
            json!({
                "address": address,
                "size": size,
                "target": target,
                "contains": contains,
                "end_address": end,
                "source": "rustre_symbols::Symbol::contains",
            })
            .to_string(),
        ))
    }
}

/// List every symbol harvested from the PDB global stream via
/// `rustre_symbols_pdb::PdbReader::symbols` (returns `Vec<PdbSymbol>`).
pub struct SymbolsPdbSymbolsListTool;

impl SymbolsPdbSymbolsListTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_pdb_symbols_list".to_string(),
            description:
                "Parse a PDB from bytes and return every PdbSymbol (name, address, \
                 size, kind) as reported by PdbReader::symbols()."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsPdbSymbolsListTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        match rustre_symbols_pdb::PdbReader::from_bytes(&data) {
            Ok(r) => {
                let syms = r.symbols();
                Ok(ToolResult::text(
                    json!({
                        "ok": true,
                        "count": syms.len(),
                        "symbols": syms,
                        "source": "rustre_symbols_pdb::PdbReader::symbols",
                    })
                    .to_string(),
                ))
            }
            Err(e) => Ok(ToolResult::text(
                json!({
                    "ok": false,
                    "error": e.to_string(),
                    "source": "rustre_symbols_pdb::PdbReader::symbols",
                })
                .to_string(),
            )),
        }
    }
}

/// Bucket PDB symbols by `SymbolKind` (Function / Data / Label / Thunk).
pub struct SymbolsPdbSymbolsCountByKindTool;

impl SymbolsPdbSymbolsCountByKindTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_pdb_symbols_count_by_kind".to_string(),
            description:
                "Parse a PDB from bytes and return counts of PdbSymbol grouped by \
                 SymbolKind (function/data/label/thunk)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsPdbSymbolsCountByKindTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        match rustre_symbols_pdb::PdbReader::from_bytes(&data) {
            Ok(r) => {
                use rustre_symbols_pdb::SymbolKind;
                let mut func = 0u64;
                let mut data_c = 0u64;
                let mut label = 0u64;
                let mut thunk = 0u64;
                for s in r.symbols() {
                    match s.kind {
                        SymbolKind::Function => func += 1,
                        SymbolKind::Data => data_c += 1,
                        SymbolKind::Label => label += 1,
                        SymbolKind::Thunk => thunk += 1,
                    }
                }
                Ok(ToolResult::text(
                    json!({
                        "ok": true,
                        "function": func,
                        "data": data_c,
                        "label": label,
                        "thunk": thunk,
                        "source": "rustre_symbols_pdb::SymbolKind",
                    })
                    .to_string(),
                ))
            }
            Err(e) => Ok(ToolResult::text(
                json!({
                    "ok": false,
                    "error": e.to_string(),
                    "source": "rustre_symbols_pdb::SymbolKind",
                })
                .to_string(),
            )),
        }
    }
}

