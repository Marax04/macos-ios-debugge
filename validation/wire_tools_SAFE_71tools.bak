impl TiMispThreatLevelFromValueTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_threat_level_from_value".to_string(),
            description:
                "Parse a numeric MISP threat level id (1=High,2=Medium,3=Low,4=Undefined) \
                 into MispThreatLevelId."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "value": {"type": "integer"} },
                "required": ["value"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispThreatLevelFromValueTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let v = args
            .get("value")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let v8 = u8::try_from(v)
            .map_err(|_| McpError::InvalidParams("value out of u8 range".to_string()))?;
        let parsed = rustre_ti_misp::MispThreatLevelId::from_value(v8);
        Ok(ToolResult::text(
            json!({
                "value": v8,
                "recognised": parsed.is_some(),
                "threat_level": parsed.as_ref().map(|l| l.to_string()),
                "source": "rustre_ti_misp::MispThreatLevelId::from_value",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ti-misp Ã¢â‚¬â€ MispWarningList::matches Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct TiMispWarningListMatchesTool;

impl TiMispWarningListMatchesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_warning_list_matches".to_string(),
            description:
                "Check whether a value matches any entry in a supplied MISP warning list."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "name": {"type": "string"},
                    "entries": {"type": "array", "items": {"type": "string"}},
                    "value": {"type": "string"}
                },
                "required": ["entries", "value"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispWarningListMatchesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .unwrap_or("adhoc")
            .to_string();
        let value = args
            .get("value")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let entries: Vec<String> = args
            .get("entries")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'entries'".to_string()))?
            .iter()
            .filter_map(|e| e.as_str().map(str::to_string))
            .collect();
        let mut wl = rustre_ti_misp::MispWarningList::new(0, name);
        wl.entries = entries;
        let matched = wl.matches(value);
        Ok(ToolResult::text(
            json!({
                "value": value,
                "matched": matched,
                "entry_count": wl.entries.len(),
                "source": "rustre_ti_misp::MispWarningList::matches",
            })
            .to_string(),
        ))
    }
}

