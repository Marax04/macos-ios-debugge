/// Expose `rustre_analysis_vsa::resolve_jump_table` as an MCP tool.
pub struct AnalysisVsaResolveJumpTableTool;

impl AnalysisVsaResolveJumpTableTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_vsa_resolve_jump_table".to_string(),
            description: "Resolve an indirect-jump table via VSA.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["table_base", "entry_size", "code_base", "code_limit"],
                "properties": {
                    "table_base": { "type": "integer" },
                    "entry_size": { "type": "integer" },
                    "code_base": { "type": "integer" },
                    "code_limit": { "type": "integer" },
                    "entries": { "type": "array", "items": { "type": "integer" } }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisVsaResolveJumpTableTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let table_base = args.get("table_base").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'table_base'".into()))?;
        let entry_size = u8::try_from(args.get("entry_size").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'entry_size'".into()))?)
            .map_err(|_| McpError::InvalidParams("entry_size out of range".into()))?;
        let code_base = args.get("code_base").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'code_base'".into()))?;
        let code_limit = args.get("code_limit").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'code_limit'".into()))?;
        let entries: Vec<u64> = args.get("entries").and_then(Value::as_array)
            .map(|a| a.iter().filter_map(Value::as_u64).collect()).unwrap_or_default();
        let mut map = std::collections::HashMap::new();
        for (k, target) in entries.iter().enumerate() {
            let addr = table_base + (k as u64) * u64::from(entry_size);
            let bytes = target.to_le_bytes();
            let n = usize::from(entry_size).min(8);
            for i in 0..n { map.insert(addr + i as u64, bytes[i]); }
        }
        let mem = rustre_analysis_vsa::MapBinaryMemory(map);
        let vsa = rustre_analysis_vsa::VsaEngineResult {
            states_before: std::collections::HashMap::new(),
            states_after: std::collections::HashMap::new(),
            converged: true,
            iterations: 0,
        };
        let info = rustre_analysis_vsa::resolve_jump_table(
            &vsa, 0, "idx", table_base, entry_size, (code_base, code_limit), &mem,
        );
        Ok(ToolResult::text(json!({
            "table_base": info.table_base,
            "entry_size": info.entry_size,
            "targets": info.targets,
            "complete": info.complete
        }).to_string()))
    }
}

/// Expose `rustre_analysis_vsa::resolve_indirect_calls` as an MCP tool.
pub struct AnalysisVsaResolveIndirectCallsTool;

impl AnalysisVsaResolveIndirectCallsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_vsa_resolve_indirect_calls".to_string(),
            description: "Resolve indirect call targets from VSA results.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["code_base", "code_limit"],
                "properties": {
                    "code_base": { "type": "integer" },
                    "code_limit": { "type": "integer" },
                    "max_targets": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisVsaResolveIndirectCallsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let code_base = args.get("code_base").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'code_base'".into()))?;
        let code_limit = args.get("code_limit").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'code_limit'".into()))?;
        let max_targets = args.get("max_targets").and_then(Value::as_u64).unwrap_or(64) as usize;
        let cfg = rustre_analysis_vsa::LlilCfg::new(vec![], vec![], 0, None);
        let vsa = rustre_analysis_vsa::VsaEngineResult {
            states_before: std::collections::HashMap::new(),
            states_after: std::collections::HashMap::new(),
            converged: true,
            iterations: 0,
        };
        let result = rustre_analysis_vsa::resolve_indirect_calls(
            &vsa, &cfg, (code_base, code_limit), max_targets,
        );
        let entries: Vec<Value> = result.into_iter()
            .map(|((bb, reg), targets)| json!({ "bb": bb, "reg": reg, "targets": targets }))
            .collect();
        Ok(ToolResult::text(json!({ "resolutions": entries }).to_string()))
    }
}

/// Expose `rustre_analysis_vsa::detect_buffer_overflows` as an MCP tool.
pub struct AnalysisVsaDetectBufferOverflowsTool;

impl AnalysisVsaDetectBufferOverflowsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_vsa_detect_buffer_overflows".to_string(),
            description: "Detect potential buffer overflows via VSA.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["ptr_reg", "access_size", "base", "limit"],
                "properties": {
                    "ptr_reg": { "type": "string" },
                    "access_size": { "type": "integer" },
                    "base": { "type": "integer" },
                    "limit": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisVsaDetectBufferOverflowsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let ptr_reg = args.get("ptr_reg").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'ptr_reg'".into()))?.to_string();
        let access_size = u8::try_from(args.get("access_size").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'access_size'".into()))?)
            .map_err(|_| McpError::InvalidParams("access_size out of range".into()))?;
        let base = args.get("base").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'base'".into()))?;
        let limit = args.get("limit").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'limit'".into()))?;
        let cfg = rustre_analysis_vsa::LlilCfg::new(vec![], vec![], 0, None);
        let vsa = rustre_analysis_vsa::VsaEngineResult {
            states_before: std::collections::HashMap::new(),
            states_after: std::collections::HashMap::new(),
            converged: true,
            iterations: 0,
        };
        let warnings = rustre_analysis_vsa::detect_buffer_overflows(
            &vsa, &cfg, &ptr_reg, access_size, (base, limit),
        );
        let entries: Vec<Value> = warnings.into_iter()
            .map(|(bb, msg)| json!({ "bb": bb, "message": msg }))
            .collect();
        Ok(ToolResult::text(json!({ "warnings": entries }).to_string()))
    }
}

