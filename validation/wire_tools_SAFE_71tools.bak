/// Auto-detect the mangling ABI and demangle a symbol (delegates to
/// `rustre_demangle::demangle`).
pub struct DemangleAutoTool;

impl DemangleAutoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "demangle_auto".to_string(),
            description:
                "Auto-detect the mangling ABI (Itanium/MSVC/Rust/Swift) and demangle a symbol \
                 (delegates to rustre_demangle::demangle)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "mangled": { "type": "string" } },
                "required": ["mangled"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DemangleAutoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mangled = args
            .get("mangled")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mangled'".to_string()))?;
        let result = rustre_demangle::demangle(mangled);
        let payload = serde_json::to_value(&result)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "mangled": mangled,
                "result": payload,
                "source": "rustre_demangle::demangle",
            })
            .to_string(),
        ))
    }
}

