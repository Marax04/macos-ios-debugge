/// Clamp a raw integer to a Confidence value (0..=100).
pub struct TiOpenctiConfidenceClampTool;

impl TiOpenctiConfidenceClampTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_opencti_confidence_clamp".to_string(),
            description: "Clamp a raw integer to a valid OpenCTI Confidence value (0..=100) \
                          via rustre_ti_opencti::Confidence::new."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "value": { "type": "integer", "minimum": 0, "maximum": 255 } },
                "required": ["value"],
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiOpenctiConfidenceClampTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let v = args.get("value").and_then(serde_json::Value::as_u64).unwrap_or(0);
        let clamped = rustre_ti_opencti::Confidence::new(v.min(255) as u8);
        Ok(ToolResult::text(
            json!({ "value": clamped.value(), "is_high": clamped.is_high() }).to_string(),
        ))
    }
}

