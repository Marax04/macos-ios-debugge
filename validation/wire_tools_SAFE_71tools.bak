            description: "Parse logcat output and keep only entries whose tag starts with the given case-insensitive prefix.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["output", "tag_prefix"],
                "properties": {
                    "output": { "type": "string", "description": "Raw logcat output text" },
                    "tag_prefix": { "type": "string", "description": "Case-insensitive tag prefix" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbFilterByTagTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args.get("output").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".into()))?;
        let tag = args.get("tag_prefix").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'tag_prefix'".into()))?;
        let entries = rustre_adb::parse_logcat_output(output);
        let filtered: Vec<&rustre_adb::LogEntry> = rustre_adb::filter_by_tag(&entries, tag);
        Ok(ToolResult::text(
            json!({ "count": filtered.len(), "entries": filtered }).to_string(),
        ))
    }
}

pub struct AdbGroupByTagTool;

impl AdbGroupByTagTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_group_by_tag".to_string(),
            description: "Parse logcat output and return entries grouped by tag, with per-tag counts.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["output"],
                "properties": {
                    "output": { "type": "string", "description": "Raw logcat output text" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbGroupByTagTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args.get("output").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".into()))?;
        let entries = rustre_adb::parse_logcat_output(output);
        let grouped = rustre_adb::group_by_tag(&entries);
        let counts: std::collections::BTreeMap<String, usize> =
            grouped.iter().map(|(k, v)| (k.clone(), v.len())).collect();
        let groups: std::collections::BTreeMap<String, Vec<&rustre_adb::LogEntry>> =
            grouped.into_iter().collect();
        Ok(ToolResult::text(
            json!({ "tag_count": groups.len(), "counts": counts, "groups": groups }).to_string(),
        ))
    }
}

