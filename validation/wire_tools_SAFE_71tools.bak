/// Generate a NOP sled of `length` bytes via `rustre_script_lua::lua_nop_sled`.
pub struct ScriptLuaNopSledTool;

impl ScriptLuaNopSledTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_lua_nop_sled".to_string(),
            description: "Return a NOP sled (0x90 bytes) of the requested length using rustre_script_lua::lua_nop_sled.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["length"],
                "properties": {
                    "length": { "type": "integer", "minimum": 0, "maximum": 65536 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptLuaNopSledTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let length = args.get("length").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'length'".into()))? as usize;
        if length > 65536 {
            return Err(McpError::InvalidParams("length exceeds 65536".into()));
        }
        let sled = rustre_script_lua::lua_nop_sled(length);
        Ok(ToolResult::text(json!({
            "length": sled.len(),
            "hex": hex_encode(&sled),
            "source": "rustre_script_lua::lua_nop_sled",
        }).to_string()))
    }
}

// â”€â”€â”€ rustre-analysis-cfg wire wrappers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn parse_flow_edge_kind(s: &str) -> Result<rustre_analysis_cfg::FlowEdgeKind, McpError> {
    use rustre_analysis_cfg::FlowEdgeKind as K;
    match s {
        "Fallthrough" | "fallthrough" => Ok(K::Fallthrough),
        "Jump" | "jump" => Ok(K::Jump),
        "BranchTaken" | "branch_taken" => Ok(K::BranchTaken),
        "BranchNotTaken" | "branch_not_taken" => Ok(K::BranchNotTaken),
        "Call" | "call" => Ok(K::Call),
        "Return" | "return" => Ok(K::Return),
        "Indirect" | "indirect" => Ok(K::Indirect),
        _ => Err(McpError::InvalidParams(format!("unknown FlowEdgeKind: {s}"))),
    }
}

