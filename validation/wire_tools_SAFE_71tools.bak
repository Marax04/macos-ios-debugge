            input_schema: json!({"type":"object","properties":{"bytes":{"type":"array","items":{"type":"integer"}},"hex":{"type":"string"},"add_key":{"type":"integer"},"rol_amount":{"type":"integer"},"add_first":{"type":"boolean"}}}),
