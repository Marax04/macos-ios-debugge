/// Parse a MISP attribute type string into a canonical `IoCType` name.
pub struct TiMispParseAttributeTypeTool;

impl TiMispParseAttributeTypeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_parse_attribute_type".to_string(),
            description:
                "Parse a MISP attribute type string (e.g. 'md5', 'ip-dst', 'domain') \
                 into the canonical rustre_threatintel::IoCType, if recognised."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "attr_type": { "type": "string" }
                },
                "required": ["attr_type"]
