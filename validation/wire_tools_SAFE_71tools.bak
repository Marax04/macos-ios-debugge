            input_schema: json!({"type":"object","required":["hook_id","address","thread_id"],"properties":{"hook_id":{"type":"integer"},"address":{"type":"integer"},"thread_id":{"type":"integer"},"args":{"type":"array","items":{"type":"integer"}},"return_value":{"type":["integer","null"]},"timestamp":{"type":"integer"}}}),
            parameters: Value::Null,
        }
    }
}
#[async_trait]
impl ToolHandler for DebugFridaInterceptorRecordDisplayTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hook_id = args.get("hook_id").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'hook_id'".into()))?;
        let address = args.get("address").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'address'".into()))?;
        let thread_id = args.get("thread_id").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("missing 'thread_id'".into()))? as u32;
        let call_args: Vec<u64> = args.get("args").and_then(Value::as_array)
            .map(|a| a.iter().filter_map(Value::as_u64).collect()).unwrap_or_default();
        let return_value = args.get("return_value").and_then(Value::as_u64);
        let timestamp = args.get("timestamp").and_then(Value::as_u64).unwrap_or(0);
        let r = rustre_debug_frida::InterceptorRecord {
            hook_id, address, thread_id, args: call_args.clone(), return_value, timestamp,
        };
        Ok(ToolResult::text(json!({
            "display": r.to_string(),
            "hook_id": r.hook_id,
            "address": r.address,
            "thread_id": r.thread_id,
            "args_len": r.args.len(),
            "has_return_value": r.return_value.is_some(),
            "source": "rustre_debug_frida::InterceptorRecord",
        }).to_string()))
    }
}

