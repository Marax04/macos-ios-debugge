/// List the built-in RE workflow agents and their capabilities via
/// `rustre_agent::builtin_workflows`.
pub struct AgentBuiltinWorkflowsTool;

impl AgentBuiltinWorkflowsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "agent_builtin_workflows".to_string(),
            description: "List the names and capabilities of the built-in RE \
                          agents returned by rustre_agent::builtin_workflows."
                .to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AgentBuiltinWorkflowsTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let workflows = rustre_agent::builtin_workflows();
        let agents: Vec<Value> = workflows
            .iter()
            .map(|(agent, _cfg)| {
                let caps: Vec<String> = agent
                    .capabilities()
                    .iter()
                    .map(|c| format!("{c:?}"))
                    .collect();
                json!({
                    "name": agent.name(),
                    "description": agent.description(),
                    "capabilities": caps,
                })
            })
            .collect();
        Ok(ToolResult::text(json!({
            "count": agents.len(),
            "agents": agents,
            "source": "rustre_agent::builtin_workflows",
        }).to_string()))
    }
}

