// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ iOS ObjC scanners (path-based) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Scan a Mach-O binary on disk for ObjC selector strings.
pub struct IosScanObjcSelectorsPathTool;

impl IosScanObjcSelectorsPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ios_scan_objc_selectors_path".to_string(),
            description: "Scan a Mach-O binary on disk for ObjC selector strings from __TEXT,__objc_methnames (fallback __DATA,__objc_selrefs)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the Mach-O binary" }
                },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for IosScanObjcSelectorsPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let data = std::fs::read(path)
            .map_err(|e| McpError::InternalError(format!("read failed: {e}")))?;
        let sels = rustre_mobile_ios::scan_objc_selectors(&data);
        Ok(ToolResult::text(
            json!({
                "path": path,
                "count": sels.len(),
                "selectors": sels,
                "source": "rustre_mobile_ios::scan_objc_selectors",
            })
            .to_string(),
        ))
    }
}

