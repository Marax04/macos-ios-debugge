/// Wrapper for `rustre_loader_firmware::detect_firmware_kind`.
pub struct FirmwareDetectKindV2Tool;

impl FirmwareDetectKindV2Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "firmware_detect_kind_v2".to_string(),
            description: "Detect the firmware container kind (U-Boot, IntelHex, SREC, UF2, \
