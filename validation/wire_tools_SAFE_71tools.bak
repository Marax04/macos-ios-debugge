pub struct EventsKindSubscriptionTool;

impl EventsKindSubscriptionTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "events_kind_subscription".to_string(),
            description: "Create a rustre_events::kind_subscription for the given EventKind and report its initial counters.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": {"type": "string"} }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EventsKindSubscriptionTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let kind_str = args.get("kind").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'kind'".into()))?;
        let kind = match kind_str {
            "View" => rustre_events::EventKind::View,
            "Analysis" => rustre_events::EventKind::Analysis,
            "Function" => rustre_events::EventKind::Function,
            "Symbol" => rustre_events::EventKind::Symbol,
            "Debugger" => rustre_events::EventKind::Debugger,
            "Memory" => rustre_events::EventKind::Memory,
            "Type" => rustre_events::EventKind::Type,
            "Patch" => rustre_events::EventKind::Patch,
            "Annotation" => rustre_events::EventKind::Annotation,
            "Agent" => rustre_events::EventKind::Agent,
            "CrossRef" => rustre_events::EventKind::CrossRef,
            "Script" => rustre_events::EventKind::Script,
            "Plugin" => rustre_events::EventKind::Plugin,
            "Custom" => rustre_events::EventKind::Custom,
            _ => return Err(McpError::InvalidParams(format!("invalid kind: {kind_str}"))),
        };
        let bus = rustre_events::EventBus::new_default();
        let sub = rustre_events::kind_subscription(&bus, kind);
        Ok(ToolResult::text(json!({
            "kind": kind_str,
            "received_count": sub.received_count(),
            "delivered_count": sub.delivered_count(),
            "source": "rustre_events::kind_subscription",
        }).to_string()))
    }
}

pub struct ScriptErrorIsRecoverableTool;

impl ScriptErrorIsRecoverableTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_error_is_recoverable".to_string(),
            description:
                "Return whether a rustre-script ScriptError variant is recoverable \
                 (non-fatal) via ScriptError::is_recoverable."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["variant"],
                "properties": {
                    "variant": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptErrorIsRecoverableTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let variant = args
            .get("variant")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'variant'".into()))?;
        let err = match variant {
            "FunctionNotFound" => rustre_script::ScriptError::FunctionNotFound(String::new()),
            "UndefinedVariable" => rustre_script::ScriptError::UndefinedVariable(String::new()),
            "TypeMismatch" => rustre_script::ScriptError::TypeMismatch {
                expected: String::new(),
                got: String::new(),
            },
            "ArityMismatch" => rustre_script::ScriptError::ArityMismatch {
                name: String::new(),
                expected: 0,
                got: 0,
            },
            "RuntimeError" => rustre_script::ScriptError::RuntimeError(String::new()),
            "DivisionByZero" => rustre_script::ScriptError::DivisionByZero,
            "StackOverflow" => rustre_script::ScriptError::StackOverflow,
            other => {
                return Err(McpError::InvalidParams(format!(
                    "unknown variant '{other}'"
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "variant":     variant,
                "recoverable": err.is_recoverable(),
                "source":      "rustre_script::ScriptError::is_recoverable",
            })
            .to_string(),
        ))
    }
}

