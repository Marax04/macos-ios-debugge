#[async_trait]
impl ToolHandler for TraceOpenTraceFileTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let p = std::path::Path::new(path);
        match rustre_trace::open_trace_file(p) {
            Ok(_store) => Ok(ToolResult::text(
                json!({ "path": path, "opened": true }).to_string(),
            )),
            Err(e) => Err(McpError::InternalError(format!("open_trace_file: {e}"))),
        }
    }
}

