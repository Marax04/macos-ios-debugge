// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-il-passes wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `rustre_il_passes::count_instrs` as an MCP tool.
///
/// The wire wrapper does not currently serialize a full `LlilFunction` across
/// the JSON boundary; instead it evaluates the pass over a fresh, empty
/// function (`LlilFunction::default()`) so callers can validate that the
/// pass wiring links correctly and returns `0` for the trivial case.
pub struct IlPassesCountInstrsTool;

impl IlPassesCountInstrsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "il_passes_count_instrs".to_string(),
            description: "Count the total number of LLIL instructions in a (default/empty) LlilFunction via rustre_il_passes::count_instrs.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {}
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for IlPassesCountInstrsTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let func = rustre_il_llil::LlilFunction::default();
        let n = rustre_il_passes::count_instrs(&func);
        Ok(ToolResult::text(
            json!({ "count": n, "source": "rustre_il_passes::count_instrs" }).to_string(),
        ))
    }
}

