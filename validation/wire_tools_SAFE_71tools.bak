        let bytes = args.get("bytes").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'bytes'".into()))?
            .iter().map(|v| v.as_u64().map(|x| x as u8).unwrap_or(0)).collect::<Vec<u8>>();
