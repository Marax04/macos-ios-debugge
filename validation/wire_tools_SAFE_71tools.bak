/// Compute the GNU-hash of a UTF-8 symbol name (as used in `.gnu.hash`).
pub struct LoaderElfGnuHashStrTool;

impl LoaderElfGnuHashStrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_elf_gnu_hash_str".to_string(),
            description: "Compute the GNU-hash of a symbol name string \
                          (rustre_loader_elf::gnu_hash_str)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderElfGnuHashStrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let h = rustre_loader_elf::gnu_hash_str(name);
        Ok(ToolResult::text(
            json!({
                "name": name,
                "gnu_hash": h,
                "gnu_hash_hex": format!("0x{h:08x}"),
                "source": "rustre_loader_elf::gnu_hash_str",
            })
            .to_string(),
        ))
    }
}

/// Compute the GNU-hash over raw bytes.
pub struct LoaderElfGnuHashBytesTool;

impl LoaderElfGnuHashBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
