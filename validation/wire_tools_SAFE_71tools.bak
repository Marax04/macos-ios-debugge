// â”€â”€â”€ rustre-debug-macos wrappers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Wrap `BreakpointManager::insert` + `all` from `rustre_debug_macos`.
pub struct DebugMacosBreakpointManagerBuildTool;

impl DebugMacosBreakpointManagerBuildTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_macos_breakpoint_manager_build".to_string(),
            description:
                "Build a rustre_debug_macos::BreakpointManager from a list of \
                 (addr, byte) entries and return the resulting breakpoint set."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "entries": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "addr": { "type": "integer" },
                                "byte": { "type": "integer" }
                            },
                            "required": ["addr", "byte"]
                        }
                    }
                },
                "required": ["entries"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DebugMacosBreakpointManagerBuildTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let entries = args
            .get("entries")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'entries'".into()))?;
        let mut mgr = rustre_debug_macos::BreakpointManager::new();
        for e in entries {
            let addr = e
                .get("addr")
                .and_then(Value::as_u64)
                .ok_or_else(|| McpError::InvalidParams("entry: missing 'addr'".into()))?;
            let byte_u = e
                .get("byte")
                .and_then(Value::as_u64)
                .ok_or_else(|| McpError::InvalidParams("entry: missing 'byte'".into()))?;
            let byte = u8::try_from(byte_u)
                .map_err(|_| McpError::InvalidParams("entry: byte out of range".into()))?;
            mgr.insert(addr, byte);
        }
        let mut all = mgr.all();
        all.sort_unstable();
        Ok(ToolResult::text(
            json!({
                "count": all.len(),
                "addresses": all,
                "source": "rustre_debug_macos::BreakpointManager",
            })
            .to_string(),
        ))
    }
}

/// Wrap the `rustre_debug_macos::MacosProcess` struct.
pub struct DebugMacosProcessDescribeTool;

impl DebugMacosProcessDescribeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_macos_process_describe".to_string(),
            description:
                "Construct a rustre_debug_macos::MacosProcess descriptor from \
                 (pid, task_port, thread_ports) and return its fields."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "pid":          { "type": "integer" },
                    "task_port":    { "type": "integer" },
                    "thread_ports": { "type": "array", "items": { "type": "integer" } }
                },
                "required": ["pid", "task_port"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DebugMacosProcessDescribeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let pid = args
            .get("pid")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'pid'".into()))?;
        let pid_u32 = u32::try_from(pid)
            .map_err(|_| McpError::InvalidParams("pid out of range".into()))?;
        let task_port = args
            .get("task_port")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'task_port'".into()))?;
        let task_port_u32 = u32::try_from(task_port)
            .map_err(|_| McpError::InvalidParams("task_port out of range".into()))?;
        let thread_ports: Vec<u32> = args
            .get("thread_ports")
            .and_then(Value::as_array)
            .map(|arr| {
                arr.iter()
                    .filter_map(|v| v.as_u64().and_then(|n| u32::try_from(n).ok()))
                    .collect()
            })
            .unwrap_or_default();
        let proc = rustre_debug_macos::MacosProcess {
            pid: rustre_debug::ProcessId(pid_u32),
            task_port: task_port_u32,
            thread_ports,
        };
        Ok(ToolResult::text(
            json!({
                "pid":          proc.pid.0,
                "task_port":    proc.task_port,
                "thread_ports": proc.thread_ports,
                "source": "rustre_debug_macos::MacosProcess",
            })
            .to_string(),
        ))
    }
}

