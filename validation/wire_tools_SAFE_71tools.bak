pub struct MemKx7DiffBytesChangeRatioTool;
impl MemKx7DiffBytesChangeRatioTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_diff_bytes_change_ratio".to_string(), description: "Changed bytes / min(a,b) length ratio.".to_string(), input_schema: json!({"type":"object","required":["a_hex","b_hex"],"properties":{"a_hex":{"type":"string"},"b_hex":{"type":"string"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7DiffBytesChangeRatioTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let a = __mem_hex_decode_v2(args.get("a_hex").and_then(Value::as_str).unwrap_or("")); let b = __mem_hex_decode_v2(args.get("b_hex").and_then(Value::as_str).unwrap_or("")); let s = rustre_mem::diff::diff_bytes(__mem_kx7_addr(0), &a, &b); let total: usize = s.iter().map(rustre_mem::DiffSpan::len).sum(); let denom = a.len().min(b.len()); let ratio = if denom > 0 { total as f64 / denom as f64 } else { 0.0 }; Ok(ToolResult::text(json!({"ratio":ratio,"changed":total,"denom":denom,"source":"rustre_mem::diff::diff_bytes"}).to_string())) } }

pub struct MemKx7SnapshotDiffApplyTool;
impl MemKx7SnapshotDiffApplyTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_snapshotdiff_apply".to_string(), description: "diff_memory(a,b) then apply_to a buffer of len=a.len(); reports success.".to_string(), input_schema: json!({"type":"object","required":["a_hex","b_hex"],"properties":{"a_hex":{"type":"string"},"b_hex":{"type":"string"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7SnapshotDiffApplyTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let a = __mem_hex_decode_v2(args.get("a_hex").and_then(Value::as_str).unwrap_or("")); let b = __mem_hex_decode_v2(args.get("b_hex").and_then(Value::as_str).unwrap_or("")); if a.len() != b.len() { return Err(McpError::InternalError("a and b must have equal length".into())); } let d = rustre_mem::diff_memory(&a, &b, __mem_kx7_addr(0)); let mut buf = a.clone(); let ok = d.apply_to(&mut buf, __mem_kx7_addr(0)).is_ok(); let matches = ok && buf == b; Ok(ToolResult::text(json!({"apply_ok":ok,"buffer_equals_b":matches,"buffer_len":buf.len(),"source":"rustre_mem::SnapshotDiff::apply_to"}).to_string())) } }

