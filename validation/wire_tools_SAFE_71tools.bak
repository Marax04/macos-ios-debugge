pub struct AgentBumpPriorityTool;

impl AgentBumpPriorityTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "agent_bump_priority".to_string(),
            description: "Bump the priority of an AgentTask via \
                          rustre_agent::agent_task_queue::bump_priority. \
                          Inputs: current priority (0..=3) and new priority (0..=3).".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "current": {"type": "integer", "description": "Current priority 0..=3"},
                    "new": {"type": "integer", "description": "New priority 0..=3"}
                },
                "required": ["current", "new"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AgentBumpPriorityTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_agent::agent_task_queue::{AgentTask as QTask, TaskPriority as QPrio};
        fn to_prio(n: u64) -> Result<QPrio, McpError> {
            match n {
                0 => Ok(QPrio::Low),
                1 => Ok(QPrio::Normal),
                2 => Ok(QPrio::High),
                3 => Ok(QPrio::Critical),
                _ => Err(McpError::InvalidParams("priority must be 0..=3".into())),
            }
        }
        let cur = args.get("current").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'current'".into()))?;
        let new = args.get("new").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'new'".into()))?;
        let cur_p = to_prio(cur)?;
        let new_p = to_prio(new)?;
        let task = QTask::new("wire_bump_priority", "analyze", cur_p, Value::Null);
        let bumped = rustre_agent::agent_task_queue::bump_priority(task, new_p);
        Ok(ToolResult::text(
            json!({
                "resulting_priority": format!("{:?}", bumped.priority),
                "source": "rustre_agent::agent_task_queue::bump_priority",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-emu-unicorn wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `rustre_emu_unicorn::Mode::ptr_size` as an MCP tool.
pub struct EmuUnicornModePtrSizeTool;

impl EmuUnicornModePtrSizeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_unicorn_mode_ptr_size".to_string(),
            description: "Return the pointer size in bytes for a Unicorn emulator Mode identifier.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["mode"],
                "properties": {
                    "mode": { "type": "string", "description": "Mode name (e.g. 'X86_64', 'ArmMode', 'Mips32BE')" }
                }
            }),
            parameters: Value::Null,
        }
    }

    fn parse_mode(name: &str) -> Option<rustre_emu_unicorn::Mode> {
        use rustre_emu_unicorn::Mode;
        Some(match name {
            "X86_16" => Mode::X86_16,
            "X86_32" => Mode::X86_32,
            "X86_64" => Mode::X86_64,
            "ArmMode" => Mode::ArmMode,
            "ThumbMode" => Mode::ThumbMode,
            "Arm64Mode" => Mode::Arm64Mode,
            "Mips32LE" => Mode::Mips32LE,
            "Mips32BE" => Mode::Mips32BE,
            "Mips64LE" => Mode::Mips64LE,
            "Mips64BE" => Mode::Mips64BE,
            "Sparc32" => Mode::Sparc32,
            "Sparc64" => Mode::Sparc64,
            "RiscV32" => Mode::RiscV32,
            "RiscV64" => Mode::RiscV64,
            "M68K" => Mode::M68K,
            "Ppc32" => Mode::Ppc32,
            "Ppc64" => Mode::Ppc64,
            "S390X" => Mode::S390X,
            _ => return None,
        })
    }
}

#[async_trait]
impl ToolHandler for EmuUnicornModePtrSizeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mode_str = args.get("mode").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mode'".into()))?;
        let mode = Self::parse_mode(mode_str)
            .ok_or_else(|| McpError::InvalidParams(format!("unknown mode '{mode_str}'")))?;
        let ptr_size = mode.ptr_size();
        Ok(ToolResult::text(
            json!({ "mode": mode_str, "ptr_size": ptr_size }).to_string(),
        ))
    }
}

/// Expose `rustre_emu_unicorn::Mode::is_little_endian` as an MCP tool.
pub struct EmuUnicornModeIsLittleEndianTool;

impl EmuUnicornModeIsLittleEndianTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_unicorn_mode_is_little_endian".to_string(),
            description: "Report whether a Unicorn emulator Mode is little-endian.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["mode"],
                "properties": {
                    "mode": { "type": "string", "description": "Mode name (e.g. 'X86_64', 'Mips32BE')" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuUnicornModeIsLittleEndianTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mode_str = args.get("mode").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mode'".into()))?;
        let mode = EmuUnicornModePtrSizeTool::parse_mode(mode_str)
            .ok_or_else(|| McpError::InvalidParams(format!("unknown mode '{mode_str}'")))?;
        let le = mode.is_little_endian();
        Ok(ToolResult::text(
