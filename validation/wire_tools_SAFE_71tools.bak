pub struct DebugMacosVmRegionMapOpsTool;
impl DebugMacosVmRegionMapOpsTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "debug_macos_vm_region_map_ops".to_string(), description: "Build a VmRegionMap from regions and report len/is_empty/total_size and lookup.".to_string(), input_schema: json!({ "type": "object", "properties": { "regions": {"type":"array"}, "query": {"type":"integer"} }, "required":["regions"] }), parameters: Value::Null } } }
#[async_trait]
impl ToolHandler for DebugMacosVmRegionMapOpsTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let arr = args.get("regions").and_then(Value::as_array).ok_or_else(|| McpError::InvalidParams("missing 'regions'".into()))?; let mut map = rustre_debug_macos::VmRegionMap::new(); for r in arr { let addr = r.get("address").and_then(Value::as_u64).unwrap_or(0); let size = r.get("size").and_then(Value::as_u64).unwrap_or(0); let prot = r.get("prot").and_then(Value::as_u64).unwrap_or(0) as u32; map.add(rustre_debug_macos::MachVmRegion { address: addr, size, protection: rustre_debug_macos::MachVmProtection::from_raw(prot), max_protection: rustre_debug_macos::MachVmProtection::from_raw(prot), name: String::new() }); } let q = args.get("query").and_then(Value::as_u64); let found = q.and_then(|q| map.find(q).map(|r| r.address)); Ok(ToolResult::text(json!({ "len": map.len(), "is_empty": map.is_empty(), "total_size": map.total_size(), "executable_count": map.executable_regions().len(), "writable_count": map.writable_regions().len(), "query": q, "found_address": found, "source": "rustre_debug_macos::VmRegionMap" }).to_string())) } }

pub struct DebugMacosDyldImageListFindTool;
impl DebugMacosDyldImageListFindTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "debug_macos_dyld_image_list_find".to_string(), description: "Populate a DyldImageList and query find_by_name/image_at.".to_string(), input_schema: json!({ "type": "object", "properties": { "images": {"type":"array"}, "name": {"type":"string"}, "addr": {"type":"integer"} } }), parameters: Value::Null } } }
#[async_trait]
impl ToolHandler for DebugMacosDyldImageListFindTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let arr = args.get("images").and_then(Value::as_array).cloned().unwrap_or_default(); let mut list = rustre_debug_macos::DyldImageList::default(); for i in arr { let load = i.get("load_address").and_then(Value::as_u64).unwrap_or(0); let path = i.get("path").and_then(Value::as_str).unwrap_or("").to_string(); let slide = i.get("slide").and_then(Value::as_i64).unwrap_or(0); list.images.push(rustre_debug_macos::DyldImage { load_address: load, path, slide }); } let name = args.get("name").and_then(Value::as_str); let addr = args.get("addr").and_then(Value::as_u64); let by_name = name.and_then(|n| list.find_by_name(n).map(|i| i.path.clone())); let at_addr = addr.and_then(|a| list.image_at(a).map(|i| i.path.clone())); Ok(ToolResult::text(json!({ "len": list.len(), "is_empty": list.is_empty(), "find_by_name": by_name, "image_at": at_addr, "source": "rustre_debug_macos::DyldImageList" }).to_string())) } }

