/// Decode a raw STABS `n_type` byte into its canonical `N_`-prefixed name.
pub struct StabsTypeNameForTool;

impl StabsTypeNameForTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "stabs_type_name_for".to_string(),
            description: "Map a raw STABS n_type byte to its canonical N_-prefixed \
                          name (e.g. 0x24 -> N_FUN). Mirrors \
                          rustre_symbols_stabs::StabType::name_for."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "byte": { "type": "integer", "minimum": 0, "maximum": 255 } },
                "required": ["byte"],
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for StabsTypeNameForTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let b = args
            .get("byte")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("byte: required u8".to_string()))?;
        let b = u8::try_from(b)
            .map_err(|_| McpError::InvalidParams("byte: out of range".to_string()))?;
        let name = rustre_symbols_stabs::StabType::name_for(b);
        Ok(ToolResult::text(
            json!({
                "byte": b,
                "name": name,
                "known": name.is_some(),
                "source": "rustre_symbols_stabs::StabType::name_for",
            })
            .to_string(),
        ))
    }
}

/// Classify a STABS type descriptor character (the byte after `:` in `name:X`).
pub struct StabsTypeCodeFromCharTool;

impl StabsTypeCodeFromCharTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "stabs_type_code_from_char".to_string(),
            description: "Classify the STABS type-descriptor character (e.g. 'f', \
                          'F', 'g', 't', 'T') via \
                          rustre_symbols_stabs::StabTypeCode::from_char."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "ch": { "type": "string", "minLength": 1, "maxLength": 1 } },
                "required": ["ch"],
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for StabsTypeCodeFromCharTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args
            .get("ch")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("ch: required single char".to_string()))?;
        let c = s
            .chars()
            .next()
            .ok_or_else(|| McpError::InvalidParams("ch: empty".to_string()))?;
        let code = rustre_symbols_stabs::StabTypeCode::from_char(c);
        Ok(ToolResult::text(
            json!({
                "input": c.to_string(),
                "code": format!("{:?}", code),
                "display": code.to_string(),
                "source": "rustre_symbols_stabs::StabTypeCode::from_char",
            })
            .to_string(),
        ))
    }
}

/// Wrapper: decode `MemRegion` permission bits (read/write/execute) via
/// `rustre_debug_unicorn::MemRegion` helper methods.
pub struct DebugUnicornMemRegionPermsTool;

impl DebugUnicornMemRegionPermsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_unicorn_mem_region_perms".to_string(),
            description: "Decode a Unicorn MemRegion perms bitmask into r/w/x flags."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "addr":  { "type": "integer" },
                    "size":  { "type": "integer" },
                    "perms": { "type": "integer" }
                },
                "required": ["perms"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DebugUnicornMemRegionPermsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let addr = args.get("addr").and_then(Value::as_u64).unwrap_or(0);
        let size = args.get("size").and_then(Value::as_u64).unwrap_or(0);
        let perms_u = args
            .get("perms")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("perms: required".to_string()))?;
        let perms = u8::try_from(perms_u)
            .map_err(|_| McpError::InvalidParams("perms: out of u8 range".to_string()))?;
        let r = rustre_debug_unicorn::MemRegion { addr, size, perms };
        Ok(ToolResult::text(
            json!({
                "addr": r.addr,
                "size": r.size,
                "perms": r.perms,
                "readable": r.readable(),
                "writable": r.writable(),
                "executable": r.executable(),
                "display": r.to_string(),
                "source": "rustre_debug_unicorn::MemRegion",
            })
            .to_string(),
        ))
    }
}

/// Wrapper: report the pointer size (bytes) for a `v2::UnicornArch` variant.
pub struct DebugUnicornArchPointerSizeTool;

impl DebugUnicornArchPointerSizeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_unicorn_arch_pointer_size".to_string(),
            description: "Return the pointer size in bytes for a Unicorn v2 architecture."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "arch": { "type": "string" }
                },
                "required": ["arch"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DebugUnicornArchPointerSizeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arch = args
            .get("arch")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("arch: required".to_string()))?;
        let parsed = match arch {
            "x86" => rustre_debug_unicorn::v2::UnicornArch::X86,
            "x86_64" => rustre_debug_unicorn::v2::UnicornArch::X86_64,
            "arm" => rustre_debug_unicorn::v2::UnicornArch::Arm,
            "arm64" => rustre_debug_unicorn::v2::UnicornArch::Arm64,
            "mips" => rustre_debug_unicorn::v2::UnicornArch::Mips,
            "sparc" => rustre_debug_unicorn::v2::UnicornArch::Sparc,
            _ => {
                return Err(McpError::InvalidParams(format!(
                    "arch: unknown variant '{arch}'"
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "arch": parsed.to_string(),
                "pointer_size": parsed.pointer_size(),
                "source": "rustre_debug_unicorn::v2::UnicornArch::pointer_size",
            })
            .to_string(),
        ))
    }
}

/// Wrapper that lists the built-in binary-template names from `rustre-hex-template`.
pub struct HexTemplateBuiltinNamesTool;

impl HexTemplateBuiltinNamesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_template_builtin_names".to_string(),
            description: "Return the sorted names of built-in binary templates \
                          exposed by rustre_hex_template::builtin_templates."
                .to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexTemplateBuiltinNamesTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let map = rustre_hex_template::builtin_templates();
        let mut names: Vec<String> = map.keys().cloned().collect();
        names.sort();
        Ok(ToolResult::text(
            json!({
                "count": names.len(),
                "names": names,
                "source": "rustre_hex_template::builtin_templates",
            })
            .to_string(),
        ))
    }
}

/// Wrapper that extracts a bit-field slice from a raw u64 using
/// `rustre_hex_template::BitfieldDef::extract`.
pub struct HexTemplateBitfieldExtractTool;

impl HexTemplateBitfieldExtractTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_template_bitfield_extract".to_string(),
            description: "Extract a bit-field slice from a raw u64 using \
                          rustre_hex_template::BitfieldDef::extract."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "raw":       { "type": "integer" },
                    "start_bit": { "type": "integer" },
                    "bit_count": { "type": "integer" }
                },
                "required": ["raw", "start_bit", "bit_count"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexTemplateBitfieldExtractTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let raw = args
            .get("raw")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("raw: required u64".to_string()))?;
        let start_bit = args
            .get("start_bit")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("start_bit: required u8".to_string()))?
            as u8;
        let bit_count = args
            .get("bit_count")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("bit_count: required u8".to_string()))?
            as u8;
        let def = rustre_hex_template::BitfieldDef::new("f", start_bit, bit_count);
        let value = def.extract(raw);
        Ok(ToolResult::text(
            json!({
                "raw": raw,
                "start_bit": start_bit,
                "bit_count": bit_count,
                "value": value,
                "source": "rustre_hex_template::BitfieldDef::extract",
            })
            .to_string(),
        ))
    }
}

// --- CodeView signature detection wrappers ---

pub struct CodeviewSignatureFromBytesTool;

impl CodeviewSignatureFromBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "codeview_signature_from_bytes".to_string(),
            description:
                "Detect a CodeView signature (NB09/NB10/NB11/RSDS/CV8) from the \
                 first 4 bytes of a buffer via rustre_symbols_codeview::CvSignature::from_bytes."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for CodeviewSignatureFromBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let sig = rustre_symbols_codeview::CvSignature::from_bytes(&data);
        Ok(ToolResult::text(
            json!({
                "signature": sig.map(|s| s.as_str()),
                "detected":  sig.is_some(),
                "bytes":     data.len(),
                "hex_prefix": hex_encode(&data[..data.len().min(4)]),
                "source":    "rustre_symbols_codeview::CvSignature::from_bytes",
            })
            .to_string(),
        ))
    }
}

pub struct CodeviewSignatureAsStrTool;

impl CodeviewSignatureAsStrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "codeview_signature_as_str".to_string(),
            description:
                "Return the human-readable label for a CodeView signature variant \
                 (cv41/cv50/cv70/pdb70/cv8) via CvSignature::as_str."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["variant"],
                "properties": {
                    "variant": { "type": "string",
                                 "enum": ["cv41", "cv50", "cv70", "pdb70", "cv8"] }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for CodeviewSignatureAsStrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let variant = args
            .get("variant")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'variant'".into()))?;
        let sig = match variant {
            "cv41"  => rustre_symbols_codeview::CvSignature::Cv41,
            "cv50"  => rustre_symbols_codeview::CvSignature::Cv50,
            "cv70"  => rustre_symbols_codeview::CvSignature::Cv70,
            "pdb70" => rustre_symbols_codeview::CvSignature::Pdb70,
            "cv8"   => rustre_symbols_codeview::CvSignature::Cv8,
            other   => return Err(McpError::InvalidParams(format!(
                "unknown variant '{other}'"
            ))),
        };
        Ok(ToolResult::text(
            json!({
                "variant": variant,
                "label":   sig.as_str(),
                "source":  "rustre_symbols_codeview::CvSignature::as_str",
            })
            .to_string(),
        ))
    }
}

