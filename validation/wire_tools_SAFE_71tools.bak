/// Decode an ECMA-335 compressed unsigned integer from the beginning of a blob.
pub struct LoaderDotnetReadCompressedUintTool;

impl LoaderDotnetReadCompressedUintTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_dotnet_read_compressed_uint".to_string(),
            description: "Read a single ECMA-335 compressed unsigned integer from the start of a blob.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderDotnetReadCompressedUintTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let mut off: usize = 0;
        let value = rustre_loader_dotnet::read_compressed_uint(&data, &mut off);
        Ok(ToolResult::text(
            json!({ "value": value, "consumed": off, "bytes": data.len() }).to_string(),
        ))
    }
}

