                },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisTypeWinapiLookupTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let dll = args.get("dll").and_then(Value::as_str);
        let sig = match dll {
            Some(d) => rustre_analysis_type::WinApiTypeDb::lookup(name, d),
            None => rustre_analysis_type::WinApiTypeDb::lookup_by_name(name),
        };
        let found = sig.is_some();
        let payload = serde_json::to_value(&sig)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(json!({
            "name": name,
            "dll": dll,
            "found": found,
            "signature": payload
        }).to_string()))
    }
}

// --- threatintel extra: link_ioc, indicator db get/is_empty ------------------

/// Link an IocId to a threat group and report the resulting IOC count.
pub struct ThreatintelGroupLinkIocTool;

impl ThreatintelGroupLinkIocTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_group_link_ioc".to_string(),
            description:
                "Attach an IocId to a group in a fresh ThreatGroupTracker via \
                 rustre_threatintel::ThreatGroup::link_ioc and report iocs.len()."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "group": { "type": "string" },
                    "ioc_id": { "type": "integer", "minimum": 0 }
                },
                "required": ["group", "ioc_id"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelGroupLinkIocTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let group = args
            .get("group")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'group'".to_string()))?;
        let id_raw = args
            .get("ioc_id")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'ioc_id'".to_string()))?;
        let mut tracker = rustre_threatintel::ThreatGroupTracker::new();
        let target = tracker.get_mut(group).ok_or_else(|| {
            McpError::InvalidParams(format!("unknown group '{group}'"))
        })?;
        target.link_ioc(rustre_threatintel::IocId(id_raw));
        let count = target.iocs.len();
        Ok(ToolResult::text(
            json!({
                "group": group,
                "ioc_id": id_raw,
                "linked_count": count,
                "source": "rustre_threatintel::ThreatGroup::link_ioc",
            })
            .to_string(),
        ))
    }
}

/// Report is_empty() on a freshly-constructed ThreatIndicatorDatabase.
pub struct ThreatintelIndicatorDbIsEmptyTool;

impl ThreatintelIndicatorDbIsEmptyTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_indicator_db_is_empty".to_string(),
            description:
                "Construct a rustre_threatintel::ThreatIndicatorDatabase, optionally \
                 add one IOC, and report is_empty()/len()."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "add_one": { "type": "boolean" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelIndicatorDbIsEmptyTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let add_one = args.get("add_one").and_then(Value::as_bool).unwrap_or(false);
        let mut db = rustre_threatintel::ThreatIndicatorDatabase::new();
        let empty_before = db.is_empty();
        if add_one {
            db.add_ioc(rustre_threatintel::ThreatIoc::new(
                rustre_threatintel::IocType::Md5,
                "deadbeef",
                "wire-probe",
                0.5,
                "wire-tool",
            ));
        }
        Ok(ToolResult::text(
            json!({
                "empty_before": empty_before,
                "is_empty": db.is_empty(),
                "len": db.len(),
                "source": "rustre_threatintel::ThreatIndicatorDatabase::is_empty",
            })
            .to_string(),
        ))
    }
}

/// Insert an IOC then retrieve it by its returned IocId.
pub struct ThreatintelIndicatorGetByIdTool;

impl ThreatintelIndicatorGetByIdTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_indicator_get_by_id".to_string(),
            description:
                "Insert one SHA-256 IOC into a fresh ThreatIndicatorDatabase and \
                 fetch it via ThreatIndicatorDatabase::get(IocId)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "value": { "type": "string" },
                    "threat_name": { "type": "string" }
                },
                "required": ["value"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelIndicatorGetByIdTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args
            .get("value")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let threat_name = args
            .get("threat_name")
            .and_then(Value::as_str)
            .unwrap_or("unknown");
        let mut db = rustre_threatintel::ThreatIndicatorDatabase::new();
        let id = db.add_ioc(rustre_threatintel::ThreatIoc::new(
            rustre_threatintel::IocType::Sha256,
            value,
            threat_name,
            0.9,
            "wire-tool",
        ));
        let fetched = db.get(id);
        Ok(ToolResult::text(
            json!({
                "ioc_id": id.0,
                "found": fetched.is_some(),
                "value": fetched.map(|i| i.value.clone()),
                "threat_name": fetched.map(|i| i.threat_name.clone()),
                "source": "rustre_threatintel::ThreatIndicatorDatabase::get",
            })
            .to_string(),
        ))
    }
}

