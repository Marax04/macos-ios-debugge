/// Return the mnemonic for a Lua opcode byte at a given Lua version.
pub struct LoaderLuaOpcodeNameTool;

impl LoaderLuaOpcodeNameTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_lua_opcode_name".to_string(),
            description: "Return the opcode mnemonic for a given Lua version byte (0x51..0x54) and opcode.".to_string(),
            input_schema: json!({
