pub struct NetRulesFindBytesNocaseTool;

impl NetRulesFindBytesNocaseTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_rules_find_bytes_nocase".to_string(),
            description:
                "Case-insensitive byte-pattern search via rustre_net_rules::find_bytes_nocase."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["haystack", "needle"],
                "properties": {
                    "haystack":     { "type": "array", "items": { "type": "integer" } },
                    "haystack_hex": { "type": "string" },
                    "needle":       { "type": "array", "items": { "type": "integer" } },
                    "needle_hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetRulesFindBytesNocaseTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let haystack = extract_byte_array(&args, "haystack", "haystack_hex")?;
        let needle = extract_byte_array(&args, "needle", "needle_hex")?;
        let pos = rustre_net_rules::find_bytes_nocase(&haystack, &needle);
        Ok(ToolResult::text(
            json!({
                "position": pos,
                "haystack_hex": hex_encode(&haystack),
                "needle_hex": hex_encode(&needle),
                "source": "rustre_net_rules::find_bytes_nocase",
            })
            .to_string(),
        ))
    }
}

