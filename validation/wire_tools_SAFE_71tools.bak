            description: "SpecSymExpr::Add(a,b) eval/is_concrete/width.".to_string(),
            input_schema: json!({"type":"object","required":["a","b"],"properties":{"a":{"type":"integer"},"b":{"type":"integer"}}}),
            parameters: Value::Null,
