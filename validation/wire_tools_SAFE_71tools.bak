// ── rustre-diff additional wrappers ────────────────────────────────────────
fn __rd_fp_from_args(args: &Value, key: &str) -> rustre_diff::FuncFingerprint {
    let bytes = args.get(key).and_then(Value::as_str)
        .map(|s| (0..s.len()).step_by(2).filter_map(|i| s.get(i..i+2).and_then(|c| u8::from_str_radix(c, 16).ok())).collect::<Vec<u8>>())
        .unwrap_or_default();
    let addr = args.get(&format!("{key}_addr")).and_then(Value::as_u64).unwrap_or(0);
    let name = args.get(&format!("{key}_name")).and_then(Value::as_str).unwrap_or("f").to_string();
    rustre_diff::FuncFingerprint::new(addr, name, bytes)
}

