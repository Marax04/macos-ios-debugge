// ── rustre-yara: extra wrappers ─────────────────────────────────────────────
fn _yara_hex(s: &str) -> Vec<u8> { let s: String = s.chars().filter(|c| !c.is_whitespace()).collect(); (0..s.len()).step_by(2).filter_map(|i| u8::from_str_radix(s.get(i..i+2)?, 16).ok()).collect() }

