// --- rustre-analysis-callconv round: extra CC wrappers ---

macro_rules! callconv_name_wrapper {
    ($tool:ident, $tool_name:literal, $func:ident, $desc:literal) => {
        pub struct $tool;
        impl $tool {
            #[must_use]
            pub fn definition() -> ToolDefinition {
                ToolDefinition {
                    name: $tool_name.to_string(),
                    description: $desc.to_string(),
                    input_schema: json!({ "type": "object", "properties": {} }),
                    parameters: json!({ "type": "object", "properties": {} }),
                }
            }
        }
        #[async_trait]
        impl ToolHandler for $tool {
            async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
                let cc = rustre_analysis_callconv::$func();
                Ok(ToolResult::text(json!({
                    "name": cc.name,
                    "max_reg_args": cc.max_reg_args,
                    "stack_alignment": cc.stack_alignment,
                    "caller_cleanup": cc.caller_cleanup,
                    "shadow_space_bytes": cc.shadow_space_bytes,
                    "source": concat!("rustre_analysis_callconv::", stringify!($func)),
                }).to_string()))
            }
        }
    };
}

callconv_name_wrapper!(CallconvCdeclX86NameV2Tool, "callconv_cdecl_x86_name_v2", cdecl_x86,
    "Return the cdecl (x86) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvStdcallX86NameV2Tool, "callconv_stdcall_x86_name_v2", stdcall_x86,
    "Return the stdcall (x86) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvFastcallX86NameV2Tool, "callconv_fastcall_x86_name_v2", fastcall_x86,
    "Return the fastcall (x86) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvThiscallX86NameV2Tool, "callconv_thiscall_x86_name_v2", thiscall_x86,
    "Return the thiscall (x86) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvVectorcallX64NameV2Tool, "callconv_vectorcall_x64_name_v2", vectorcall_x64,
    "Return the vectorcall (x64) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvAapcs32NameV2Tool, "callconv_aapcs32_name_v2", aapcs32,
    "Return the AAPCS32 (Arm32) calling convention pattern metadata.");
callconv_name_wrapper!(CallconvMipsO32NameV2Tool, "callconv_mips_o32_name_v2", mips_o32,
    "Return the MIPS O32 calling convention pattern metadata.");
callconv_name_wrapper!(CallconvRiscv64Lp64dNameV2Tool, "callconv_riscv64_lp64d_name_v2", riscv64_lp64d,
    "Return the RISC-V LP64D calling convention pattern metadata.");

pub struct CallconvSysvX64IsArgRegisterTool;
impl CallconvSysvX64IsArgRegisterTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "callconv_sysv_x64_is_arg_register".to_string(),
            description: "Check whether a register name is an integer/fp arg register in SysV x64.".to_string(),
            input_schema: json!({ "type": "object", "properties": { "reg": {"type":"string"} }, "required":["reg"] }),
            parameters: Value::Null,
        }
    }
}
#[async_trait]
impl ToolHandler for CallconvSysvX64IsArgRegisterTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let reg = args.get("reg").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'reg'".into()))?;
        let cc = rustre_analysis_callconv::sysv_x64();
        Ok(ToolResult::text(json!({
            "reg": reg,
            "is_arg_register": cc.is_arg_register(reg),
            "source": "rustre_analysis_callconv::CallingConventionPattern::is_arg_register",
        }).to_string()))
    }
}

pub struct CallconvMsvcX64IsCalleeSavedTool;
impl CallconvMsvcX64IsCalleeSavedTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "callconv_msvc_x64_is_callee_saved".to_string(),
            description: "Check whether a register is callee-saved under the Microsoft x64 ABI.".to_string(),
            input_schema: json!({ "type": "object", "properties": { "reg": {"type":"string"} }, "required":["reg"] }),
            parameters: Value::Null,
        }
    }
}
#[async_trait]
impl ToolHandler for CallconvMsvcX64IsCalleeSavedTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let reg = args.get("reg").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'reg'".into()))?;
        let cc = rustre_analysis_callconv::msvc_x64();
        Ok(ToolResult::text(json!({
            "reg": reg,
            "is_callee_saved": cc.is_callee_saved(reg),
            "source": "rustre_analysis_callconv::CallingConventionPattern::is_callee_saved",
        }).to_string()))
    }
}

