pub struct DotnetEditRecomputeOffsetsTool;

impl DotnetEditRecomputeOffsetsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_edit_recompute_offsets".to_string(),
            description: "Recompute sequential CIL instruction offsets given a list \
                          of opcode mnemonics (each treated as a simple no-operand \
                          instruction) via rustre_dotnet_edit::recompute_offsets."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "opcodes": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Ordered list of CIL opcode mnemonics"
                    }
                },
                "required": ["opcodes"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetEditRecomputeOffsetsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arr = args.get("opcodes").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'opcodes'".into()))?;
        let mut instrs: Vec<rustre_dotnet::CilInstruction> = arr
            .iter()
            .filter_map(|v| v.as_str())
            .map(|op| rustre_dotnet::CilInstruction::simple(0, op))
            .collect();
        rustre_dotnet_edit::recompute_offsets(&mut instrs);
        let offsets: Vec<u32> = instrs.iter().map(|i| i.offset).collect();
        Ok(ToolResult::text(
            json!({
                "count": offsets.len(),
                "offsets": offsets,
                "source": "rustre_dotnet_edit::recompute_offsets",
            })
            .to_string(),
        ))
    }
}

pub struct DotnetEditRenumberOffsetsTool;

impl DotnetEditRenumberOffsetsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_edit_renumber_offsets".to_string(),
            description: "Renumber CIL instruction offsets sequentially given a list \
                          of opcode mnemonics via rustre_dotnet_edit::renumber_offsets."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "opcodes": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Ordered list of CIL opcode mnemonics"
                    }
                },
                "required": ["opcodes"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetEditRenumberOffsetsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arr = args.get("opcodes").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'opcodes'".into()))?;
        let mut instrs: Vec<rustre_dotnet::CilInstruction> = arr
            .iter()
            .filter_map(|v| v.as_str())
            .enumerate()
            .map(|(i, op)| rustre_dotnet::CilInstruction::simple(i as u32 * 10, op))
            .collect();
        rustre_dotnet_edit::renumber_offsets(&mut instrs);
        let offsets: Vec<u32> = instrs.iter().map(|i| i.offset).collect();
        Ok(ToolResult::text(
            json!({
                "count": offsets.len(),
                "offsets": offsets,
                "source": "rustre_dotnet_edit::renumber_offsets",
            })
            .to_string(),
        ))
    }
}

