#[async_trait] impl ToolHandler for DtZ1CtypeEmitFunctionTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let name = args.get("name").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?.to_string(); use rustre_decompiler_type::{FunctionType, DecompType, CTypeEmitter}; use rustre_decompiler_expr::IntWidth; let mut f = FunctionType::new(name, DecompType::Int(IntWidth::I32)); f.add_param("x", DecompType::Int(IntWidth::I32)); let em = CTypeEmitter::new(); Ok(ToolResult::text(json!({"code": em.emit_function(&f), "source":"rustre_decompiler_type::CTypeEmitter::emit_function"}).to_string())) } }

pub struct DtZ1UnifierSameClassTool;
impl DtZ1UnifierSameClassTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "decompiler_type_unifier_same_class_z1".to_string(), description: "TypeUnifier: add constraint then check same_class(a,b).".to_string(), input_schema: json!({"type":"object","properties":{"a":{"type":"string"},"b":{"type":"string"}},"required":["a","b"]}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for DtZ1UnifierSameClassTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let a = args.get("a").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'a'".into()))?.to_string(); let b = args.get("b").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'b'".into()))?.to_string(); let mut s = rustre_decompiler_type::ConstraintSolver::new(); s.add(rustre_decompiler_type::Constraint::Equal(a.clone(), b.clone())); let _ = s.solve(); let same = s.same_class(&a, &b); Ok(ToolResult::text(json!({"a": a, "b": b, "same_class": same, "conflicts": s.conflicts().len(), "source":"rustre_decompiler_type::ConstraintSolver::same_class"}).to_string())) } }

pub struct DtZ1InferencePointerDerefTool;
impl DtZ1InferencePointerDerefTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "decompiler_type_inference_pointer_deref_z1".to_string(), description: "TypeInference: set_type on ptr, then infer_pointer_deref; returns result c_name.".to_string(), input_schema: json!({"type":"object","properties":{"ptr":{"type":"string"},"result":{"type":"string"},"width":{"type":"string"}},"required":["ptr","result","width"]}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for DtZ1InferencePointerDerefTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let ptr = args.get("ptr").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'ptr'".into()))?.to_string(); let result = args.get("result").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'result'".into()))?.to_string(); let w = __decomp_parse_int_width(args.get("width").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'width'".into()))?).ok_or_else(|| McpError::InvalidParams("bad width".into()))?; use rustre_decompiler_type::{DecompType, TypeInference}; let mut ti = TypeInference::new(); ti.set_type(ptr.clone(), DecompType::Ptr(Box::new(DecompType::Int(w)))); ti.infer_pointer_deref(&ptr, &result); let got = ti.get_type(&result).map(|t| t.c_name()); Ok(ToolResult::text(json!({"ptr": ptr, "result": result, "c_name": got, "type_count": ti.type_count(), "source":"rustre_decompiler_type::TypeInference::infer_pointer_deref"}).to_string())) } }

pub struct DtZ1PropagatorBinopTool;
impl DtZ1PropagatorBinopTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "decompiler_type_propagator_binop_z1".to_string(), description: "TypePropagator: seed(lhs) then propagate_through_binop(result, lhs, rhs); returns result c_name.".to_string(), input_schema: json!({"type":"object","properties":{"lhs":{"type":"string"},"rhs":{"type":"string"},"result":{"type":"string"},"width":{"type":"string"}},"required":["lhs","rhs","result","width"]}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for DtZ1PropagatorBinopTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let lhs = args.get("lhs").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'lhs'".into()))?.to_string(); let rhs = args.get("rhs").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'rhs'".into()))?.to_string(); let result = args.get("result").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'result'".into()))?.to_string(); let w = __decomp_parse_int_width(args.get("width").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'width'".into()))?).ok_or_else(|| McpError::InvalidParams("bad width".into()))?; use rustre_decompiler_type::{DecompType, TypePropagator}; let mut tp = TypePropagator::new(); tp.seed(lhs.clone(), DecompType::Int(w)); tp.propagate_through_binop(&result, &lhs, &rhs); let got = tp.get(&result).map(|t| t.c_name()); Ok(ToolResult::text(json!({"result": result, "c_name": got, "source":"rustre_decompiler_type::TypePropagator::propagate_through_binop"}).to_string())) } }

