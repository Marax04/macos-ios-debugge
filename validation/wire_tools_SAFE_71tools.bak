    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_edit_new_method_encode_sig_wire".to_string(),
            description: "Build a NewMethodDescriptor::static_void with given 'name' and return \
                          its encode_sig() bytes as hex (wire variant)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
