#[async_trait]
impl ToolHandler for ThreatintelThreatIocNewTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args.get("value").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".into()))?;
        let threat_name = args.get("threat_name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'threat_name'".into()))?;
        let confidence = args.get("confidence").and_then(Value::as_f64)
            .ok_or_else(|| McpError::InvalidParams("missing 'confidence'".into()))?;
        let source = args.get("source").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'source'".into()))?;
        #[allow(clippy::cast_possible_truncation)]
        let ioc = rustre_threatintel::ThreatIoc::new(
            rustre_threatintel::IocType::Sha256,
            value,
            threat_name,
            confidence as f32,
            source,
        );
        Ok(ToolResult::text(
            json!({
                "ioc_type":    ioc.ioc_type.to_string(),
                "value":       ioc.value,
                "threat_name": ioc.threat_name,
                "confidence":  ioc.confidence,
                "source":      ioc.source,
                "source_fn":   "rustre_threatintel::ThreatIoc::new",
            })
            .to_string(),
        ))
    }
}

/// Insert an IOC into a fresh `ThreatIndicatorDatabase` and look it up.
pub struct ThreatintelIndicatorDbLookupTool;

impl ThreatintelIndicatorDbLookupTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_indicator_db_lookup".to_string(),
            description:
                "Add a SHA-256 IOC to a fresh rustre_threatintel::ThreatIndicatorDatabase \
                 and return the number of matching records for the given value."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "value":       { "type": "string" },
                    "threat_name": { "type": "string" }
                },
                "required": ["value", "threat_name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelIndicatorDbLookupTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args.get("value").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".into()))?;
        let threat_name = args.get("threat_name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'threat_name'".into()))?;
        let mut db = rustre_threatintel::ThreatIndicatorDatabase::new();
        db.add_ioc(rustre_threatintel::ThreatIoc::new(
            rustre_threatintel::IocType::Sha256,
            value,
            threat_name,
            1.0,
            "wire",
        ));
        let hits = db.lookup(value).len();
        Ok(ToolResult::text(
            json!({
                "len":       db.len(),
                "hits":      hits,
                "source_fn": "rustre_threatintel::ThreatIndicatorDatabase::lookup",
            })
            .to_string(),
        ))
    }
}

