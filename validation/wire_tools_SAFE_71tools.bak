/// Estimate the risk level of a syscall by name+category.
pub struct SyscallsEstimateRiskTool;

impl SyscallsEstimateRiskTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "syscalls_estimate_risk".to_string(),
            description: "Estimate risk level of a syscall via rustre_syscalls::estimate_risk".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SyscallsEstimateRiskTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let cat = rustre_syscalls::categorize_by_name(name);
        let risk = rustre_syscalls::estimate_risk(name, cat);
        Ok(ToolResult::text(
            json!({
                "name": name,
                "category": cat.to_string(),
                "risk": risk.to_string(),
                "source": "rustre_syscalls::estimate_risk",
            })
            .to_string(),
        ))
    }
}

