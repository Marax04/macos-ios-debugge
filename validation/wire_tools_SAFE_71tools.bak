// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-trace: coverage_percent / merge_sessions Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Compute coverage percentage given hit / total counts.
pub struct TraceCoveragePercentTool;

impl TraceCoveragePercentTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_coverage_percent".to_string(),
            description:
                "Compute coverage percentage using rustre_trace::coverage_percent(hit, total)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hit":   { "type": "integer" },
                    "total": { "type": "integer" }
                },
                "required": ["hit", "total"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceCoveragePercentTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hit = args
            .get("hit")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'hit'".into()))?
            as usize;
        let total = args
            .get("total")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'total'".into()))?
            as usize;
        let pct = rustre_trace::coverage_percent(hit, total);
        Ok(ToolResult::text(
            json!({
                "hit": hit,
                "total": total,
                "coverage_percent": pct,
                "source": "rustre_trace::coverage_percent",
            })
            .to_string(),
        ))
    }
}

/// Merge N empty trace sessions and report the resulting record count.
pub struct TraceMergeEmptySessionsTool;

impl TraceMergeEmptySessionsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_merge_empty_sessions".to_string(),
            description:
                "Merge N empty TraceSessions (same arch) via rustre_trace::merge_sessions \
                 and return the merged record count. Useful as a smoke-test entry point."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "count": { "type": "integer" },
                    "arch":  { "type": "string" }
                },
                "required": ["count"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceMergeEmptySessionsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let count = args
            .get("count")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'count'".into()))?
            as usize;
        let arch = args
            .get("arch")
            .and_then(Value::as_str)
            .unwrap_or("x86_64");
        let sessions: Vec<rustre_trace::TraceSession> = (0..count)
            .map(|i| rustre_trace::TraceSession::new(format!("s{i}"), arch))
            .collect();
        let merged = rustre_trace::merge_sessions(&sessions)
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "input_sessions": count,
                "arch": arch,
                "merged_records": merged.records.len(),
                "merged_name": merged.name,
                "source": "rustre_trace::merge_sessions",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-trace-navigate Ã¢â‚¬â€ bytes_to_u64 Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

