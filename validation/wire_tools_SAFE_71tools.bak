/// Look up a built-in type record by (case-insensitive) name.
pub struct AnalysisTypeLookupBuiltinTypeTool;

impl AnalysisTypeLookupBuiltinTypeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_type_lookup_builtin_type".to_string(),
            description: "Look up a built-in type by case-insensitive exact match via \
                          rustre_analysis_type::lookup_builtin_type.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisTypeLookupBuiltinTypeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let record = rustre_analysis_type::lookup_builtin_type(name);
        let found = record.is_some();
        let payload = serde_json::to_value(&record)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(json!({ "name": name, "found": found, "record": payload }).to_string()))
    }
}

