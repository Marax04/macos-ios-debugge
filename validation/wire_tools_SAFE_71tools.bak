/// Discover the PDB file matching a PE binary on disk.
pub struct SymbolsDiscoverPdbForBinaryTool;

impl SymbolsDiscoverPdbForBinaryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_discover_pdb_for_binary".to_string(),
            description:
                "Locate a matching .pdb next to a PE binary (sibling <stem>.pdb, \
                 sibling pdb/ directory, or the CodeView-embedded PDB path). \
                 Delegates to rustre_symbols::discover_pdb_for_binary."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the PE binary" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsDiscoverPdbForBinaryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let found = rustre_symbols::discover_pdb_for_binary(std::path::Path::new(path), None);
        Ok(ToolResult::text(
            json!({
                "path": path,
                "pdb_path": found.as_ref().map(|p| p.to_string_lossy().to_string()),
                "found": found.is_some(),
                "source": "rustre_symbols::discover_pdb_for_binary",
            })
            .to_string(),
        ))
    }
}

/// List every wired symbol-backend sub-crate registered in `rustre_symbols::backends::registry`.
pub struct SymbolsBackendsRegistryTool;

impl SymbolsBackendsRegistryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_backends_registry".to_string(),
            description:
                "Enumerate every wired symbol-backend sub-crate \
                 (CodeView / DWARF / PDB / STABS) via \
                 rustre_symbols::backends::registry()."
                    .to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsBackendsRegistryTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let backends = rustre_symbols::backends::registry();
        let entries: Vec<Value> = backends
            .iter()
            .map(|b| {
                json!({
                    "crate_name":    b.crate_name,
                    "format":        b.format,
                    "provider_type": b.provider_type,
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "count":    entries.len(),
                "backends": entries,
                "source":   "rustre_symbols::backends::registry",
            })
            .to_string(),
        ))
    }
}

