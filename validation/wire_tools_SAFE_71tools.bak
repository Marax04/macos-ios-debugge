/// Jaccard similarity over matched basic blocks via `jaccard_bb_score`.
pub struct DiffBindiffJaccardBbScoreTool;

impl DiffBindiffJaccardBbScoreTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_bindiff_jaccard_bb_score".to_string(),
            description:
                "Jaccard basic-block similarity: matched / (blocks_a + blocks_b - matched), via rustre_diff_bindiff::jaccard_bb_score."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "matched":  { "type": "integer" },
                    "blocks_a": { "type": "integer" },
                    "blocks_b": { "type": "integer" }
                },
                "required": ["matched", "blocks_a", "blocks_b"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffBindiffJaccardBbScoreTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let get_u32 = |k: &str| -> Result<u32, McpError> {
            let n = args
                .get(k)
                .and_then(Value::as_u64)
                .ok_or_else(|| McpError::InvalidParams(format!("missing '{k}'")))?;
            u32::try_from(n).map_err(|_| McpError::InvalidParams(format!("'{k}' out of u32 range")))
        };
        let matched = get_u32("matched")?;
        let blocks_a = get_u32("blocks_a")?;
        let blocks_b = get_u32("blocks_b")?;
        let score = rustre_diff_bindiff::jaccard_bb_score(matched, blocks_a, blocks_b);
        Ok(ToolResult::text(
            json!({
                "score": score,
                "matched": matched,
                "blocks_a": blocks_a,
                "blocks_b": blocks_b,
                "source": "rustre_diff_bindiff::jaccard_bb_score",
            })
            .to_string(),
        ))
    }
}

