/// Compute a MinHash signature over a set of u64 elements.
pub struct DiffSemanticMinhashSignatureTool;

impl DiffSemanticMinhashSignatureTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_semantic_minhash_signature".to_string(),
            description: "Compute a MinHash signature (Vec<u64>) over the given u64 elements using `num_hashes` hash functions.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["num_hashes", "elements"],
                "properties": {
                    "num_hashes": { "type": "integer", "description": "Number of MinHash functions" },
                    "elements": { "type": "array", "items": { "type": "integer" }, "description": "Input u64 elements" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffSemanticMinhashSignatureTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let num_hashes = args.get("num_hashes").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'num_hashes'".into()))? as usize;
        let elements: Vec<u64> = args.get("elements").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'elements'".into()))?
            .iter().filter_map(Value::as_u64).collect();
        let mh = rustre_diff_semantic::MinHash::new(num_hashes);
        let sig = mh.signature(&elements);
        Ok(ToolResult::text(json!({ "num_hashes": num_hashes, "signature": sig }).to_string()))
    }
}

/// Estimate Jaccard similarity from two MinHash signatures.
pub struct DiffSemanticMinhashEstimateJaccardTool;

impl DiffSemanticMinhashEstimateJaccardTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_semantic_minhash_estimate_jaccard".to_string(),
            description: "Estimate the Jaccard similarity between two MinHash signatures (equal length required).".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["sig_a", "sig_b"],
                "properties": {
                    "sig_a": { "type": "array", "items": { "type": "integer" } },
                    "sig_b": { "type": "array", "items": { "type": "integer" } }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffSemanticMinhashEstimateJaccardTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let sig_a: Vec<u64> = args.get("sig_a").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'sig_a'".into()))?
            .iter().filter_map(Value::as_u64).collect();
        let sig_b: Vec<u64> = args.get("sig_b").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'sig_b'".into()))?
            .iter().filter_map(Value::as_u64).collect();
        let est = rustre_diff_semantic::MinHash::estimate_jaccard(&sig_a, &sig_b);
        Ok(ToolResult::text(json!({ "estimated_jaccard": est }).to_string()))
    }
}

/// Compute a SemanticSignature summary from raw function bytes.
pub struct DiffSemanticSignatureComputeTool;

impl DiffSemanticSignatureComputeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_semantic_signature_compute".to_string(),
            description: "Compute a SemanticSignature over raw function bytes at `base_addr`. Provide bytes as 'hex' (hex string) or 'bytes' (array). Returns summary counts and cfg hash.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["base_addr"],
                "properties": {
                    "hex": { "type": "string", "description": "Function bytes as hex string" },
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "base_addr": { "type": "integer", "description": "Base virtual address" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffSemanticSignatureComputeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let bytes = args_to_bytes(&args)?;
        let base_addr = args.get("base_addr").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'base_addr'".into()))?;
        let sig = rustre_diff_semantic::SemanticSignature::compute(&bytes, base_addr);
        Ok(ToolResult::text(json!({
            "function_addr": sig.function_addr,
            "instruction_count": sig.instruction_count,
            "call_count": sig.call_count,
            "unique_constants_len": sig.unique_constants.len(),
            "string_refs_len": sig.string_refs.len(),
            "cfg_hash": sig.cfg_hash,
            "mnemonic_histogram_size": sig.mnemonic_histogram.len(),
        }).to_string()))
    }
}

