/// Search known threat groups by name or alias (case-insensitive).
pub struct ThreatintelGroupSearchTool;

impl ThreatintelGroupSearchTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_group_search".to_string(),
            description:
                "Search the built-in ThreatGroupTracker registry by name or alias \
                 (case-insensitive) and return matching group names."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "query": { "type": "string" } },
                "required": ["query"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelGroupSearchTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let query = args
            .get("query")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'query'".to_string()))?;
        let tracker = rustre_threatintel::ThreatGroupTracker::new();
        let matches: Vec<String> = tracker
            .search(query)
            .into_iter()
            .map(|g| g.name.clone())
            .collect();
        Ok(ToolResult::text(
            json!({
                "query": query,
                "matches": matches,
                "source": "rustre_threatintel::ThreatGroupTracker::search",
            })
            .to_string(),
        ))
    }
}

