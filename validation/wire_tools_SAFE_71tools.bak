/// Wrap `rustre_flirt_gen::PatternGenerator::generate_pattern_with_quality`.
pub struct FlirtGenPatternWithQualityTool;

impl FlirtGenPatternWithQualityTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_gen_pattern_with_quality".to_string(),
            description:
                "Generate a FLIRT pattern from a hex byte stream and report \
                 wildcard-density quality telemetry via \
                 rustre_flirt_gen::PatternGenerator::generate_pattern_with_quality."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex":  { "type": "string" },
                    "name": { "type": "string" }
                },
                "required": ["hex", "name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtGenPatternWithQualityTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex_str = args
            .get("hex")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let name = args
            .get("name")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let cleaned: String = hex_str.chars().filter(|c| !c.is_whitespace()).collect();
        if cleaned.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex must have even length".into()));
        }
        let mut bytes = Vec::with_capacity(cleaned.len() / 2);
        let cb = cleaned.as_bytes();
        for i in (0..cb.len()).step_by(2) {
            let s = std::str::from_utf8(&cb[i..i + 2])
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            let b = u8::from_str_radix(s, 16)
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            bytes.push(b);
        }
        let generator = rustre_flirt_gen::PatternGenerator::new();
        let pwq = generator
            .generate_pattern_with_quality(&bytes, name)
            .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "masked_bytes": pwq.masked_bytes,
                "total_bytes":  pwq.total_bytes,
                "mask_ratio":   pwq.mask_ratio,
                "quality":      pwq.quality.as_str(),
                "source": "rustre_flirt_gen::PatternGenerator::generate_pattern_with_quality",
            })
            .to_string(),
        ))
    }
}

/// Wrap `rustre_flirt_gen::LibraryBuilder` end-to-end.
pub struct FlirtGenLibraryBuilderDemoTool;

impl FlirtGenLibraryBuilderDemoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_gen_library_builder_demo".to_string(),
            description:
                "Construct a rustre_flirt_gen::LibraryBuilder, add one function \
                 from `hex`, dedup, build and report GenerationStats."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex":  { "type": "string" },
                    "name": { "type": "string" },
                    "lib":  { "type": "string" }
                },
                "required": ["hex", "name", "lib"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtGenLibraryBuilderDemoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex_str = args
            .get("hex")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let name = args
            .get("name")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let lib = args
            .get("lib")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'lib'".into()))?;
        let cleaned: String = hex_str.chars().filter(|c| !c.is_whitespace()).collect();
        if cleaned.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex must have even length".into()));
        }
        let mut bytes = Vec::with_capacity(cleaned.len() / 2);
        let cb = cleaned.as_bytes();
        for i in (0..cb.len()).step_by(2) {
            let s = std::str::from_utf8(&cb[i..i + 2])
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            let b = u8::from_str_radix(s, 16)
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            bytes.push(b);
        }
        let mut builder = rustre_flirt_gen::LibraryBuilder::new(
            lib.to_string(),
            rustre_flirt::FlirtArch::X64,
            rustre_flirt::FlirtOs::Windows,
        );
        builder.add_function(name.to_string(), &bytes, Vec::new());
        builder.dedup_patterns();
        let (library, stats) = builder.build();
        Ok(ToolResult::text(
            json!({
                "functions_processed": stats.functions_processed,
                "patterns_generated":  stats.patterns_generated,
                "patterns_skipped":    stats.patterns_skipped,
                "duplicates_removed":  stats.duplicates_removed,
                "library_pattern_count": library.patterns.len(),
                "source": "rustre_flirt_gen::LibraryBuilder",
            })
            .to_string(),
        ))
    }
}

