/// Decide whether a Java method name is a constructor via `JavaMethod::is_constructor`.
pub struct MobileJadxJavaMethodIsConstructorTool;

impl MobileJadxJavaMethodIsConstructorTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mobile_jadx_java_method_is_constructor".to_string(),
            description:
                "Return whether a JavaMethod name would be classified as a constructor by \
                 rustre_mobile_jadx::JavaMethod::is_constructor."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "name": { "type": "string", "description": "method name" }
                },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MobileJadxJavaMethodIsConstructorTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let m = rustre_mobile_jadx::JavaMethod {
            name: name.to_string(),
            signature: format!("{name}()"),
            return_type: "void".to_string(),
            params: vec![],
            body: String::new(),
            is_static: false,
            is_native: false,
        };
        Ok(ToolResult::text(
            json!({
                "name":            name,
                "is_constructor": m.is_constructor(),
                "source":          "rustre_mobile_jadx::JavaMethod::is_constructor",
            })
            .to_string(),
        ))
    }
}

