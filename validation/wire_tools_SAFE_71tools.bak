struct SparcSynthSetWireTool;
impl SparcSynthSetWireTool {
    fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "sparc_synth_set".to_string(),
            description: "Synthesize SPARC set (1 or 2 words).".to_string(),
            input_schema: json!({"type":"object","properties":{"val":{"type":"integer"},"rd":{"type":"integer"}},"required":["val","rd"]}),
            parameters: Value::Null,
        }
    }
}
#[async_trait]
impl ToolHandler for SparcSynthSetWireTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let val = sparc_arg_u32(&args, "val")?;
        let rd = sparc_arg_u32(&args, "rd")?;
        let words = rustre_arch_sparc::synth_set(val, rd);
        let hexes: Vec<String> = words.iter().map(|w| format!("{:08X}", w)).collect();
        Ok(ToolResult::text(json!({
            "count": words.len(),
            "words": words,
            "hex": hexes,
            "source": "rustre_arch_sparc::synth_set",
        }).to_string()))
    }
}

