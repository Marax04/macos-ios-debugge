#[async_trait]
impl ToolHandler for NetRulesDiffRulesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let old_val = args
            .get("old")
            .ok_or_else(|| McpError::InvalidParams("missing 'old'".into()))?;
        let new_val = args
            .get("new")
            .ok_or_else(|| McpError::InvalidParams("missing 'new'".into()))?;
        let old_rules: Vec<rustre_net_rules::Rule> = serde_json::from_value(old_val.clone())
            .map_err(|e| McpError::InvalidParams(format!("old decode: {e}")))?;
        let new_rules: Vec<rustre_net_rules::Rule> = serde_json::from_value(new_val.clone())
            .map_err(|e| McpError::InvalidParams(format!("new decode: {e}")))?;
        let diffs = rustre_net_rules::diff_rules(&old_rules, &new_rules);
        let val = serde_json::to_value(&diffs)
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "diffs": val,
                "count": diffs.len(),
                "source": "rustre_net_rules::diff_rules",
            })
            .to_string(),
        ))
    }
}

