pub struct NetProxyInjectXffHeadersTool;

impl NetProxyInjectXffHeadersTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_proxy_inject_xff_headers".to_string(),
            description: "Inject X-Forwarded-For and X-Forwarded-Host headers into a raw HTTP request buffer.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "client_ip":  { "type": "string" },
                    "proxy_host": { "type": "string" }
                },
                "required": ["client_ip", "proxy_host"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetProxyInjectXffHeadersTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mut data = args_to_bytes(&args)?;
        let client_ip = args
            .get("client_ip")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'client_ip'".into()))?;
        let proxy_host = args
            .get("proxy_host")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'proxy_host'".into()))?;
        let injected = rustre_net_proxy::inject_xff_headers(&mut data, client_ip, proxy_host);
        Ok(ToolResult::text(
            json!({
                "injected": injected,
                "output_hex": hex_encode(&data),
                "output_len": data.len(),
                "source": "rustre_net_proxy::inject_xff_headers",
            })
            .to_string(),
        ))
    }
}

