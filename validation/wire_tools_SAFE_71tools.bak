            name: "arch_jvm_decode".to_string(),
            description: "Decode one JVM bytecode instruction from bytes via \
                          rustre_arch_jvm::JvmInstr::decode."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
