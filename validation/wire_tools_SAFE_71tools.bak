                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderElfGnuHashBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let h = rustre_loader_elf::gnu_hash(&data);
        Ok(ToolResult::text(
            json!({
                "gnu_hash": h,
