// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-adb: filter_by_level / filter_by_tag / group_by_tag wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

fn parse_log_level(s: &str) -> Option<rustre_adb::LogLevel> {
    match s.to_ascii_lowercase().as_str() {
        "v" | "verbose" => Some(rustre_adb::LogLevel::Verbose),
        "d" | "debug" => Some(rustre_adb::LogLevel::Debug),
        "i" | "info" => Some(rustre_adb::LogLevel::Info),
        "w" | "warning" | "warn" => Some(rustre_adb::LogLevel::Warning),
        "e" | "error" => Some(rustre_adb::LogLevel::Error),
        "f" | "fatal" => Some(rustre_adb::LogLevel::Fatal),
        "s" | "silent" => Some(rustre_adb::LogLevel::Silent),
        _ => None,
    }
}

pub struct AdbFilterByLevelTool;

impl AdbFilterByLevelTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_filter_by_level".to_string(),
            description: "Parse logcat output and keep only entries at or above the given minimum level (V/D/I/W/E/F/S).".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["output", "min_level"],
                "properties": {
                    "output": { "type": "string", "description": "Raw logcat output text" },
                    "min_level": { "type": "string", "description": "Minimum level: V,D,I,W,E,F,S (or full name)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbFilterByLevelTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args.get("output").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".into()))?;
        let level_s = args.get("min_level").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'min_level'".into()))?;
        let min_level = parse_log_level(level_s)
            .ok_or_else(|| McpError::InvalidParams(format!("bad level: {level_s}")))?;
        let entries = rustre_adb::parse_logcat_output(output);
        let filtered: Vec<&rustre_adb::LogEntry> = rustre_adb::filter_by_level(&entries, &min_level);
        Ok(ToolResult::text(
            json!({ "count": filtered.len(), "entries": filtered }).to_string(),
        ))
    }
}

pub struct AdbFilterByTagTool;

impl AdbFilterByTagTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
