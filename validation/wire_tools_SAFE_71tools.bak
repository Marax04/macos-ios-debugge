pub struct DebugFridaV2ManagerLifecycleTool;
impl DebugFridaV2ManagerLifecycleTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_frida_v2_manager_lifecycle".to_string(),
            description: "Exercise FridaManager: attach two sessions, add an interceptor, generate stalker events.".to_string(),
            input_schema: json!({"type":"object","properties":{"pid_a":{"type":"integer"},"pid_b":{"type":"integer"},"events":{"type":"integer"}}}),
            parameters: Value::Null,
        }
    }
}
#[async_trait]
impl ToolHandler for DebugFridaV2ManagerLifecycleTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_debug_frida::v2::{FridaManager, FridaTarget, InterceptorRule};
        let pid_a = args.get("pid_a").and_then(Value::as_u64).unwrap_or(1) as u32;
        let pid_b = args.get("pid_b").and_then(Value::as_u64).unwrap_or(2) as u32;
        let events = args.get("events").and_then(Value::as_u64).unwrap_or(6) as usize;
        let m = FridaManager::new();
        let s_a = m.attach(FridaTarget::local_pid(pid_a)).map_err(|e| McpError::InternalError(e.to_string()))?;
        let s_b = m.attach(FridaTarget::local_pid(pid_b)).map_err(|e| McpError::InternalError(e.to_string()))?;
        m.add_interceptor(InterceptorRule { address: 0x1000, on_enter: Some("e".into()), on_leave: None, id: 1 });
        let evs = m.mock_stalker_events(events);
        let sessions_before = m.session_count();
        m.detach(s_a.id).map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(json!({
            "session_a_id": s_a.id,
            "session_b_id": s_b.id,
            "session_a_attached_initially": s_a.is_attached(),
            "session_b_attached_initially": s_b.is_attached(),
            "interceptor_count": m.interceptor_count(),
            "sessions_before_detach": sessions_before,
            "sessions_after_detach": m.session_count(),
            "stalker_event_count": evs.len(),
            "first_event": evs.first().map(|e| e.to_string()),
            "source": "rustre_debug_frida::v2::FridaManager",
        }).to_string()))
    }
}

