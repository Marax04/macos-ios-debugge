#[async_trait] impl ToolHandler for MemKx7DiffBytesFirstLenTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let a = __mem_hex_decode_v2(args.get("a_hex").and_then(Value::as_str).unwrap_or("")); let b = __mem_hex_decode_v2(args.get("b_hex").and_then(Value::as_str).unwrap_or("")); let s = rustre_mem::diff::diff_bytes(__mem_kx7_addr(0), &a, &b); let first = s.first().map_or(0, rustre_mem::DiffSpan::len); Ok(ToolResult::text(json!({"first_len":first,"source":"rustre_mem::DiffSpan::len"}).to_string())) } }

