#[async_trait]
impl ToolHandler for NetPcapSplitByTimeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let win_u = args
            .get("window_secs")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'window_secs'".into()))?;
        let win = u32::try_from(win_u)
            .map_err(|_| McpError::InvalidParams("'window_secs' out of u32 range".into()))?;
        let parts = rustre_net_pcap::split_pcap_by_time(&data, win)
            .map_err(|e| McpError::InternalError(format!("split failed: {e}")))?;
        let sizes: Vec<usize> = parts.iter().map(Vec::len).collect();
        Ok(ToolResult::text(
            json!({
                "chunk_count": parts.len(),
                "chunk_sizes": sizes,
                "source": "rustre_net_pcap::split_pcap_by_time",
            })
            .to_string(),
        ))
    }
}

