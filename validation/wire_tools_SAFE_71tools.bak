#[async_trait]
impl ToolHandler for AgentWorkflowTemplatesListTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let templates = rustre_agent_workflow::workflow_templates::list_templates();
        let payload = serde_json::to_value(&templates).map_err(|e| {
            McpError::InternalError(format!("serialize TemplateInfo failed: {e}"))
        })?;
        Ok(ToolResult::text(
            json!({
                "count": templates.len(),
                "templates": payload,
                "source": "rustre_agent_workflow::workflow_templates::list_templates",
            })
            .to_string(),
        ))
    }
}

/// Decode a Wasm external kind byte via `rustre_arch_wasm::WasmExternalKind::from_byte`.
pub struct ArchWasmExternalKindFromByteTool;

impl ArchWasmExternalKindFromByteTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_wasm_external_kind_from_byte".to_string(),
            description:
                "Decode a Wasm external kind byte to its name via \
                 rustre_arch_wasm::WasmExternalKind::from_byte."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "byte": { "type": "integer", "description": "Wasm external kind byte (u8)" }
                },
                "required": ["byte"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchWasmExternalKindFromByteTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let byte = args
            .get("byte")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'byte' (u8)".into()))?;
        let b = u8::try_from(byte)
            .map_err(|_| McpError::InvalidParams("'byte' out of u8 range".into()))?;
        let name = rustre_arch_wasm::WasmExternalKind::from_byte(b).map(|k| k.name());
        Ok(ToolResult::text(
            json!({
                "byte": b,
                "name": name,
                "source": "rustre_arch_wasm::WasmExternalKind::from_byte",
            })
            .to_string(),
        ))
    }
}

/// Decode a Wasm mutability byte via `rustre_arch_wasm::WasmMutability::from_byte`.
pub struct ArchWasmMutabilityFromByteTool;

impl ArchWasmMutabilityFromByteTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_wasm_mutability_from_byte".to_string(),
            description:
                "Decode a Wasm mutability byte via \
                 rustre_arch_wasm::WasmMutability::from_byte."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "byte": { "type": "integer", "description": "Wasm mutability byte (u8)" }
                },
                "required": ["byte"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchWasmMutabilityFromByteTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let byte = args
            .get("byte")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'byte' (u8)".into()))?;
        let b = u8::try_from(byte)
            .map_err(|_| McpError::InvalidParams("'byte' out of u8 range".into()))?;
        let name = rustre_arch_wasm::WasmMutability::from_byte(b).map(|m| match m {
            rustre_arch_wasm::WasmMutability::Const => "const",
            rustre_arch_wasm::WasmMutability::Mutable => "mutable",
        });
        Ok(ToolResult::text(
            json!({
                "byte": b,
                "name": name,
                "source": "rustre_arch_wasm::WasmMutability::from_byte",
            })
            .to_string(),
        ))
    }
}

