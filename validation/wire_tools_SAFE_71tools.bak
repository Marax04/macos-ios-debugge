/// Expose `rustre_symb::SymType::BitVec(width).width()` as an MCP tool.
pub struct SymbSymTypeBitVecWidthTool;

impl SymbSymTypeBitVecWidthTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symb_symtype_bitvec_width".to_string(),
            description: "Return the bitwidth of a SymType::BitVec(width) (rustre_symb::SymType::width).".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "width": { "type": "integer" } },
                "required": ["width"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbSymTypeBitVecWidthTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let width = args.get("width").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'width'".to_string()))?;
        let w = u32::try_from(width)
            .map_err(|_| McpError::InvalidParams("width out of u32 range".to_string()))?;
        let ty = rustre_symb::SymType::BitVec(w);
        let out_w = ty.width();
        Ok(ToolResult::text(
            json!({
                "input_width": w,
                "width": out_w,
                "source": "rustre_symb::SymType::width"
            }).to_string(),
        ))
    }
}

