/// Parse a `0xÃ¢â‚¬Â¦`-prefixed hex string into a `u64` using the sanitizer parser.
pub struct FuzzSanParseHexU64Tool;

impl FuzzSanParseHexU64Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "fuzz_san_parse_hex_u64".to_string(),
            description:
                "Parse a 0x-prefixed hex string into u64 via \
                 rustre_fuzz_sanitizers::parse_hex_u64."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex": { "type": "string" }
                },
                "required": ["hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FuzzSanParseHexU64Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".to_string()))?;
        let value = rustre_fuzz_sanitizers::parse_hex_u64(hex);
        Ok(ToolResult::text(
            json!({
                "input": hex,
                "value": value,
                "ok": value.is_some(),
                "source": "rustre_fuzz_sanitizers::parse_hex_u64",
            })
            .to_string(),
        ))
    }
}

