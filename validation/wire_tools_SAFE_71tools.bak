/// Expose `rustre_agent_llm::llm_context_builder::compress_message` as an MCP tool.
pub struct LlmCompressMessageTool;

impl LlmCompressMessageTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "llm_compress_message".to_string(),
            description: "Compress a message so its estimated token count fits within target_tokens.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["msg", "target_tokens"],
                "properties": {
                    "msg": { "type": "string", "description": "Message to compress" },
                    "target_tokens": { "type": "integer", "description": "Target token budget" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LlmCompressMessageTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let msg = args.get("msg").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'msg'".into()))?;
        let target_tokens = args.get("target_tokens").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'target_tokens'".into()))?;
        let target = u32::try_from(target_tokens)
            .map_err(|_| McpError::InvalidParams("target_tokens out of range".into()))?;
        let out = rustre_agent_llm::llm_context_builder::compress_message(msg, target);
        Ok(ToolResult::text(json!({ "compressed": out }).to_string()))
    }
}

