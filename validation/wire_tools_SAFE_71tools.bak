/// Auto-detect language and demangle, returning full DemangleResult metadata.
pub struct DemangleDispatchTool;

impl DemangleDispatchTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "demangle_dispatch".to_string(),
            description:
                "Auto-detect the mangling language and demangle a symbol, returning language and \
                 symbol kind metadata (delegates to rustre_demangle::Demangler2::demangle)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "mangled": { "type": "string" } },
                "required": ["mangled"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DemangleDispatchTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mangled = args
            .get("mangled")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mangled'".to_string()))?;
        let r = rustre_demangle::Demangler2::demangle(mangled);
        Ok(ToolResult::text(
            json!({
                "mangled": r.mangled,
                "demangled": r.demangled,
                "language": format!("{:?}", r.language),
                "kind": format!("{:?}", r.kind),
                "source": "rustre_demangle::Demangler2::demangle",
            })
            .to_string(),
        ))
    }
}

