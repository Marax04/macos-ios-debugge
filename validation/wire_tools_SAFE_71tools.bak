/// Split a file into fixed-size blocks and compute per-block entropy.
pub struct TriageEntropyAnalyzeBlocksPathTool;

impl TriageEntropyAnalyzeBlocksPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "triage_entropy_analyze_blocks_path".to_string(),
            description: "Split file at `path` into `block_size` chunks and return per-block Shannon entropy with semantic category.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path", "block_size"],
                "properties": {
                    "path": { "type": "string" },
                    "block_size": { "type": "integer", "minimum": 1 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TriageEntropyAnalyzeBlocksPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let block_size = args.get("block_size").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'block_size'".into()))? as usize;
        let data = std::fs::read(path)
            .map_err(|e| McpError::InternalError(format!("read {path}: {e}")))?;
        let blocks = rustre_triage_entropy::analyze_blocks(&data, block_size);
        Ok(ToolResult::text(json!({
            "path": path, "size": data.len(), "block_size": block_size,
            "block_count": blocks.len(), "blocks": blocks
        }).to_string()))
    }
}

