        let pc_offset = args
            .get("pc_offset")
            .and_then(Value::as_u64)
            .unwrap_or(0) as usize;
        let (instr, size) = rustre_arch_jvm::JvmInstr::decode_at(&data, pc_offset)
            .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
