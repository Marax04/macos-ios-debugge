        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let set = rustre_symbols_dwarf::load_dwarf_symbols(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("load_dwarf_symbols failed: {e}")))?;
        Ok(ToolResult::text(json!({
            "functions": set.functions.len(),
            "types": set.types.len(),
            "line_entries": set.line_info.entries.len(),
