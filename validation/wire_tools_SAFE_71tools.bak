pub struct MemKx7PageAlignRoundtripTool;
impl MemKx7PageAlignRoundtripTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_page_align_roundtrip".to_string(), description: "align_up(addr) then align_down(that); expect equality.".to_string(), input_schema: json!({"type":"object","required":["addr","page_size"],"properties":{"addr":{"type":"integer"},"page_size":{"type":"integer"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7PageAlignRoundtripTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let addr = args.get("addr").and_then(Value::as_u64).unwrap_or(0); let page = args.get("page_size").and_then(Value::as_u64).unwrap_or(0); __mem_kx7_check_page(page)?; let up = rustre_mem::region::page_align_up(__mem_kx7_addr(addr), page); let down = rustre_mem::region::page_align_down(up, page); Ok(ToolResult::text(json!({"up":up.as_u64(),"down":down.as_u64(),"equal":up.as_u64()==down.as_u64(),"source":"rustre_mem::region::page_align_up"}).to_string())) } }

pub struct MemKx7PageSpanCountTool;
impl MemKx7PageSpanCountTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_page_span_count".to_string(), description: "Number of pages spanned by [start,end) via page_range_indices.".to_string(), input_schema: json!({"type":"object","required":["start","end","page_size"],"properties":{"start":{"type":"integer"},"end":{"type":"integer"},"page_size":{"type":"integer","minimum":1}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7PageSpanCountTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let start = args.get("start").and_then(Value::as_u64).unwrap_or(0); let end = args.get("end").and_then(Value::as_u64).unwrap_or(0); let page = args.get("page_size").and_then(Value::as_u64).unwrap_or(0); if page == 0 { return Err(McpError::InternalError("page_size must be > 0".into())); } if end <= start { return Ok(ToolResult::text(json!({"pages":0,"source":"rustre_mem::region::page_range_indices"}).to_string())); } let r = rustre_core::address::AddressRange::new(__mem_kx7_addr(start), __mem_kx7_addr(end)); let (first, last) = rustre_mem::region::page_range_indices(&r, page); Ok(ToolResult::text(json!({"pages":last - first + 1,"source":"rustre_mem::region::page_range_indices"}).to_string())) } }

pub struct MemKx7PageAlignUpBatchTool;
impl MemKx7PageAlignUpBatchTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_page_align_up_batch".to_string(), description: "Apply rustre_mem::region::page_align_up to a list of addrs.".to_string(), input_schema: json!({"type":"object","required":["addrs","page_size"],"properties":{"addrs":{"type":"array","items":{"type":"integer"}},"page_size":{"type":"integer"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7PageAlignUpBatchTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let page = args.get("page_size").and_then(Value::as_u64).unwrap_or(0); __mem_kx7_check_page(page)?; let addrs: Vec<u64> = args.get("addrs").and_then(Value::as_array).map(|a| a.iter().filter_map(Value::as_u64).collect()).unwrap_or_default(); let out: Vec<u64> = addrs.iter().map(|a| rustre_mem::region::page_align_up(__mem_kx7_addr(*a), page).as_u64()).collect(); Ok(ToolResult::text(json!({"count":out.len(),"aligned":out,"source":"rustre_mem::region::page_align_up"}).to_string())) } }

