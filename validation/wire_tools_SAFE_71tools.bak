/// Estimate multi-byte XOR key length using index-of-coincidence.
pub struct DeobfStringDetectXorKeyLengthIcTool;

impl DeobfStringDetectXorKeyLengthIcTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "deobf_string_detect_xor_key_length_ic".to_string(),
            description:
                "Rank candidate multi-byte XOR key lengths using index-of-coincidence \
                 (rustre_deobf_string::detect_xor_key_length_ic)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "max_key_len": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DeobfStringDetectXorKeyLengthIcTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let max_key_len = args.get("max_key_len").and_then(Value::as_u64).unwrap_or(16) as usize;
        let ranked = rustre_deobf_string::detect_xor_key_length_ic(&data, max_key_len);
        let json_ranked: Vec<Value> = ranked.iter().map(|(k, ic)| json!({
            "key_length": k,
            "avg_ic": ic,
        })).collect();
        Ok(ToolResult::text(json!({
            "input_len": data.len(),
            "max_key_len": max_key_len,
            "ranked": json_ranked,
            "source": "rustre_deobf_string::detect_xor_key_length_ic",
        }).to_string()))
    }
}

