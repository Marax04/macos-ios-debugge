/// Expose `rustre_net::ip_checksum` as an MCP tool.
pub struct NetIpChecksumTool;

impl NetIpChecksumTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_ip_checksum".to_string(),
            description: "Compute the RFC 1071 one's-complement 16-bit IP checksum over hex bytes.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": {
                    "hex": { "type": "string", "description": "Hex-encoded input bytes" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetIpChecksumTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let bytes = args_to_bytes(&args)?;
        let sum = rustre_net::ip_checksum(&bytes);
        Ok(ToolResult::text(
            json!({ "checksum": sum, "hex": format!("{:04X}", sum) }).to_string(),
        ))
    }
}

/// Expose `rustre_net::is_private_addr` as an MCP tool.
pub struct NetIsPrivateAddrTool;

impl NetIsPrivateAddrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_is_private_addr".to_string(),
            description: "Return true if the given IP address is in a private range (RFC 1918 / ULA).".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["addr"],
                "properties": {
                    "addr": { "type": "string", "description": "IPv4 or IPv6 address string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetIsPrivateAddrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args.get("addr").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".into()))?;
        let addr: std::net::IpAddr = s.parse()
            .map_err(|e: std::net::AddrParseError| McpError::InvalidParams(format!("invalid addr: {e}")))?;
        let private = rustre_net::is_private_addr(addr);
        Ok(ToolResult::text(
            json!({ "addr": s, "private": private }).to_string(),
        ))
    }
}

