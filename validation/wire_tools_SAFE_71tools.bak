// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-mobile-apktool wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Locate the `apktool` binary on the system PATH.
pub struct MobileApktoolFindTool;

impl MobileApktoolFindTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mobile_apktool_find".to_string(),
            description:
                "Locate the apktool binary using APKTOOL_PATH env var or PATH lookup."
                    .to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MobileApktoolFindTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let found = rustre_mobile_apktool::CliApktoolRunner::find_apktool();
        Ok(ToolResult::text(
            json!({
                "found": found.is_some(),
                "path": found.as_ref().map(|p| p.to_string_lossy().into_owned()),
                "source": "rustre_mobile_apktool::CliApktoolRunner::find_apktool",
            })
            .to_string(),
        ))
    }
}

/// Build a canonical `ApktoolConfig` JSON blob from an apktool path and output dir.
pub struct MobileApktoolConfigNewTool;

impl MobileApktoolConfigNewTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mobile_apktool_config_new".to_string(),
            description:
                "Construct an ApktoolConfig with optional no_src/no_res/force flags."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "apktool_path": { "type": "string" },
                    "output_dir":   { "type": "string" },
                    "no_src":       { "type": "boolean" },
                    "no_res":       { "type": "boolean" },
                    "force":        { "type": "boolean" }
                },
                "required": ["apktool_path", "output_dir"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MobileApktoolConfigNewTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("apktool_path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'apktool_path'".into()))?;
        let out = args.get("output_dir").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output_dir'".into()))?;
        let mut cfg = rustre_mobile_apktool::ApktoolConfig::new(path, out);
        if args.get("no_src").and_then(Value::as_bool).unwrap_or(false) {
            cfg = cfg.with_no_src();
        }
        if args.get("no_res").and_then(Value::as_bool).unwrap_or(false) {
            cfg = cfg.with_no_res();
        }
        if args.get("force").and_then(Value::as_bool).unwrap_or(false) {
            cfg = cfg.with_force();
        }
        Ok(ToolResult::text(
            json!({
                "config": cfg,
                "source": "rustre_mobile_apktool::ApktoolConfig::new",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ syscalls-linux Ã¢â‚¬â€ x86_64 syscall name/number lookup Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct SyscallsLinuxX8664NameTool;

impl SyscallsLinuxX8664NameTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "syscalls_linux_x86_64_name".to_string(),
            description: "Resolve Linux x86_64 syscall number to its symbolic name.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "nr": { "type": "integer" } },
                "required": ["nr"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SyscallsLinuxX8664NameTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let nr = args
            .get("nr")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'nr'".to_string()))?
            as u32;
        let name = rustre_syscalls_linux::x86_64_syscall_name(nr);
        Ok(ToolResult::text(
            json!({
                "nr": nr,
                "name": name,
                "source": "rustre_syscalls_linux::x86_64_syscall_name",
            })
            .to_string(),
        ))
    }
}

