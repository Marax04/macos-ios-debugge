pub struct SandboxVmMemoryMapMockTool;

impl SandboxVmMemoryMapMockTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "sandbox_vm_memory_map_mock".to_string(),
            description: "Build a mock guest MemoryMap for a given PID via \
                          rustre_sandbox_vm::MemoryMap::mock. Returns region \
                          count, total size, and RWX region count."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "pid": {"type": "integer", "description": "Guest process id"}
                },
                "required": ["pid"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SandboxVmMemoryMapMockTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let pid = args.get("pid").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'pid'".into()))? as u32;
        let map = rustre_sandbox_vm::MemoryMap::mock(pid);
        let region_count = map.regions.len();
        let total = map.total_size();
        let rwx_count = map.rwx_regions().len();
        Ok(ToolResult::text(
            json!({
                "pid": pid,
                "region_count": region_count,
                "total_size": total,
                "rwx_region_count": rwx_count,
                "source": "rustre_sandbox_vm::MemoryMap::mock",
            })
            .to_string(),
        ))
    }
}

