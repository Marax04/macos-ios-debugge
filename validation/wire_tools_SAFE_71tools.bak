/// Format a `CfsAlgorithm` variant via its `Display` impl.
pub struct DecompilerCfsAlgorithmDisplayTool;

impl DecompilerCfsAlgorithmDisplayTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "decompiler_cfs_algorithm_display".to_string(),
            description:
                "Display the name of a rustre_decompiler_cfs::CfsAlgorithm variant \
                 (dream|phoenix|sailr|structural)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "algorithm": {
                        "type": "string",
                        "enum": ["dream", "phoenix", "sailr", "structural"]
                    }
                },
                "required": ["algorithm"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DecompilerCfsAlgorithmDisplayTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("algorithm")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'algorithm'".into()))?;
        let alg = match name.to_ascii_lowercase().as_str() {
            "dream" => rustre_decompiler_cfs::CfsAlgorithm::Dream,
            "phoenix" => rustre_decompiler_cfs::CfsAlgorithm::Phoenix,
            "sailr" => rustre_decompiler_cfs::CfsAlgorithm::Sailr,
            "structural" => rustre_decompiler_cfs::CfsAlgorithm::Structural,
            other => {
                return Err(McpError::InvalidParams(format!(
                    "unknown algorithm '{other}'"
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "algorithm": name,
                "display":   alg.to_string(),
                "source":    "rustre_decompiler_cfs::CfsAlgorithm::Display",
            })
            .to_string(),
        ))
    }
}

