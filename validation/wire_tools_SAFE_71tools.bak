}

#[async_trait]
impl ToolHandler for SysinternalsProcessInTempDirTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let exe_path = args
            .get("exe_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'exe_path'".to_string()))?;
        let mut p = rustre_sysinternals::ProcessInfo::new(0, 0, "");
        p.exe_path = exe_path.to_string();
        Ok(ToolResult::text(
            json!({
                "exe_path": exe_path,
                "in_temp_dir": p.in_temp_dir(),
                "source": "rustre_sysinternals::ProcessInfo::in_temp_dir",
            })
            .to_string(),
        ))
    }
}

