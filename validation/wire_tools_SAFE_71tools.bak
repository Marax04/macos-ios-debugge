        let mut rc4 = rustre_pe_editor::Rc4::new(&key);
        rc4.process(&mut data);
        Ok(ToolResult::text(
            json!({
                "len": data.len(),
                "out_hex": pe_editor_hex_encode(&data),
                "source": "rustre_pe_editor::Rc4::process",
            })
            .to_string(),
        ))
    }
}

pub struct PeImportEntryDisplayTool;

impl PeImportEntryDisplayTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_editor_import_entry_display".to_string(),
            description:
                "Build a rustre_pe_editor::ImportEntry (named or ordinal) and return its display string plus fields."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "dll":     {"type": "string"},
                    "name":    {"type": "string"},
                    "ordinal": {"type": "integer", "minimum": 0},
                    "hint":    {"type": "integer", "minimum": 0}
                },
                "required": ["dll"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeImportEntryDisplayTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let dll = args.get("dll").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'dll'".into()))?
            .to_string();
        let name = args.get("name").and_then(Value::as_str).unwrap_or("").to_string();
        let hint = args.get("hint").and_then(Value::as_u64).unwrap_or(0) as u16;
        let entry = if name.is_empty() {
            let ord = args.get("ordinal").and_then(Value::as_u64)
                .ok_or_else(|| McpError::InvalidParams("need 'name' or 'ordinal'".into()))? as u16;
            rustre_pe_editor::ImportEntry::ordinal(dll, ord)
        } else {
            rustre_pe_editor::ImportEntry::named(dll, name, hint)
        };
        Ok(ToolResult::text(
            json!({
                "display": entry.display(),
                "is_named": entry.is_named(),
                "dll": entry.dll,
                "name": entry.name,
                "ordinal": entry.ordinal,
                "hint": entry.hint,
                "source": "rustre_pe_editor::ImportEntry",
            })
            .to_string(),
        ))
    }
}

