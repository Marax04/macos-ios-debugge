            .get("api_key")
            .and_then(Value::as_str)
            .unwrap_or("")
            .to_string();
        let pulse_id = args
            .get("pulse_id")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("pulse_id missing".to_string()))?;
        let cfg = rustre_ti_otx::OtxConfig::new(api_key);
        let url = cfg.pulse_url(pulse_id);
        let subscribed = cfg.subscribed_url();
        Ok(ToolResult::text(
            json!({
                "pulse_url":      url,
                "subscribed_url": subscribed,
                "base_url":       cfg.base_url,
                "source":         "rustre_ti_otx::OtxConfig",
            })
            .to_string(),
        ))
    }
}

