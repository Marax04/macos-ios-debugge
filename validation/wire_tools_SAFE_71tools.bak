#[async_trait] impl ToolHandler for SymbolsV7SymbolCacheLruTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let cap = args.get("cap").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("cap".into()))? as usize; let addrs = args.get("addrs").and_then(Value::as_array).ok_or_else(|| McpError::InvalidParams("addrs".into()))?; let probe = args.get("probe").and_then(Value::as_u64).ok_or_else(|| McpError::InvalidParams("probe".into()))?; let mut c = rustre_symbols::SymbolCache::new(cap); for v in addrs { if let Some(a) = v.as_u64() { c.insert(a, rustre_symbols::Symbol::new(format!("f_{a:x}"), a, rustre_symbols::SymKind::Function)); } } let hit = c.get(probe).map(|s| s.name); Ok(ToolResult::text(json!({"len":c.len(),"capacity":c.capacity(),"hit":hit,"source":"rustre_symbols::SymbolCache"}).to_string())) } }

pub struct SymbolsV7SymbolStatsFromNamesTool;
impl SymbolsV7SymbolStatsFromNamesTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "symbols_v7_symbol_stats_from_names".to_string(), description: "SymbolStats::from_symbols with function/data/label mix.".to_string(), input_schema: json!({"type":"object","properties":{"funcs":{"type":"integer"},"data":{"type":"integer"},"labels":{"type":"integer"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for SymbolsV7SymbolStatsFromNamesTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let f = args.get("funcs").and_then(Value::as_u64).unwrap_or(2); let d = args.get("data").and_then(Value::as_u64).unwrap_or(1); let l = args.get("labels").and_then(Value::as_u64).unwrap_or(1); let mut v: Vec<rustre_symbols::Symbol> = Vec::new(); for i in 0..f { v.push(rustre_symbols::Symbol::new(format!("fn_{i}"), 0x1000 + i, rustre_symbols::SymKind::Function)); } for i in 0..d { v.push(rustre_symbols::Symbol::new(format!("d_{i}"), 0x2000 + i, rustre_symbols::SymKind::Data)); } for i in 0..l { v.push(rustre_symbols::Symbol::new(format!("l_{i}"), 0x3000 + i, rustre_symbols::SymKind::Label)); } let s = rustre_symbols::SymbolStats::from_symbols(&v); Ok(ToolResult::text(json!({"total":s.total,"functions":s.functions,"data":s.data,"labels":s.labels,"display":s.to_string(),"source":"rustre_symbols::SymbolStats"}).to_string())) } }

pub struct SymbolsV7SymbolStoreOpsTool;
impl SymbolsV7SymbolStoreOpsTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "symbols_v7_symbol_store_ops".to_string(), description: "SymbolStore upsert/find_by_name/find_by_prefix/rename/len.".to_string(), input_schema: json!({"type":"object","properties":{"entries":{"type":"array","items":{"type":"object"}},"prefix":{"type":"string"},"rename_from":{"type":"string"},"rename_to":{"type":"string"},"rename_addr":{"type":"integer"}},"required":["entries"]}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for SymbolsV7SymbolStoreOpsTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let arr = args.get("entries").and_then(Value::as_array).ok_or_else(|| McpError::InvalidParams("entries".into()))?; let mut st = rustre_symbols::SymbolStore::new(); for e in arr { let n = e.get("name").and_then(Value::as_str).unwrap_or("s").to_string(); let a = e.get("addr").and_then(Value::as_u64).unwrap_or(0); st.upsert(rustre_symbols::Symbol::new(n, a, rustre_symbols::SymKind::Function)); } let pfx = args.get("prefix").and_then(Value::as_str).unwrap_or(""); let by_prefix = st.find_by_prefix(pfx).len(); let mut renamed = false; if let (Some(f), Some(t), Some(a)) = (args.get("rename_from").and_then(Value::as_str), args.get("rename_to").and_then(Value::as_str), args.get("rename_addr").and_then(Value::as_u64)) { renamed = st.rename(a, f, t); } let stats = st.stats(); Ok(ToolResult::text(json!({"len":st.len(),"by_prefix":by_prefix,"renamed":renamed,"stats_total":stats.total,"source":"rustre_symbols::SymbolStore"}).to_string())) } }

