/// Round-trip a MISP attribute type string through `MispAttributeType`.
pub struct TiMispAttributeTypeRoundtripTool;

impl TiMispAttributeTypeRoundtripTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_attribute_type_roundtrip".to_string(),
            description:
                "Parse a MISP attribute type string with MispAttributeType::from_misp_str \
                 and return the canonical wire form via as_misp_str."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "attr_type": { "type": "string" }
                },
                "required": ["attr_type"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispAttributeTypeRoundtripTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let attr_type = args
            .get("attr_type")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'attr_type'".to_string()))?;
        let parsed = rustre_ti_misp::MispAttributeType::from_misp_str(attr_type);
        Ok(ToolResult::text(
            json!({
                "input": attr_type,
                "recognised": parsed.is_some(),
                "canonical": parsed.as_ref().map(|t| t.as_misp_str()),
                "source": "rustre_ti_misp::MispAttributeType",
            })
            .to_string(),
        ))
    }
}

pub struct ScriptBuiltinHexToBytesTool;

impl ScriptBuiltinHexToBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_builtin_hex_to_bytes".to_string(),
            description: "Convert a hex string to bytes via rustre_script::builtin_hex_to_bytes."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex": {"type": "string", "description": "Hex string (optional 0x prefix)"}
                },
                "required": ["hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptBuiltinHexToBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let sv = rustre_script::ScriptValue::String(hex.to_string());
        let out = rustre_script::builtin_hex_to_bytes(&[sv])
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        let bytes = out.as_bytes().map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "len": bytes.len(),
                "hex": hex_encode(bytes),
                "source": "rustre_script::builtin_hex_to_bytes",
            })
            .to_string(),
        ))
    }
}

pub struct ScriptBuiltinBytesToHexTool;

impl ScriptBuiltinBytesToHexTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_builtin_bytes_to_hex".to_string(),
            description: "Convert bytes to a hex string via rustre_script::builtin_bytes_to_hex."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data_hex": {"type": "string", "description": "Hex-encoded input bytes"}
                },
                "required": ["data_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptBuiltinBytesToHexTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data_hex = args.get("data_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'data_hex'".into()))?;
        let data = pe_editor_hex_decode(data_hex)?;
        let sv = rustre_script::ScriptValue::Bytes(data.clone());
        let out = rustre_script::builtin_bytes_to_hex(&[sv])
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        let hex = out.as_str().map_err(|e| McpError::InternalError(e.to_string()))?.to_string();
        Ok(ToolResult::text(
            json!({
                "len": data.len(),
                "hex": hex,
                "source": "rustre_script::builtin_bytes_to_hex",
            })
            .to_string(),
        ))
    }
}

