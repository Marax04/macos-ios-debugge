                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptBytesToHexTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let sv = rustre_script::builtin_bytes_to_hex(&[
            rustre_script::ScriptValue::Bytes(data.clone()),
        ])
        .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let hex = match sv {
            rustre_script::ScriptValue::String(s) => s,
            other => {
                return Err(McpError::InternalError(format!(
                    "bytes_to_hex returned non-string: {}",
                    other.type_name()
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "hex":   hex,
                "len":   data.len(),
                "source": "rustre_script::builtin_bytes_to_hex",
            })
            .to_string(),
        ))
    }
}

/// XOR two byte buffers (cycling key) via `rustre_script::builtin_xor_bytes`.
pub struct ScriptXorBytesTool;

impl ScriptXorBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_xor_bytes".to_string(),
            description:
                "XOR a data buffer against a (cycling) key buffer using the rustre-script \
                 builtin `xor_bytes`. Both buffers accept byte arrays or hex strings."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data":     { "type": "array", "items": { "type": "integer" } },
                    "data_hex": { "type": "string" },
                    "key":      { "type": "array", "items": { "type": "integer" } },
                    "key_hex":  { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptXorBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = extract_byte_array(&args, "data", "data_hex")?;
        let key = extract_byte_array(&args, "key", "key_hex")?;
        let sv = rustre_script::builtin_xor_bytes(&[
            rustre_script::ScriptValue::Bytes(data.clone()),
            rustre_script::ScriptValue::Bytes(key.clone()),
        ])
        .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let out = match sv {
            rustre_script::ScriptValue::Bytes(b) => b,
            other => {
                return Err(McpError::InternalError(format!(
                    "xor_bytes returned non-bytes: {}",
                    other.type_name()
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "bytes": out,
                "hex":   hex_encode(&out),
                "len":   out.len(),
                "data_len": data.len(),
                "key_len":  key.len(),
                "source": "rustre_script::builtin_xor_bytes",
            })
            .to_string(),
        ))
    }
}

