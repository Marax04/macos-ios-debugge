            description:
                "Parse an SMT-LIB2 model / get-value output and return a name Ã¢â€ â€™ u64 map, \
                 using rustre_symb_z3::SmtLib2Parser::parse_model."
                    .to_string(),
            input_schema: json!({
                "type": "object",
