/// Project FLIRT matches into the minimal LibraryMark list (feature-K).
pub struct FlirtApplyLibraryMarksFromMatchesTool;

impl FlirtApplyLibraryMarksFromMatchesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_apply_library_marks_from_matches".to_string(),
            description:
                "Project FlirtMatch entries into LibraryMark records \
                 (address + lib_name), dropping matches with an empty \
                 library name. Mirrors \
                 rustre_flirt_apply::library_marks_from_matches."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["matches"],
                "properties": {
                    "matches": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "address":        { "type": "integer" },
                                "function_name":  { "type": "string" },
                                "lib_name":       { "type": "string" },
                                "confidence":     { "type": "integer" },
                                "pattern_length": { "type": "integer" }
                            }
                        }
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtApplyLibraryMarksFromMatchesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let raw = args
            .get("matches")
            .ok_or_else(|| McpError::InvalidParams("missing 'matches'".to_string()))?;
        let matches: Vec<rustre_flirt_apply::FlirtMatch> =
            serde_json::from_value(raw.clone()).map_err(|e| {
                McpError::InvalidParams(format!("parse matches: {e}"))
            })?;
        let marks = rustre_flirt_apply::library_marks_from_matches(&matches);
        let val = serde_json::to_value(&marks).map_err(|e| {
            McpError::InternalError(format!("serialize marks: {e}"))
        })?;
        Ok(ToolResult::text(
            json!({
                "marks": val,
                "count": marks.len(),
                "input_matches": matches.len(),
                "source": "rustre_flirt_apply::library_marks_from_matches",
            })
            .to_string(),
        ))
    }
}

