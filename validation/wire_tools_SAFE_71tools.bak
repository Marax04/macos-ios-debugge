            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MemPageAlignUpWireTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let addr = args
            .get("addr")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".to_string()))?;
        let page_size = args
            .get("page_size")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'page_size'".to_string()))?;
        let aligned = rustre_mem::page_align_up(rustre_core::address::Address::new(addr), page_size);
        Ok(ToolResult::text(
            json!({
                "aligned":   aligned.as_u64(),
                "addr":      addr,
                "page_size": page_size,
                "source":    "rustre_mem::page_align_up",
            })
            .to_string(),
        ))
    }
}

