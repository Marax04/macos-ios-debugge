/// Compute a SHA-256 digest for the given bytes via `rustre_forensics::compute_sha256`.
pub struct ForensicsComputeSha256Tool;

impl ForensicsComputeSha256Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "forensics_compute_sha256".to_string(),
            description:
                "Call rustre_forensics::compute_sha256 on the provided data (utf-8 string) and \
                 return the lowercase hex digest."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ForensicsComputeSha256Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args.get("data").and_then(Value::as_str).unwrap_or("");
        let digest = rustre_forensics::compute_sha256(data.as_bytes());
        Ok(ToolResult::text(
            json!({
                "digest": digest,
                "len": data.len(),
                "source": "rustre_forensics::compute_sha256",
            })
            .to_string(),
        ))
    }
}

