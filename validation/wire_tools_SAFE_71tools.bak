fn __decomp_parse_int_width(s: &str) -> Option<rustre_decompiler_expr::IntWidth> {
    use rustre_decompiler_expr::IntWidth as W;
    Some(match s {
        "i8" | "I8" => W::I8, "i16" | "I16" => W::I16, "i32" | "I32" => W::I32, "i64" | "I64" => W::I64,
        "u8" | "U8" => W::U8, "u16" | "U16" => W::U16, "u32" | "U32" => W::U32, "u64" | "U64" => W::U64,
        _ => return None,
    })
}

