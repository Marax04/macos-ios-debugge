#[async_trait]
impl ToolHandler for DotnetEditNewMethodEncodeSigWireTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let desc = rustre_dotnet_edit::NewMethodDescriptor::static_void(name);
        let sig = desc.encode_sig();
        let hex: String = sig.iter().map(|b| format!("{b:02x}")).collect();
        Ok(ToolResult::text(
            json!({
                "name": name,
                "sig_hex": hex,
                "sig_len": sig.len(),
                "source": "rustre_dotnet_edit::NewMethodDescriptor::static_void.encode_sig",
            })
            .to_string(),
        ))
    }
}

