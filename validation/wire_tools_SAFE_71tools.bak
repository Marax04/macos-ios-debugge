/// Expose `rustre_symb_z3::SmtLib2Parser::parse_check_sat` via wire tool.
pub struct SymbZ3ParseCheckSatWireTool;

impl SymbZ3ParseCheckSatWireTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symb_z3_parse_check_sat_wire".to_string(),
            description: "Parse Z3 check-sat output.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "output": { "type": "string" } },
                "required": ["output"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbZ3ParseCheckSatWireTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args
            .get("output")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".to_string()))?;
        let result = rustre_symb_z3::SmtLib2Parser::parse_check_sat(output);
        let (kind, detail) = match &result {
            rustre_symb_z3::SolverResult::Sat => ("sat", String::new()),
            rustre_symb_z3::SolverResult::Unsat => ("unsat", String::new()),
            rustre_symb_z3::SolverResult::Unknown(s) => ("unknown", s.clone()),
        };
        Ok(ToolResult::text(
            json!({
                "result": kind,
                "detail": detail,
                "source": "rustre_symb_z3::SmtLib2Parser::parse_check_sat",
            })
            .to_string(),
        ))
    }
}

/// Expose `rustre_yara::StringMatcher::match_masked_byte` as an MCP tool.
pub struct YaraMatchMaskedByteTool;

impl YaraMatchMaskedByteTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "yara_match_masked_byte".to_string(),
            description: "Return true if data_byte matches the nibble mask pattern (data_byte & mask) == (value & mask).".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "value": {"type": "integer"},
                    "mask": {"type": "integer"},
                    "data_byte": {"type": "integer"}
                },
                "required": ["value", "mask", "data_byte"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for YaraMatchMaskedByteTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args.get("value").and_then(Value::as_u64).unwrap_or(0) as u8;
        let mask = args.get("mask").and_then(Value::as_u64).unwrap_or(0) as u8;
        let data_byte = args.get("data_byte").and_then(Value::as_u64).unwrap_or(0) as u8;
        let matched = rustre_yara::StringMatcher::match_masked_byte(value, mask, data_byte);
        Ok(ToolResult::text(json!({ "matched": matched }).to_string()))
    }
}

/// Expose `rustre_yara::StringMatcher::check_fullword` as an MCP tool.
pub struct YaraCheckFullwordTool;

impl YaraCheckFullwordTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "yara_check_fullword".to_string(),
            description: "Return true if data[offset..offset+len] is bounded by non-word characters (or file start/end).".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data": {"type": "array", "items": {"type": "integer"}},
                    "offset": {"type": "integer"},
                    "len": {"type": "integer"}
                },
                "required": ["data", "offset", "len"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for YaraCheckFullwordTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data: Vec<u8> = args
            .get("data")
            .and_then(Value::as_array)
            .map(|arr| arr.iter().filter_map(|v| v.as_u64().map(|n| n as u8)).collect())
            .unwrap_or_default();
        let offset = args.get("offset").and_then(Value::as_u64).unwrap_or(0) as usize;
        let len = args.get("len").and_then(Value::as_u64).unwrap_or(0) as usize;
        let ok = rustre_yara::StringMatcher::check_fullword(&data, offset, len);
        Ok(ToolResult::text(json!({ "fullword": ok }).to_string()))
    }
}

