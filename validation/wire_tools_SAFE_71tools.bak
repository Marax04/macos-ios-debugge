pub struct KgdbU64ToHexLeTool;
impl KgdbU64ToHexLeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "kgdb_u64_to_hex_le".to_string(),
