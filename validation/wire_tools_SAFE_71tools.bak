// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ TTD-replay: build_call_graph / split_by_thread Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct TtdReplayBuildCallGraphTool;

impl TtdReplayBuildCallGraphTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replay_build_call_graph".to_string(),
            description: "Build a call-count edge table from a synthetic TTD trace of n events via rustre_ttd_replay::build_call_graph.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "n": {"type": "integer", "description": "Number of events (u64)"}
                },
                "required": ["n"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplayBuildCallGraphTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let n = args.get("n").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'n'".into()))?;
        let trace = rustre_ttd::build_test_trace(n);
        let edges = rustre_ttd_replay::build_call_graph(&trace);
        let total: u64 = edges.iter().map(|e| e.count).sum();
        Ok(ToolResult::text(
            json!({
                "n": n,
                "edge_count": edges.len(),
                "total_calls": total,
                "source": "rustre_ttd_replay::build_call_graph",
            })
            .to_string(),
        ))
    }
}

pub struct TtdReplaySplitByThreadTool;

impl TtdReplaySplitByThreadTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replay_split_by_thread".to_string(),
            description: "Split a synthetic multi-thread TTD trace of n events into per-thread timelines via rustre_ttd_replay::split_by_thread.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "n": {"type": "integer", "description": "Number of events (u64)"}
                },
                "required": ["n"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplaySplitByThreadTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let n = args.get("n").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'n'".into()))?;
        let trace = rustre_ttd::build_multi_thread_trace(n);
        let timelines = rustre_ttd_replay::split_by_thread(&trace);
        let mut tids: Vec<u32> = timelines.keys().copied().collect();
        tids.sort_unstable();
        let per_thread_counts: Vec<(u32, usize)> =
            tids.iter().map(|t| (*t, timelines[t].event_count())).collect();
        Ok(ToolResult::text(
            json!({
                "n": n,
                "thread_count": timelines.len(),
                "thread_ids": tids,
                "per_thread_event_counts": per_thread_counts,
                "source": "rustre_ttd_replay::split_by_thread",
            })
            .to_string(),
        ))
    }
}

pub struct TtdReplayComputeMemoryAccessStatsTool;

impl TtdReplayComputeMemoryAccessStatsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_replay_compute_memory_access_stats".to_string(),
            description: "Compute memory access statistics (read/write counts, unique addresses, first/last access positions) over an address range across a synthetic TTD trace of n events via rustre_ttd_replay::compute_memory_access_stats.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "n": {"type": "integer", "description": "Number of events (u64)"},
                    "range_start": {"type": "integer", "description": "Start of address range (u64)"},
                    "range_end": {"type": "integer", "description": "End of address range, exclusive (u64)"}
                },
                "required": ["n", "range_start", "range_end"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdReplayComputeMemoryAccessStatsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let n = args.get("n").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'n'".into()))?;
        let range_start = args.get("range_start").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'range_start'".into()))?;
        let range_end = args.get("range_end").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'range_end'".into()))?;
        let trace = rustre_ttd::build_test_trace(n);
        let stats = rustre_ttd_replay::compute_memory_access_stats(&trace, range_start, range_end);
        Ok(ToolResult::text(
            json!({
                "n": n,
                "range_start": range_start,
                "range_end": range_end,
                "read_count": stats.read_count,
                "write_count": stats.write_count,
                "total_accesses": stats.total_accesses(),
                "unique_address_count": stats.unique_addresses.len(),
                "first_access": stats.first_access.map(|p| p.to_string()),
                "last_access": stats.last_access.map(|p| p.to_string()),
                "source": "rustre_ttd_replay::compute_memory_access_stats",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-fuzz-afl wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Parse an AFL-format dictionary file text via `rustre_fuzz_afl::Dictionary::load_afl_format`.
pub struct FuzzAflDictLoadTool;

impl FuzzAflDictLoadTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "fuzz_afl_dict_load".to_string(),
            description:
                "Parse an AFL-format dictionary (one token per line, quoted strings and x\"hex\" \
                 supported) via rustre_fuzz_afl::Dictionary::load_afl_format. Returns token count \
                 and the parsed entries."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["text"],
                "properties": {
                    "text": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FuzzAflDictLoadTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let text = args.get("text").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'text'".into()))?;
        let mut dict = rustre_fuzz_afl::Dictionary::new();
        let count = dict.load_afl_format(text)
            .map_err(|e| McpError::InternalError(format!("dict parse: {e}")))?;
        let entries: Vec<String> = dict.entries.iter()
            .map(|t| String::from_utf8_lossy(t).into_owned())
            .collect();
        Ok(ToolResult::text(
            json!({
                "count": count,
                "entries": entries,
                "source": "rustre_fuzz_afl::Dictionary::load_afl_format",
            })
            .to_string(),
        ))
    }
}

