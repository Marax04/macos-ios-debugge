            name: "yara_ruleset_add_rule".to_string(),
            description: "Add a YARA rule source to a fresh YaraRuleSet and return the rule count.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "source": { "type": "string" } },
                "required": ["source"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for YaraRuleSetAddRuleTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let source = args
            .get("source")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'source'".to_string()))?;
        let mut set = rustre_yara_engine::YaraRuleSet::new();
        match set.add_rule(source) {
            Ok(()) => Ok(ToolResult::text(
                json!({
                    "ok": true,
                    "rule_count": set.len(),
                    "source": "rustre_yara_engine::YaraRuleSet::add_rule",
                })
                .to_string(),
            )),
            Err(e) => Ok(ToolResult::text(
                json!({
                    "ok": false,
                    "error": e.to_string(),
                    "source": "rustre_yara_engine::YaraRuleSet::add_rule",
                })
                .to_string(),
            )),
        }
    }
}

