        let root = args.get("root").and_then(Value::as_str).unwrap_or("").to_string();
        let guest_path = args.get("guest_path").and_then(Value::as_str).unwrap_or("/").to_string();
        let rfs = rustre_emu_qiling::RootfsPath::new(&root);
        let host = rfs.host_path(&guest_path);
        Ok(ToolResult::text(
            json!({
                "root": root,
                "guest_path": guest_path,
                "host_path": host.display().to_string(),
                "exists": rfs.exists(&guest_path),
                "source": "rustre_emu_qiling::RootfsPath::exists",
            })
            .to_string(),
        ))
    }
}

pub struct EmuQilingProcessEnvNewLinux64Tool;

impl EmuQilingProcessEnvNewLinux64Tool {
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_qiling_process_env_new_linux64".to_string(),
            description:
                "Build a rustre_emu_qiling::ProcessEnv via new_linux64 and report argv/envp \
                 counts plus default stack/heap layout."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "argv": { "type": "array", "items": { "type": "string" } }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuQilingProcessEnvNewLinux64Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let argv: Vec<String> = args
            .get("argv")
            .and_then(Value::as_array)
            .map(|a| a.iter().filter_map(|v| v.as_str().map(String::from)).collect())
            .unwrap_or_else(|| vec!["guest".to_string()]);
        let env = rustre_emu_qiling::ProcessEnv::new_linux64(argv);
        Ok(ToolResult::text(
            json!({
                "argv_len": env.argv.len(),
                "envp_len": env.envp.len(),
                "stack_base": env.stack_base,
                "stack_size": env.stack_size,
                "heap_base": env.heap_base,
                "brk": env.brk,
                "source": "rustre_emu_qiling::ProcessEnv::new_linux64",
            })
            .to_string(),
        ))
    }
}

