/// Read a little-endian u32 from a bytes buffer via `rustre_script::builtin_read_u32`.
pub struct ScriptReadU32Tool;

impl ScriptReadU32Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_read_u32".to_string(),
            description:
                "Read a little-endian u32 from a bytes buffer at the given offset \
                 via the rustre-script builtin `read_u32`."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes":  { "type": "array", "items": { "type": "integer" } },
                    "hex":    { "type": "string" },
                    "offset": { "type": "integer" }
                },
                "required": ["offset"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptReadU32Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let off = args.get("offset").and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'offset'".into()))?;
        let sv = rustre_script::builtin_read_u32(&[
            rustre_script::ScriptValue::Bytes(data.clone()),
            rustre_script::ScriptValue::Int(off),
        ])
        .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let value = match sv {
            rustre_script::ScriptValue::Int(n) => n,
            other => {
                return Err(McpError::InternalError(format!(
                    "read_u32 returned non-int: {}",
                    other.type_name()
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "value":  value,
                "offset": off,
                "len":    data.len(),
                "source": "rustre_script::builtin_read_u32",
            })
            .to_string(),
        ))
    }
}

/// Produce a bytes buffer of `count` repetitions of `byte` via `rustre_script::builtin_bytes_fill`.
pub struct ScriptBytesFillTool;

impl ScriptBytesFillTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "script_bytes_fill".to_string(),
            description:
                "Return a bytes value filled with a repeated byte via the rustre-script \
                 builtin `bytes_fill` (bounded at 256 MiB)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "count": { "type": "integer" },
                    "byte":  { "type": "integer" }
                },
                "required": ["count", "byte"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ScriptBytesFillTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let count = args.get("count").and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'count'".into()))?;
        let byte = args.get("byte").and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'byte'".into()))?;
        let sv = rustre_script::builtin_bytes_fill(&[
            rustre_script::ScriptValue::Int(count),
            rustre_script::ScriptValue::Int(byte),
        ])
        .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let out = match sv {
            rustre_script::ScriptValue::Bytes(b) => b,
            other => {
                return Err(McpError::InternalError(format!(
                    "bytes_fill returned non-bytes: {}",
                    other.type_name()
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "bytes":  out,
                "hex":    hex_encode(&out),
                "len":    out.len(),
                "source": "rustre_script::builtin_bytes_fill",
            })
            .to_string(),
        ))
    }
}

