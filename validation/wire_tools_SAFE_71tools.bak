/// Scan x86-64 bytes and return masked (variable) operand ranges via
/// `rustre_flirt_gen::scan_x86_masks`.
pub struct FlirtGenScanX86MasksTool;

impl FlirtGenScanX86MasksTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_gen_scan_x86_masks".to_string(),
            description:
                "Scan x86-64 bytes and return masked (offset,size) ranges for \
                 relocatable operands via rustre_flirt_gen::scan_x86_masks."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex": { "type": "string" }
                },
                "required": ["hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtGenScanX86MasksTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex_str = args
            .get("hex")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let cleaned: String = hex_str.chars().filter(|c| !c.is_whitespace()).collect();
        if cleaned.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex must have even length".into()));
        }
        let mut bytes = Vec::with_capacity(cleaned.len() / 2);
        let cb = cleaned.as_bytes();
        for i in (0..cb.len()).step_by(2) {
            let s = std::str::from_utf8(&cb[i..i + 2])
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            let b = u8::from_str_radix(s, 16)
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            bytes.push(b);
        }
        let ranges = rustre_flirt_gen::scan_x86_masks(&bytes);
        let ranges_json: Vec<_> = ranges
            .iter()
            .map(|(off, sz)| json!({ "offset": off, "size": sz }))
            .collect();
        Ok(ToolResult::text(
            json!({
                "count": ranges.len(),
                "ranges": ranges_json,
                "bytes_len": bytes.len(),
                "source": "rustre_flirt_gen::scan_x86_masks",
            })
            .to_string(),
        ))
    }
}

/// Compute the IDA .sig-header CRC-16 (poly 0x8005, non-reflected) via
/// `rustre_flirt_gen::crc16_sig_header`.
pub struct FlirtGenCrc16SigHeaderTool;

impl FlirtGenCrc16SigHeaderTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_gen_crc16_sig_header".to_string(),
            description:
                "Compute IDA .sig header CRC-16 (poly 0x8005, non-reflected) via \
                 rustre_flirt_gen::crc16_sig_header."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex": { "type": "string" }
                },
                "required": ["hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtGenCrc16SigHeaderTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex_str = args
            .get("hex")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let cleaned: String = hex_str.chars().filter(|c| !c.is_whitespace()).collect();
        if cleaned.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex must have even length".into()));
        }
        let mut bytes = Vec::with_capacity(cleaned.len() / 2);
        let cb = cleaned.as_bytes();
        for i in (0..cb.len()).step_by(2) {
            let s = std::str::from_utf8(&cb[i..i + 2])
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            let b = u8::from_str_radix(s, 16)
                .map_err(|e| McpError::InvalidParams(e.to_string()))?;
            bytes.push(b);
        }
        let crc = rustre_flirt_gen::crc16_sig_header(&bytes);
        Ok(ToolResult::text(
            json!({
                "crc": crc,
                "crc_hex": format!("{:04x}", crc),
                "bytes_len": bytes.len(),
                "source": "rustre_flirt_gen::crc16_sig_header",
            })
            .to_string(),
        ))
    }
}

/// Parse an ELF relocatable object at `path` via
/// `rustre_flirt_gen::ElfObjectParser::parse` and report function count.
pub struct FlirtGenElfParseTool;

impl FlirtGenElfParseTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_gen_elf_parse".to_string(),
            description:
                "Parse an ELF .o file at `path` and report the number of \
                 STT_FUNC entries extracted via \
                 rustre_flirt_gen::ElfObjectParser::parse."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "path": { "type": "string" }
                },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtGenElfParseTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(|v| v.as_str())
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let bytes = std::fs::read(path)
            .map_err(|e| McpError::InvalidParams(format!("read {path}: {e}")))?;
        let funcs = rustre_flirt_gen::ElfObjectParser::parse(&bytes)
            .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        let names: Vec<&str> = funcs.iter().take(16).map(|(n, _, _)| n.as_str()).collect();
        Ok(ToolResult::text(
            json!({
                "function_count": funcs.len(),
                "sample_names": names,
                "bytes_read": bytes.len(),
                "source": "rustre_flirt_gen::ElfObjectParser::parse",
            })
            .to_string(),
        ))
    }
}

