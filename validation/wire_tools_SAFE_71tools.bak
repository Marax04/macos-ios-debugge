        let var = args.get("var").and_then(Value::as_str).unwrap_or("v");
        let ty = args.get("ty").and_then(Value::as_str).unwrap_or("int*");
        let rc = args.get("rhs_const").and_then(Value::as_bool).unwrap_or(true);
