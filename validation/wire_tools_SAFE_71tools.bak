            description: "Encode a (table_id, row_index) pair into a CLI metadata token.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["table", "row"],
                "properties": {
                    "table": { "type": "integer", "description": "Table tag (u8)" },
                    "row": { "type": "integer", "description": "Row index (u32)" }
                }
            }),
            parameters: Value::Null,
        }
    }
