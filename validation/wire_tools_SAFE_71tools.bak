pub struct MemKx7BytePatternMatchesAtTool;
impl MemKx7BytePatternMatchesAtTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_bytepattern_matches_at".to_string(), description: "rustre_mem::BytePattern::matches_at against hex data.".to_string(), input_schema: json!({"type":"object","required":["pattern","hex"],"properties":{"pattern":{"type":"string"},"hex":{"type":"string"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7BytePatternMatchesAtTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let p = args.get("pattern").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'pattern'".into()))?; let data = __mem_hex_decode_v2(args.get("hex").and_then(Value::as_str).unwrap_or("")); let bp = rustre_mem::BytePattern::parse(p).map_err(McpError::InternalError)?; if data.len() < bp.len() { return Ok(ToolResult::text(json!({"matches":false,"reason":"data shorter than pattern","source":"rustre_mem::BytePattern::matches_at"}).to_string())); } Ok(ToolResult::text(json!({"matches":bp.matches_at(&data),"source":"rustre_mem::BytePattern::matches_at"}).to_string())) } }

