/// Create a pre-configured x86-64 UnicornEmu (stack + heap) and report basics.
pub struct EmuUnicornNewX8664Tool;

impl EmuUnicornNewX8664Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_unicorn_new_x86_64".to_string(),
            description: "Instantiate a preconfigured x86-64 UnicornEmu (stack+heap) and return arch/regions summary.".to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuUnicornNewX8664Tool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let emu = rustre_emu_unicorn::new_x86_64_emu()
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        let regions: Vec<Value> = emu.list_regions().iter().map(|r| json!({
            "base": r.base,
            "size": r.size,
            "perm": r.perm.0,
            "label": r.label,
        })).collect();
        Ok(ToolResult::text(json!({
            "arch": "x86_64",
            "hook_count": emu.hook_count(),
            "regions": regions,
        }).to_string()))
    }
}

