        let instrs = b.build();
        let opcodes: Vec<String> = instrs.iter().map(|i| i.opcode.clone()).collect();
        Ok(ToolResult::text(json!({"opcodes":opcodes,"source":"rustre_dotnet_edit::IlBuilder::ret"}).to_string()))
    }
}
