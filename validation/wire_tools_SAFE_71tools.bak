/// Parse a .NET `FieldSig` blob (hex-encoded) into a type-name string.
pub struct DotnetMetadataParseFieldSigBlobTool;

impl DotnetMetadataParseFieldSigBlobTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_metadata_parse_field_sig_blob".to_string(),
            description:
                "Parse a .NET FieldSig blob (hex-encoded) via \
                 rustre_dotnet_metadata::parse_field_sig_blob."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "blob_hex": { "type": "string" } },
                "required": ["blob_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetMetadataParseFieldSigBlobTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("blob_hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'blob_hex'".to_string()))?;
        let bytes = libfuzzer_hex_str_to_bytes(hex)?;
        let ty = rustre_dotnet_metadata::parse_field_sig_blob(&bytes)
            .map_err(|e| McpError::InternalError(format!("parse_field_sig_blob: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "type_name": ty,
                "source": "rustre_dotnet_metadata::parse_field_sig_blob",
            })
            .to_string(),
        ))
    }
}

