/// Decode a `MethodDef.Flags` raw u32 via `rustre_dotnet::MethodFlags`.
pub struct DotnetMethodFlagsDecodeTool;

impl DotnetMethodFlagsDecodeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_method_flags_decode".to_string(),
            description:
                "Decode a raw CLR MethodDef.Flags u32 into access / static / \
                 virtual / abstract / sealed / pinvoke / ctor booleans via \
                 rustre_dotnet::MethodFlags."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "flags": { "type": "integer", "description": "raw MethodDef.Flags" }
                },
                "required": ["flags"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetMethodFlagsDecodeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let raw = args
            .get("flags")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'flags'".to_string()))?;
        let raw_u32 = u32::try_from(raw)
            .map_err(|_| McpError::InvalidParams("flags out of u32 range".to_string()))?;
        let f = rustre_dotnet::MethodFlags::from_raw(raw_u32);
        Ok(ToolResult::text(
            json!({
                "raw": raw_u32,
                "access": f.access_modifier(),
                "is_public": f.is_public(),
                "is_static": f.is_static(),
                "is_virtual": f.is_virtual(),
                "is_abstract": f.is_abstract(),
                "is_sealed": f.is_sealed(),
                "is_special_name": f.is_special_name(),
                "is_rt_special_name": f.is_rt_special_name(),
                "is_pinvoke": f.is_pinvoke(),
                "is_constructor": f.is_constructor(),
                "source": "rustre_dotnet::MethodFlags",
            })
            .to_string(),
        ))
    }
}

/// Build a synthetic no-operand CIL instruction via
/// `rustre_dotnet::CilInstruction::simple` and report its metadata.
pub struct DotnetCilSimpleInstrTool;

impl DotnetCilSimpleInstrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_cil_simple_instr".to_string(),
            description:
                "Construct a no-operand CIL instruction at a given offset and \
                 report its opcode / size / branch / terminator kind via \
                 rustre_dotnet::CilInstruction."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "offset": { "type": "integer" },
                    "opcode": { "type": "string" }
                },
                "required": ["opcode"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetCilSimpleInstrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let offset = args.get("offset").and_then(Value::as_u64).unwrap_or(0);
        let offset_u32 = u32::try_from(offset)
            .map_err(|_| McpError::InvalidParams("offset out of u32 range".to_string()))?;
        let opcode = args
            .get("opcode")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'opcode'".to_string()))?;
        let instr = rustre_dotnet::CilInstruction::simple(offset_u32, opcode);
        Ok(ToolResult::text(
            json!({
                "display": instr.to_string(),
                "offset": instr.offset,
                "opcode": instr.opcode,
                "byte_size": instr.byte_size(),
                "is_branch": instr.is_branch(),
                "is_unconditional_branch": instr.is_unconditional_branch(),
                "is_terminator": instr.is_terminator(),
                "branch_targets": instr.branch_targets(),
                "source": "rustre_dotnet::CilInstruction::simple",
            })
            .to_string(),
        ))
    }
}

/// Expose `rustre_mem::diff::diff_bytes` as an MCP tool.
pub struct MemDiffBytesTool;

impl MemDiffBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mem_diff_bytes".to_string(),
            description: "Diff two byte buffers starting at base_addr and return the changed spans (rustre_mem::diff::diff_bytes).".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["a_hex", "b_hex"],
                "properties": {
                    "base_addr": { "type": "integer" },
                    "a_hex": { "type": "string" },
                    "b_hex": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MemDiffBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let base_addr = args.get("base_addr").and_then(Value::as_u64).unwrap_or(0);
        let a_hex = args.get("a_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'a_hex'".into()))?;
        let b_hex = args.get("b_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'b_hex'".into()))?;
        let a = crate::hex_decode(a_hex.trim())?;
        let b = crate::hex_decode(b_hex.trim())?;
        let spans = rustre_mem::diff::diff_bytes(rustre_core::address::Address::new(base_addr), &a, &b);
        let items: Vec<Value> = spans.iter().map(|s| json!({
            "start": s.range.start.as_u64(),
            "end": s.range.end.as_u64(),
            "len": s.len(),
            "changed_bytes": s.changed_byte_count(),
        })).collect();
        Ok(ToolResult::text(
            json!({ "count": items.len(), "spans": items, "source": "rustre_mem::diff::diff_bytes" }).to_string(),
        ))
    }
}

/// Expose `rustre_mem::entropy::high_entropy_spans` as an MCP tool.
pub struct MemHighEntropySpansTool;

impl MemHighEntropySpansTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mem_high_entropy_spans".to_string(),
            description: "Compute per-block Shannon entropy of a hex buffer and return contiguous spans with entropy >= threshold (rustre_mem::entropy::high_entropy_spans).".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "hex": { "type": "string" },
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "base_addr": { "type": "integer" },
                    "block_size": { "type": "integer", "description": "Bytes per block (default 256)" },
                    "threshold": { "type": "number", "description": "Entropy threshold, default 7.0" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MemHighEntropySpansTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let base_addr = args.get("base_addr").and_then(Value::as_u64).unwrap_or(0);
        let block_size = args.get("block_size").and_then(Value::as_u64).unwrap_or(256).max(1) as usize;
        let threshold = args.get("threshold").and_then(Value::as_f64).unwrap_or(7.0);

        let mut blocks: Vec<rustre_mem::entropy::EntropyBlock> = Vec::new();
        let base = rustre_core::address::Address::new(base_addr);
        let mut offset = 0usize;
        while offset < data.len() {
            let end = (offset + block_size).min(data.len());
            let slice = &data[offset..end];
            blocks.push(rustre_mem::entropy::EntropyBlock {
                address: base + offset as u64,
                size: slice.len(),
                entropy: rustre_mem::entropy::shannon_entropy(slice),
            });
            offset = end;
        }

        let spans = rustre_mem::entropy::high_entropy_spans(&blocks, threshold);
        let items: Vec<Value> = spans.iter().map(|s| json!({
            "start": s.start.as_u64(),
            "end": s.end.as_u64(),
            "len": s.len(),
            "mean_entropy": s.mean_entropy,
            "block_count": s.block_count,
        })).collect();
        Ok(ToolResult::text(
            json!({
                "block_count": blocks.len(),
                "span_count": items.len(),
                "spans": items,
                "source": "rustre_mem::entropy::high_entropy_spans",
            }).to_string(),
        ))
    }
}

/// Wrapper that publishes a `CoreEvent::Custom` on a fresh `EventBus`.
pub struct EventsBusPublishCustomTool;

impl EventsBusPublishCustomTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "events_bus_publish_custom".to_string(),
            description: "Publish a Custom CoreEvent on a fresh EventBus and \
                          return the variant name plus total sent counter."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "event_type": { "type": "string" },
                    "payload":    {}
                },
                "required": ["event_type"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EventsBusPublishCustomTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let event_type = args
            .get("event_type")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("event_type: required".to_string()))?
            .to_string();
        let payload = args.get("payload").cloned().unwrap_or(Value::Null);
        let bus = rustre_events::EventBus::new_default();
        let _rx = bus.subscribe();
        let event = rustre_events::CoreEvent::Custom {
            event_type: event_type.clone(),
            payload,
        };
        let variant = event.variant_name();
        let _ = bus.send(event);
        Ok(ToolResult::text(
            json!({
                "variant": variant,
                "event_type": event_type,
                "total_sent": bus.total_sent(),
                "receivers": bus.receiver_count(),
                "source": "rustre_events::EventBus::send",
            })
            .to_string(),
        ))
    }
}

/// Wrapper that classifies a variant name into its coarse `EventKind`.
pub struct EventsClassifyVariantTool;

impl EventsClassifyVariantTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "events_classify_variant".to_string(),
            description: "Classify a CoreEvent variant name into its coarse EventKind."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "variant": { "type": "string" }
                },
                "required": ["variant"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EventsClassifyVariantTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let variant = args
            .get("variant")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("variant: required".to_string()))?;
        let sample = match variant {
            "ViewOpened" => rustre_events::CoreEvent::ViewOpened {
                view_id: 0,
                uri: String::new(),
                arch: String::new(),
            },
            "ViewClosed" => rustre_events::CoreEvent::ViewClosed { view_id: 0 },
            "AnalysisStarted" => rustre_events::CoreEvent::AnalysisStarted {
                view_id: 0,
                pass: String::new(),
            },
            "AnalysisCompleted" => rustre_events::CoreEvent::AnalysisCompleted {
                view_id: 0,
                pass: String::new(),
            },
            "FunctionDefined" => rustre_events::CoreEvent::FunctionDefined {
                view_id: 0,
                address: 0,
                name: String::new(),
            },
            "BreakpointHit" => rustre_events::CoreEvent::BreakpointHit {
                view_id: 0,
                address: 0,
                thread_id: 0,
            },
            "PluginLoaded" => rustre_events::CoreEvent::PluginLoaded {
                plugin_id: String::new(),
            },
            _ => rustre_events::CoreEvent::Custom {
                event_type: variant.to_string(),
                payload: Value::Null,
            },
        };
        let kind = sample.kind();
        Ok(ToolResult::text(
            json!({
                "variant": sample.variant_name(),
                "kind": format!("{:?}", kind),
                "is_debug": sample.is_debug_event(),
                "is_analysis": sample.is_analysis_event(),
                "is_function": sample.is_function_event(),
                "source": "rustre_events::CoreEvent::kind",
            })
            .to_string(),
        ))
    }
}

