/// Parse the `(check-sat)` result line of an SMT-LIB2 solver output.
pub struct SymbZ3ParseCheckSatTool;

impl SymbZ3ParseCheckSatTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symb_z3_parse_check_sat".to_string(),
            description:
                "Parse an SMT-LIB2 solver output string and return the check-sat verdict \
                 (sat / unsat / unknown), using rustre_symb_z3::SmtLib2Parser."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "output": { "type": "string" }
                },
                "required": ["output"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbZ3ParseCheckSatTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let output = args
            .get("output")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'output'".to_string()))?;
        let result = rustre_symb_z3::SmtLib2Parser::parse_check_sat(output);
        let (verdict, detail) = match &result {
            rustre_symb_z3::SolverResult::Sat => ("sat", String::new()),
            rustre_symb_z3::SolverResult::Unsat => ("unsat", String::new()),
            rustre_symb_z3::SolverResult::Unknown(s) => ("unknown", s.clone()),
        };
        Ok(ToolResult::text(
            json!({
                "verdict": verdict,
                "detail": detail,
                "source": "rustre_symb_z3::SmtLib2Parser::parse_check_sat",
            })
            .to_string(),
        ))
    }
}

/// Parse an SMT-LIB2 model into a `{ variable_name Ã¢â€ â€™ bitvector_value }` map.
