        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let off = args.get("checksum_offset").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'checksum_offset'".into()))? as usize;
        let bytes: Vec<u8> = (0..hex.len()).step_by(2)
            .filter_map(|i| hex.get(i..i+2).and_then(|s| u8::from_str_radix(s, 16).ok()))
            .collect();
        let cs = rustre_pe_rebuild::pe_reconstructor::calculate_pe_checksum(&bytes, off);
        Ok(ToolResult::text(json!({
            "checksum": cs,
            "bytes": bytes.len(),
        }).to_string()))
    }
}

