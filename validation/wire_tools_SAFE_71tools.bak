// -- il-lift o1 wrappers (20 new) --

fn _il_o1_mk_instr() -> rustre_core::arch::Instruction {
    rustre_core::arch::Instruction::new(rustre_core::Address::new(0x1000), 1_usize, "nop", vec![0x90])
}
fn _il_o1_mk_lifted(addr: u64) -> rustre_il_lift::LiftedInstr {
    rustre_il_lift::LiftedInstr { address: addr, original_mnemonic: "nop".to_string(), ir_text: "nop".to_string(), il_level: rustre_il_lift::LiftLevel::Llil, effects: Vec::new() }
}

