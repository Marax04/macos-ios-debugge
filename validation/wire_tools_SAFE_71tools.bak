/// Compute Shannon entropy (f64, 0.0-8.0) of raw bytes.
pub struct TriageEntropyShannonBytesTool;

impl TriageEntropyShannonBytesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "triage_entropy_shannon_bytes".to_string(),
            description:
                "Compute Shannon entropy (0.0-8.0, f64) over raw bytes via \
                 rustre_triage_entropy::shannon_entropy."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TriageEntropyShannonBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = extract_byte_array(&args, "bytes", "hex")?;
        let h = rustre_triage_entropy::shannon_entropy(&data);
        Ok(ToolResult::text(
            json!({
                "entropy": h,
                "size": data.len(),
                "hex_preview": hex_encode(&data[..data.len().min(16)]),
                "source": "rustre_triage_entropy::shannon_entropy",
            })
            .to_string(),
        ))
    }
}

