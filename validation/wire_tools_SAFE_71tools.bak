pub struct AgentPromptsTemplateNewTool;

impl AgentPromptsTemplateNewTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "agent_prompts_template_new".to_string(),
            description: "Construct a rustre_agent_prompts::PromptTemplate and echo its name/variables.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "name":     { "type": "string" },
                    "template": { "type": "string" },
                    "variables": { "type": "array", "items": { "type": "string" } },
                    "system_prompt": { "type": "string" }
                },
                "required": ["name", "template"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AgentPromptsTemplateNewTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("name").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let template = args.get("template").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'template'".into()))?;
        let variables: Vec<String> = args.get("variables")
            .and_then(Value::as_array)
            .map(|a| a.iter().filter_map(|v| v.as_str().map(String::from)).collect())
            .unwrap_or_default();
        let system_prompt = args.get("system_prompt").and_then(Value::as_str).unwrap_or("");
        let tpl = rustre_agent_prompts::PromptTemplate::new(
            name.to_string(),
            template.to_string(),
            variables,
            system_prompt.to_string(),
        );
        Ok(ToolResult::text(
            json!({
                "name": tpl.name,
                "variables": tpl.variables,
                "template_len": tpl.template.len(),
                "source": "rustre_agent_prompts::PromptTemplate::new",
            })
            .to_string(),
        ))
    }
}

