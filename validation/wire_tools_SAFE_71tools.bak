        let (instr, size) = rustre_arch_jvm::JvmInstr::decode(&data)
            .map_err(|e| McpError::InvalidParams(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "mnemonic": instr.mnemonic,
                "operands": instr.operands,
                "size": size,
                "source_hex": hex_encode(&data),
            })
            .to_string(),
        ))
    }
}

/// Decode a single JVM bytecode instruction at a given pc offset via
