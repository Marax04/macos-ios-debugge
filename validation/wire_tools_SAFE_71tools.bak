/// Detect opaque predicates in a byte slice.
pub struct MhcdeOpaquePredicateDetectTool;

impl MhcdeOpaquePredicateDetectTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mhcde_opaque_predicate_detect".to_string(),
            description: "Detect opaque predicate patterns in x86 bytes via rustre_deobf_mhcde::OpaquePredicateDetector.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MhcdeOpaquePredicateDetectTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let detector = rustre_deobf_mhcde::OpaquePredicateDetector::new();
        let findings = detector.detect(&data);
        Ok(ToolResult::text(json!({
            "count": findings.len(),
            "findings": findings,
            "source": "rustre_deobf_mhcde::OpaquePredicateDetector::detect",
            "input_hex": hex_encode(&data),
        }).to_string()))
    }
}

/// Detect junk code regions in a byte slice.
pub struct MhcdeJunkCodeDetectTool;

impl MhcdeJunkCodeDetectTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mhcde_junk_code_detect".to_string(),
            description: "Detect semantic no-op / junk instruction sequences via rustre_deobf_mhcde::JunkCodeDetector.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MhcdeJunkCodeDetectTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let detector = rustre_deobf_mhcde::JunkCodeDetector::new();
        let regions = detector.detect(&data);
        let total_junk_bytes = detector.total_junk_bytes(&data);
        let density = detector.junk_density(&data);
        Ok(ToolResult::text(json!({
            "count": regions.len(),
            "total_junk_bytes": total_junk_bytes,
            "junk_density": density,
            "regions": regions,
            "source": "rustre_deobf_mhcde::JunkCodeDetector::detect",
        }).to_string()))
    }
}

/// Full MHCDE orchestrator analysis of a byte slice.
pub struct MhcdeOrchestratorAnalyzeTool;

impl MhcdeOrchestratorAnalyzeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mhcde_orchestrator_analyze".to_string(),
            description: "Run full MHCDE analysis (opaque predicates + junk + CFF + patch plan) via rustre_deobf_mhcde::MhcdeOrchestrator.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MhcdeOrchestratorAnalyzeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let orch = rustre_deobf_mhcde::MhcdeOrchestrator::new();
        let analysis = orch.analyze(&data);
        Ok(ToolResult::text(json!({
            "total_findings": analysis.total_findings(),
            "is_clean": analysis.is_clean(),
            "opaque_predicate_count": analysis.opaque_predicates.len(),
            "junk_region_count": analysis.junk_regions.len(),
            "has_cff": analysis.cff.is_some(),
            "patch_plan_len": analysis.patch_plan.len(),
            "score": analysis.score,
            "analysis": analysis,
            "source": "rustre_deobf_mhcde::MhcdeOrchestrator::analyze",
        }).to_string()))
    }
}

// --- additional rustre-deobf-mhcde wrappers ---

macro_rules! mhcde_bytes_tool {
    ($tool:ident, $name:literal, $desc:literal, $body:expr) => {
        pub struct $tool;
        impl $tool {
            #[must_use]
            pub fn definition() -> ToolDefinition {
                ToolDefinition {
                    name: $name.to_string(),
                    description: $desc.to_string(),
                    input_schema: json!({
                        "type": "object",
                        "properties": {
                            "bytes": { "type": "array", "items": { "type": "integer" } },
                            "hex":   { "type": "string" }
                        }
                    }),
                    parameters: Value::Null,
                }
            }
        }
        #[async_trait]
        impl ToolHandler for $tool {
            async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
                let data = args_to_bytes(&args)?;
                let f: fn(&[u8]) -> Value = $body;
                let v = f(&data);
                Ok(ToolResult::text(v.to_string()))
            }
        }
    };
}

mhcde_bytes_tool!(MhcdeOpaqueCountByTypeTool, "mhcde_opaque_count_by_type",
    "Count opaque predicates grouped by type via OpaquePredicateDetector::count_by_type.",
    |data| {
        let d = rustre_deobf_mhcde::OpaquePredicateDetector::new();
        let map = d.count_by_type(data);
        let counts: std::collections::BTreeMap<String, usize> =
            map.into_iter().map(|(k, v)| (format!("{:?}", k), v)).collect();
        json!({ "counts": counts, "source": "rustre_deobf_mhcde::OpaquePredicateDetector::count_by_type" })
    });

mhcde_bytes_tool!(MhcdeOpaqueTotalPatchBytesTool, "mhcde_opaque_total_patch_bytes",
    "Total patch bytes for detected opaque predicates via OpaquePredicateDetector::total_patch_bytes.",
    |data| {
        let d = rustre_deobf_mhcde::OpaquePredicateDetector::new();
        json!({ "total_patch_bytes": d.total_patch_bytes(data), "source": "rustre_deobf_mhcde::OpaquePredicateDetector::total_patch_bytes" })
    });

mhcde_bytes_tool!(MhcdeJunkTotalBytesTool, "mhcde_junk_total_bytes",
    "Total junk bytes via JunkCodeDetector::total_junk_bytes.",
    |data| {
        let d = rustre_deobf_mhcde::JunkCodeDetector::new();
        json!({ "total_junk_bytes": d.total_junk_bytes(data), "source": "rustre_deobf_mhcde::JunkCodeDetector::total_junk_bytes" })
    });

mhcde_bytes_tool!(MhcdeJunkDensityTool, "mhcde_junk_density",
    "Junk instruction density via JunkCodeDetector::junk_density.",
    |data| {
        let d = rustre_deobf_mhcde::JunkCodeDetector::new();
        json!({ "junk_density": d.junk_density(data), "source": "rustre_deobf_mhcde::JunkCodeDetector::junk_density" })
    });

mhcde_bytes_tool!(MhcdeCffDetectTool, "mhcde_cff_detect",
    "Detect control-flow flattening via ControlFlowFlattener::detect.",
    |data| {
        let d = rustre_deobf_mhcde::ControlFlowFlattener::new();
        let r = d.detect(data);
        json!({ "detected": r.is_some(), "result": r, "source": "rustre_deobf_mhcde::ControlFlowFlattener::detect" })
    });

mhcde_bytes_tool!(MhcdeEntropyMeanTool, "mhcde_entropy_mean",
    "Mean Shannon entropy over sliding windows via EntropyAnalyzer::mean_entropy.",
    |data| {
        let a = rustre_deobf_mhcde::EntropyAnalyzer::new(64);
        json!({ "mean_entropy": a.mean_entropy(data), "source": "rustre_deobf_mhcde::EntropyAnalyzer::mean_entropy" })
    });

mhcde_bytes_tool!(MhcdeEntropyShannonTool, "mhcde_entropy_shannon",
    "Shannon entropy of a byte slice via EntropyAnalyzer::entropy.",
    |data| {
        json!({ "entropy": rustre_deobf_mhcde::EntropyAnalyzer::entropy(data), "source": "rustre_deobf_mhcde::EntropyAnalyzer::entropy" })
    });

mhcde_bytes_tool!(MhcdeEntropyAnalyzeTool, "mhcde_entropy_analyze",
    "Per-window entropy analysis via EntropyAnalyzer::analyze (window=64).",
    |data| {
        let a = rustre_deobf_mhcde::EntropyAnalyzer::new(64);
        let w = a.analyze(data);
        json!({ "count": w.len(), "windows": w, "source": "rustre_deobf_mhcde::EntropyAnalyzer::analyze" })
    });

mhcde_bytes_tool!(MhcdeAnalyzeAndPatchTool, "mhcde_analyze_and_patch",
    "Full analyze + apply patches via MhcdeOrchestrator::analyze_and_patch (returns patched hex).",
    |data| {
        let o = rustre_deobf_mhcde::MhcdeOrchestrator::new();
        let (patched, a) = o.analyze_and_patch(data);
        json!({
            "patched_hex": hex_encode(&patched),
            "patched_len": patched.len(),
            "total_findings": a.total_findings(),
            "is_clean": a.is_clean(),
            "patch_offsets": a.patch_offsets(),
            "source": "rustre_deobf_mhcde::MhcdeOrchestrator::analyze_and_patch"
        })
    });

mhcde_bytes_tool!(MhcdeScoreModelNaturalnessTool, "mhcde_score_model_naturalness",
    "Naturalness score of a byte slice via ScoreModel::naturalness_score.",
    |data| {
        json!({ "naturalness": rustre_deobf_mhcde::ScoreModel::naturalness_score(data), "source": "rustre_deobf_mhcde::ScoreModel::naturalness_score" })
    });

mhcde_bytes_tool!(MhcdePassAnalyzeTool, "mhcde_pass_analyze",
    "Run MhcdePass::analyze on a byte slice (analysis pipeline).",
    |data| {
        let p = rustre_deobf_mhcde::MhcdePass::new();
        let a = p.analyze(data);
        json!({
            "total_findings": a.total_findings(),
            "is_clean": a.is_clean(),
            "opaque_predicate_count": a.opaque_predicates.len(),
            "junk_region_count": a.junk_regions.len(),
            "has_cff": a.cff.is_some(),
            "patch_plan_len": a.patch_plan.len(),
            "source": "rustre_deobf_mhcde::MhcdePass::analyze"
        })
    });

pub struct IadlConvergenceMovingAverageTool;

impl IadlConvergenceMovingAverageTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "iadl_convergence_moving_average".to_string(),
            description: "Moving average via rustre_deobf_iadl::convergence_detector::moving_average.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["history", "window"],
                "properties": {
                    "history": { "type": "array", "items": { "type": "number" } },
                    "window": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for IadlConvergenceMovingAverageTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let history: Vec<f64> = args.get("history").and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'history'".into()))?
            .iter().filter_map(Value::as_f64).collect();
        let window = args.get("window").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'window'".into()))? as usize;
        let out = rustre_deobf_iadl::convergence_detector::moving_average(&history, window);
        Ok(ToolResult::text(json!({ "moving_average": out }).to_string()))
    }
}

