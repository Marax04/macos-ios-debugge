pub struct AdbEncodeMessageTool;

impl AdbEncodeMessageTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_encode_message".to_string(),
            description: "Encode an ADB wire-protocol message (command, arg0, arg1, hex data) into a hex-encoded 24-byte header + payload."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["command", "arg0", "arg1", "data_hex"],
                "properties": {
                    "command": { "type": "integer", "description": "ADB command u32" },
                    "arg0":    { "type": "integer", "description": "arg0 u32" },
                    "arg1":    { "type": "integer", "description": "arg1 u32" },
                    "data_hex":{ "type": "string",  "description": "Hex-encoded payload bytes" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbEncodeMessageTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let command = args.get("command").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'command'".into()))? as u32;
        let arg0 = args.get("arg0").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'arg0'".into()))? as u32;
        let arg1 = args.get("arg1").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'arg1'".into()))? as u32;
        let hex = args.get("data_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'data_hex'".into()))?;
        let clean: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
        if clean.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex length must be even".into()));
        }
        let mut data = Vec::with_capacity(clean.len() / 2);
        for i in (0..clean.len()).step_by(2) {
            data.push(u8::from_str_radix(&clean[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))?);
        }
        let encoded = rustre_adb::encode_message(command, arg0, arg1, &data);
        let hex_out: String = encoded.iter().map(|b| format!("{:02x}", b)).collect();
        Ok(ToolResult::text(
            json!({ "len": encoded.len(), "hex": hex_out }).to_string(),
        ))
    }
}

pub struct AdbDecodeMessageTool;

impl AdbDecodeMessageTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_decode_message".to_string(),
            description: "Decode an ADB wire-protocol message from hex-encoded bytes (24-byte header + payload)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": {
                    "hex": { "type": "string", "description": "Hex-encoded raw ADB message" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbDecodeMessageTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let clean: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
        if clean.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex length must be even".into()));
        }
        let mut raw = Vec::with_capacity(clean.len() / 2);
        for i in (0..clean.len()).step_by(2) {
            raw.push(u8::from_str_radix(&clean[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))?);
        }
        let msg = rustre_adb::decode_message(&raw)
            .map_err(|e| McpError::InvalidParams(format!("decode failed: {e}")))?;
        let data_hex: String = msg.data.iter().map(|b| format!("{:02x}", b)).collect();
        Ok(ToolResult::text(json!({
            "command": msg.command,
            "command_name": msg.command_name(),
            "arg0": msg.arg0,
            "arg1": msg.arg1,
            "crc32": msg.crc32,
            "magic": msg.magic,
            "crc_valid": msg.verify_crc(),
            "data_hex": data_hex,
        }).to_string()))
    }
}

