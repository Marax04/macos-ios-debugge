    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_sighting_is_false_positive".to_string(),
            description:
                "Construct a rustre_ti_misp::MispSighting for a given attribute UUID and sighting_type, then return whether MispSighting::is_false_positive holds."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "attribute_uuid": { "type": "string" },
                    "sighting_type": { "type": "integer", "minimum": 0, "maximum": 255 }
                },
                "required": ["attribute_uuid", "sighting_type"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispSightingIsFalsePositiveTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let attribute_uuid = args
            .get("attribute_uuid")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing attribute_uuid".to_string()))?;
        let sighting_type = args
            .get("sighting_type")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing sighting_type".to_string()))?
            as u8;
        let s = rustre_ti_misp::MispSighting::new(attribute_uuid.to_string(), sighting_type);
        Ok(ToolResult::text(
            json!({
                "attribute_uuid": s.attribute_uuid,
                "sighting_type": s.sighting_type,
                "is_false_positive": s.is_false_positive(),
                "source": "rustre_ti_misp::MispSighting::is_false_positive",
            })
            .to_string(),
        ))
    }
}

pub struct TiMispEventSpecHasIdsAttributesTool;

impl TiMispEventSpecHasIdsAttributesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_event_spec_has_ids_attributes".to_string(),
            description:
                "Build a rustre_ti_misp::MispEventSpec from attribute entries and return has_ids_attributes."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "attributes": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "type_field": { "type": "string" },
                                "value": { "type": "string" },
                                "to_ids": { "type": "boolean" }
                            },
                            "required": ["type_field", "value", "to_ids"]
                        }
                    }
                },
                "required": ["attributes"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispEventSpecHasIdsAttributesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let attrs = args
            .get("attributes")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing attributes".to_string()))?;
        let mut attributes = Vec::with_capacity(attrs.len());
        for (i, a) in attrs.iter().enumerate() {
            let type_field = a
                .get("type_field")
                .and_then(Value::as_str)
                .ok_or_else(|| McpError::InvalidParams(format!("attributes[{i}].type_field")))?;
            let value = a
                .get("value")
                .and_then(Value::as_str)
                .ok_or_else(|| McpError::InvalidParams(format!("attributes[{i}].value")))?;
            let to_ids = a
                .get("to_ids")
                .and_then(Value::as_bool)
                .ok_or_else(|| McpError::InvalidParams(format!("attributes[{i}].to_ids")))?;
            attributes.push(rustre_ti_misp::MispAttributeSpec {
                id: (i as u64) + 1,
                type_field: type_field.to_string(),
                value: value.to_string(),
                comment: None,
                to_ids,
            });
        }
        let event = rustre_ti_misp::MispEventSpec {
            id: 1,
            uuid: "00000000-0000-4000-8000-000000000000".to_string(),
            info: "wire".to_string(),
            date: "2024-01-01".to_string(),
            threat_level_id: 4,
            attributes,
            tags: vec![],
        };
        Ok(ToolResult::text(
            json!({
                "attribute_count": event.attributes.len(),
                "has_ids_attributes": event.has_ids_attributes(),
                "source": "rustre_ti_misp::MispEventSpec::has_ids_attributes",
            })
            .to_string(),
        ))
    }
}

