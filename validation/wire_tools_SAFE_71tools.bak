/// Discover a PDB file next to a given binary path.
pub struct SymbolsDiscoverPdbV2Tool;

impl SymbolsDiscoverPdbV2Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symbols_discover_pdb_for_binary".to_string(),
            description:
                "Locate a matching .pdb next to a binary (sibling, pdb/ subdir). \
                 Wraps rustre_symbols::discover_pdb_for_binary."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "binary_path": { "type": "string" } },
                "required": ["binary_path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbolsDiscoverPdbV2Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let bp = args
            .get("binary_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'binary_path'".to_string()))?;
        let path = std::path::Path::new(bp);
        let found = rustre_symbols::discover_pdb_for_binary(path, None);
        Ok(ToolResult::text(
            json!({
                "binary_path": bp,
                "pdb_path": found.as_ref().map(|p| p.display().to_string()),
                "found": found.is_some(),
                "source": "rustre_symbols::discover_pdb_for_binary",
            })
            .to_string(),
        ))
    }
}

