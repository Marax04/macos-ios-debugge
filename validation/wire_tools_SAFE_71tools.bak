/// Parse a pipe-delimited alternation pattern and report count / lengths.
pub struct HexPatternAlternationParseTool;

impl HexPatternAlternationParseTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_pattern_alternation_parse".to_string(),
            description:
                "Parse a pipe-delimited pattern (e.g. 'DE AD | BE EF') via \
                 rustre_hex_pattern::AlternationPattern::parse and report the \
                 alternative count and each alternative length."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "pattern": { "type": "string" }
                },
                "required": ["pattern"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexPatternAlternationParseTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args
            .get("pattern")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'pattern' string".into()))?;
        let alt = rustre_hex_pattern::AlternationPattern::parse(s)
            .map_err(|e| McpError::InvalidParams(format!("parse error: {e}")))?;
        let lens: Vec<usize> = alt.alternatives.iter().map(|p| p.len()).collect();
        Ok(ToolResult::text(
            json!({
                "count": alt.len(),
                "is_empty": alt.is_empty(),
                "alternative_lens": lens,
                "source": "rustre_hex_pattern::AlternationPattern::parse",
            })
            .to_string(),
        ))
    }
}

/// Build a MaskedPattern from a pattern string and return bytes/mask hex.
pub struct HexPatternMaskedFromStrTool;

impl HexPatternMaskedFromStrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_pattern_masked_from_str".to_string(),
            description:
                "Parse a pattern string then convert into a MaskedPattern via \
                 rustre_hex_pattern::MaskedPattern::from_pattern; return the \
                 bytes and mask arrays in hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "pattern": { "type": "string" }
                },
                "required": ["pattern"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexPatternMaskedFromStrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args
            .get("pattern")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'pattern' string".into()))?;
        let pat = rustre_hex_pattern::Pattern::parse(s)
            .map_err(|e| McpError::InvalidParams(format!("parse error: {e}")))?;
        let masked = rustre_hex_pattern::MaskedPattern::from_pattern(&pat);
        Ok(ToolResult::text(
            json!({
                "len": masked.len(),
                "bytes_hex": hex_encode(&masked.bytes),
                "mask_hex":  hex_encode(&masked.mask),
                "source": "rustre_hex_pattern::MaskedPattern::from_pattern",
            })
            .to_string(),
        ))
    }
}

