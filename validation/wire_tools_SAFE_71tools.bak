// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-trace-navigate Ã¢â‚¬â€ TraceEntry::insn Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Build a basic instruction `TraceEntry` via `TraceEntry::insn` and return
/// its `Display` form plus key fields.
pub struct TraceNavigateInsnEntryTool;

impl TraceNavigateInsnEntryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_navigate_insn_entry".to_string(),
            description:
                "Construct a basic instruction TraceEntry via \
                 rustre_trace_navigate::TraceEntry::insn and return its \
                 rendered form."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "idx":    { "type": "integer" },
                    "pc":     { "type": "integer" },
                    "tid":    { "type": "integer" },
                    "disasm": { "type": "string"  }
                },
                "required": ["idx", "pc", "tid", "disasm"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceNavigateInsnEntryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let idx = args.get("idx").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'idx'".into()))?
            as usize;
        let pc = args.get("pc").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'pc'".into()))?;
        let tid = args.get("tid").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'tid'".into()))?;
        let tid_u32 = u32::try_from(tid)
            .map_err(|_| McpError::InvalidParams("tid exceeds u32".into()))?;
        let disasm = args.get("disasm").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'disasm'".into()))?
            .to_string();
        let entry = rustre_trace_navigate::TraceEntry::insn(idx, pc, tid_u32, disasm);
        Ok(ToolResult::text(
            json!({
                "display": format!("{entry}"),
                "idx": entry.idx,
                "pc": entry.pc,
                "tid": entry.tid,
                "disasm": entry.disasm,
                "is_call": entry.is_call(),
                "is_ret": entry.is_ret(),
                "source": "rustre_trace_navigate::TraceEntry::insn",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-trace-coverage wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Parse an LCOV info file text and report record/line/function totals.
pub struct TraceCovParseLcovTool;

impl TraceCovParseLcovTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_cov_parse_lcov".to_string(),
            description:
                "Parse an LCOV info file via rustre_trace_coverage::parse_lcov and report \
                 the number of records plus aggregated lines_found/lines_hit/functions_found/\
                 functions_hit across all records."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string",
                        "description": "LCOV info file contents"
                    }
                },
                "required": ["text"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceCovParseLcovTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let text = args
            .get("text")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'text' string".into()))?;
        let records = rustre_trace_coverage::parse_lcov(text);
        let lines_found: u64 = records.iter().map(|r| r.lines_found).sum();
        let lines_hit: u64 = records.iter().map(|r| r.lines_hit).sum();
        let functions_found: u64 = records.iter().map(|r| r.functions_found).sum();
        let functions_hit: u64 = records.iter().map(|r| r.functions_hit).sum();
        Ok(ToolResult::text(
            json!({
                "records": records.len(),
                "lines_found": lines_found,
                "lines_hit": lines_hit,
                "functions_found": functions_found,
                "functions_hit": functions_hit,
                "source": "rustre_trace_coverage::parse_lcov",
            })
            .to_string(),
        ))
    }
}

/// Construct a zeroed `CovBitmap` of the given size and report its shape.
pub struct TraceCovBitmapNewTool;

impl TraceCovBitmapNewTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "trace_cov_bitmap_new".to_string(),
            description:
                "Construct a zeroed rustre_trace_coverage::CovBitmap of the given bit size and \
                 report its logical size, byte length, count_set, and is_empty."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "size": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Number of bits"
                    }
                },
                "required": ["size"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TraceCovBitmapNewTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let size = args
            .get("size")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'size' unsigned integer".into()))?;
        let size_usize = usize::try_from(size)
            .map_err(|_| McpError::InvalidParams("size exceeds usize".into()))?;
        let bm = rustre_trace_coverage::CovBitmap::new(size_usize);
        Ok(ToolResult::text(
            json!({
                "size": bm.size,
                "bytes": bm.bits.len(),
                "count_set": bm.count_set(),
                "is_empty": bm.is_empty(),
                "source": "rustre_trace_coverage::CovBitmap::new",
            })
            .to_string(),
        ))
    }
}

