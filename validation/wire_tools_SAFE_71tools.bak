pub struct MemKx7SnapshotDiffJsonRoundtripTool;
impl MemKx7SnapshotDiffJsonRoundtripTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "mem_kx7_snapshotdiff_json_roundtrip".to_string(), description: "diff_memory then to_json / from_json roundtrip.".to_string(), input_schema: json!({"type":"object","required":["a_hex","b_hex"],"properties":{"a_hex":{"type":"string"},"b_hex":{"type":"string"}}}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for MemKx7SnapshotDiffJsonRoundtripTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let a = __mem_hex_decode_v2(args.get("a_hex").and_then(Value::as_str).unwrap_or("")); let b = __mem_hex_decode_v2(args.get("b_hex").and_then(Value::as_str).unwrap_or("")); if a.len() != b.len() { return Err(McpError::InternalError("a and b must have equal length".into())); } let d = rustre_mem::diff_memory(&a, &b, __mem_kx7_addr(0)); let js = d.to_json().map_err(|e| McpError::InternalError(e.to_string()))?; let parsed = rustre_mem::SnapshotDiff::from_json(&js).map_err(|e| McpError::InternalError(e.to_string()))?; Ok(ToolResult::text(json!({"regions":d.region_count(),"roundtrip_regions":parsed.region_count(),"json_len":js.len(),"source":"rustre_mem::SnapshotDiff::to_json"}).to_string())) } }

