/// Extract DWARF functions via gimli backend (supports ELF + Mach-O, DWARF 4/5).
pub struct DwarfGimliFunctionsPathTool;

impl DwarfGimliFunctionsPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dwarf_gimli_functions_path".to_string(),
            description: "Parse DWARF via gimli (ELF+Mach-O, DWARF 4/5) and return functions."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string" } },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DwarfGimliFunctionsPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let set = rustre_symbols_dwarf::load_dwarf_symbols(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("gimli load failed: {e}")))?;
        let payload = serde_json::to_value(&set.functions)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(json!({ "count": set.functions.len(), "functions": payload }).to_string()))
    }
}

