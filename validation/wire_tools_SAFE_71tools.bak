impl SymbolsV7DebugMergerFinishTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "symbols_v7_debug_merger_finish".to_string(), description: "DebugSymbolMerger merge two sets and finish sorted.".to_string(), input_schema: json!({"type":"object","properties":{"names":{"type":"array","items":{"type":"string"}}},"required":["names"]}), parameters: Value::Null } } }
#[async_trait] impl ToolHandler for SymbolsV7DebugMergerFinishTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let names = args.get("names").and_then(Value::as_array).ok_or_else(|| McpError::InvalidParams("names".into()))?; let mut m = rustre_symbols::DebugSymbolMerger::new(); let syms: Vec<rustre_symbols::Symbol> = names.iter().enumerate().filter_map(|(i, v)| v.as_str().map(|s| rustre_symbols::Symbol::new(s.to_string(), (i as u64) * 0x10 + 0x1000, rustre_symbols::SymKind::Function))).collect(); m.merge(syms.clone()); m.merge(syms); let ln = m.len(); let out = m.finish(); Ok(ToolResult::text(json!({"len":ln,"finished":out.len(),"first":out.first().map(|s| s.name.clone()),"source":"rustre_symbols::DebugSymbolMerger"}).to_string())) } }

