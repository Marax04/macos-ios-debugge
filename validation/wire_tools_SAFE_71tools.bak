// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ loader_pe_entry_points Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct LoaderPeEntryPointsTool;

impl LoaderPeEntryPointsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_pe_entry_points".to_string(),
            description:
                "Parse a PE file and return all entry points (AOEP, TLS callbacks, exports)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderPeEntryPointsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let data = std::fs::read(path)
            .map_err(|e| McpError::InternalError(format!("read {path}: {e}")))?;
        let pe = rustre_loader_pe::PeInfo::parse(&data)
            .map_err(|e| McpError::InternalError(format!("PeInfo::parse: {e}")))?;
        let eps: Vec<Value> = pe.entry_points().into_iter()
            .map(|(va, kind)| json!({ "va": va, "kind": kind }))
            .collect();
        Ok(ToolResult::text(json!({
            "path": path,
            "count": eps.len(),
            "entry_points": eps,
            "source": "rustre_loader_pe::PeInfo::entry_points",
        }).to_string()))
    }
}

