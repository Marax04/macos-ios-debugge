// ─── il-lift n5 wrappers (batch of 10) ────────────────────────────────────────
fn _il_n5_mk_instr(addr: u64, mnem: &str) -> rustre_il_lift::LiftedInstr {
    rustre_il_lift::LiftedInstr {
        address: addr,
        original_mnemonic: mnem.to_string(),
        ir_text: format!("ir({mnem})"),
        il_level: rustre_il_lift::LiftLevel::Llil,
        effects: Vec::new(),
    }
}

