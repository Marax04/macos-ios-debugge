/// Byte-level n-gram Jaccard similarity.
pub struct DiffNgramJaccardSimilarityTool;

impl DiffNgramJaccardSimilarityTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_ngram_jaccard_similarity".to_string(),
            description:
                "Byte-level n-gram Jaccard similarity in 0.0..=1.0 via rustre_diff::ngram_jaccard_similarity."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "a": { "type": "array" },
                    "b": { "type": "array" },
                    "n": { "type": "integer", "minimum": 1, "maximum": 8, "default": 4 }
                },
                "required": ["a", "b"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffNgramJaccardSimilarityTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let a = array_to_bytes(&args, "a")?;
        let b = array_to_bytes(&args, "b")?;
        let n = usize::try_from(args.get("n").and_then(Value::as_u64).unwrap_or(4)).unwrap_or(4);
        let sim = rustre_diff::ngram_jaccard_similarity(&a, &b, n);
        Ok(ToolResult::text(
            json!({
                "similarity": sim,
                "n": n,
                "len_a": a.len(),
                "len_b": b.len(),
                "source": "rustre_diff::ngram_jaccard_similarity",
            })
            .to_string(),
        ))
    }
}

