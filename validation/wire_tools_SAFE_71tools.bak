// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ patch_compute_pe_checksum Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `rustre_patch::compute_pe_checksum` as an MCP tool.
pub struct PatchComputePeChecksumTool;

impl PatchComputePeChecksumTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_compute_pe_checksum".to_string(),
            description:
                "Compute the Microsoft PE image checksum (CheckSumMappedFile-equivalent) \
                 for the PE at `path`, treating the 4-byte CheckSum field at \
                 `checksum_offset` as zero."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path", "checksum_offset"],
                "properties": {
                    "path":            { "type": "string",  "description": "Absolute path to PE image" },
                    "checksum_offset": { "type": "integer", "description": "File offset of the 4-byte CheckSum field" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchComputePeChecksumTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let checksum_offset = args
            .get("checksum_offset")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'checksum_offset'".into()))?
            as usize;
        let image = std::fs::read(path)
            .map_err(|e| McpError::InternalError(format!("read {path}: {e}")))?;
        let checksum = rustre_patch::compute_pe_checksum(&image, checksum_offset);
        Ok(ToolResult::text(
            json!({
                "path":            path,
                "checksum_offset": checksum_offset,
                "image_size":      image.len(),
                "checksum":        checksum,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-pe-tools wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

