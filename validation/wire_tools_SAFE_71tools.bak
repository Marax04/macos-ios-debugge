pub struct DebugLinuxProcMapsParseLineTool;

impl DebugLinuxProcMapsParseLineTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "debug_linux_procmaps_parse_line".to_string(),
            description: "Parse a single /proc/<pid>/maps line via rustre_debug_linux::ProcMapsParser.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "line": { "type": "string" } },
                "required": ["line"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DebugLinuxProcMapsParseLineTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let line = args
            .get("line")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'line'".into()))?;
        let parsed = rustre_debug_linux::ProcMapsParser::parse_line(line);
        Ok(ToolResult::text(
            json!({
                "matched": parsed.is_some(),
                "base":    parsed.as_ref().map(|m| m.base.as_u64()),
                "size":    parsed.as_ref().map(|m| m.size),
                "readable":   parsed.as_ref().map(|m| m.readable),
                "writable":   parsed.as_ref().map(|m| m.writable),
                "executable": parsed.as_ref().map(|m| m.executable),
                "name":       parsed.as_ref().and_then(|m| m.name.clone()),
                "file_path":  parsed.as_ref().and_then(|m| m.file_path.clone()),
                "source":  "rustre_debug_linux::ProcMapsParser::parse_line",
            })
            .to_string(),
        ))
    }
}

