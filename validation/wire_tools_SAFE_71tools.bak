        let n = args
            .get("number")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'number'".into()))?;
        let n_u32 = u32::try_from(n)
            .map_err(|_| McpError::InvalidParams("number out of range".into()))?;
