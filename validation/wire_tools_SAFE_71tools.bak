// â”€â”€â”€ rustre-emu-unicorn extra wrappers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn parse_emu_unicorn_mode_v2(name: &str) -> Option<rustre_emu_unicorn::Mode> {
    use rustre_emu_unicorn::Mode;
    Some(match name {
        "X86_16" => Mode::X86_16, "X86_32" => Mode::X86_32, "X86_64" => Mode::X86_64,
        "ArmMode" => Mode::ArmMode, "ThumbMode" => Mode::ThumbMode, "Arm64Mode" => Mode::Arm64Mode,
        "Mips32LE" => Mode::Mips32LE, "Mips32BE" => Mode::Mips32BE,
        "Mips64LE" => Mode::Mips64LE, "Mips64BE" => Mode::Mips64BE,
        "Sparc32" => Mode::Sparc32, "Sparc64" => Mode::Sparc64,
        "RiscV32" => Mode::RiscV32, "RiscV64" => Mode::RiscV64,
        "M68K" => Mode::M68K, "Ppc32" => Mode::Ppc32, "Ppc64" => Mode::Ppc64, "S390X" => Mode::S390X,
        _ => return None,
    })
}

