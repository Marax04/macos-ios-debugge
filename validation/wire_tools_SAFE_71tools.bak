#[async_trait] impl ToolHandler for MobileApktoolMockBuildTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { use rustre_mobile_apktool::ApktoolRunner; let dir = args.get("dir").and_then(Value::as_str).unwrap_or(""); let out = args.get("out").and_then(Value::as_str).unwrap_or("out"); let r = rustre_mobile_apktool::MockApktoolRunner::success(); let cfg = rustre_mobile_apktool::ApktoolConfig::new("apktool", out); match r.build(dir, &cfg) { Ok(b) => Ok(ToolResult::text(json!({"success":b.success,"apk_path":b.apk_path,"source":"rustre_mobile_apktool::MockApktoolRunner::build"}).to_string())), Err(e) => Err(McpError::InvalidParams(e.to_string())) } } }

