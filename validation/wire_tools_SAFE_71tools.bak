/// Parse an ELF binary and return a compact structural summary.
pub struct LoaderElfInfoSummaryTool;

impl LoaderElfInfoSummaryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_elf_info_summary".to_string(),
            description: "Parse ELF bytes with rustre_loader_elf::ElfInfo::parse \
                          and return a compact structural summary."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderElfInfoSummaryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let info = rustre_loader_elf::ElfInfo::parse(&data)
            .map_err(|e| McpError::InvalidParams(format!("ELF parse: {e}")))?;
        let build_id_hex = info.build_id().map(hex_encode);
        Ok(ToolResult::text(
            json!({
                "arch": format!("{:?}", info.arch),
                "bits": info.bits,
                "endian": format!("{:?}", info.endian),
                "elf_type": format!("{:?}", info.elf_type),
                "entry_point": info.entry_point,
                "segments": info.segments.len(),
                "sections": info.sections.len(),
                "symbols": info.symbols.len(),
                "dynamic_symbols": info.dynamic_symbols.len(),
                "plt_entries": info.plt_entries.len(),
                "needed_libs": info.needed_libs,
                "soname": info.soname,
                "rpath": info.rpath,
                "interpreter": info.interpreter,
                "build_id": build_id_hex,
                "debug_link": info.debug_link,
                "relocation_count": info.relocation_count,
                "stripped": info.stripped,
                "source": "rustre_loader_elf::ElfInfo::parse",
            })
            .to_string(),
        ))
    }
}

/// Map a Mach-O cputype (u32) to an architecture name via `MachoArch::from_cputype`.
pub struct LoaderMachoArchFromCputypeTool;

impl LoaderMachoArchFromCputypeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_macho_arch_from_cputype".to_string(),
            description: "Map a Mach-O cputype (u32) via rustre_loader_macho::MachoArch::from_cputype \
                          returning a human-readable architecture name and pointer size.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "cputype": { "type": "integer" } },
                "required": ["cputype"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderMachoArchFromCputypeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let ct = args.get("cputype").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("cputype required".into()))? as u32;
        let arch = rustre_loader_macho::MachoArch::from_cputype(ct);
        Ok(ToolResult::text(json!({
            "cputype": ct,
            "arch": arch.name(),
            "pointer_size": arch.pointer_size(),
            "is_64bit": arch.is_64bit(),
            "endian": format!("{:?}", arch.endian()),
            "source": "rustre_loader_macho::MachoArch::from_cputype",
        }).to_string()))
    }
}

