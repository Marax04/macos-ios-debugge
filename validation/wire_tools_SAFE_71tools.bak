/// Return whether a raw STABS `n_type` byte designates a source-file record.
pub struct StabsIsSourceFileTool;

impl StabsIsSourceFileTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "stabs_is_source_file".to_string(),
            description: "Return true if the raw STABS n_type byte designates a source-file record via rustre_symbols_stabs::StabType::is_source_file.".to_string(),
            input_schema: json!({"type":"object","properties":{"n_type":{"type":"integer","minimum":0,"maximum":255}},"required":["n_type"]}),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for StabsIsSourceFileTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let b = args.get("n_type").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'n_type'".into()))?;
        let b = u8::try_from(b).map_err(|_| McpError::InvalidParams("'n_type' out of range".into()))?;
        let st = rustre_symbols_stabs::StabType::from_u8(b);
        Ok(ToolResult::text(json!({
            "n_type": b,
            "name": st.name(),
            "is_source_file": st.is_source_file(),
            "source": "rustre_symbols_stabs::StabType::is_source_file",
        }).to_string()))
    }
}

