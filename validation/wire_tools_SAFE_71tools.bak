        ToolDefinition {
            name: "analysis_type_list_builtin_types".to_string(),
            description: "Return a snapshot of every built-in type record from \
                          rustre_analysis_type::list_builtin_types.".to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisTypeListBuiltinTypesTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let records = rustre_analysis_type::list_builtin_types();
        let payload = serde_json::to_value(&records)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(json!({ "count": records.len(), "types": payload }).to_string()))
