        let name = args.get("name").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let tactic = args.get("tactic").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'tactic'".into()))?;
