/// Extract DWARF functions from an ELF binary on disk.
pub struct DwarfFunctionsPathTool;

impl DwarfFunctionsPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dwarf_functions_path".to_string(),
            description: "Parse DWARF .debug_info and return functions (name, low_pc, high_pc, parameters)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string" } },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DwarfFunctionsPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let reader = rustre_symbols_dwarf::DwarfReader::open(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("dwarf open failed: {e}")))?;
        let funcs = reader.functions();
        let payload = serde_json::to_value(&funcs)
            .map_err(|e| McpError::InternalError(format!("serialize failed: {e}")))?;
        Ok(ToolResult::text(json!({ "count": funcs.len(), "functions": payload }).to_string()))
    }
}

