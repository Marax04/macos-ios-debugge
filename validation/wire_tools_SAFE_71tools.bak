/// Detailed FunctionDiff between two function byte streams (calls/constants added/removed).
pub struct DiffSemanticDifferDiffFunctionPairTool;

impl DiffSemanticDifferDiffFunctionPairTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "diff_semantic_differ_diff_function_pair".to_string(),
            description: "Run SemanticDiffer::diff_function_pair on raw bytes of two functions. Returns similarity, is_equivalent, added/removed calls and constants, and description.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["base_a", "base_b"],
                "properties": {
                    "hex_a": { "type": "string" }, "bytes_a": { "type": "array", "items": { "type": "integer" } }, "base_a": { "type": "integer" },
                    "hex_b": { "type": "string" }, "bytes_b": { "type": "array", "items": { "type": "integer" } }, "base_b": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DiffSemanticDifferDiffFunctionPairTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let bytes_a = ds_extract_bytes(&args, "hex_a", "bytes_a")?;
        let bytes_b = ds_extract_bytes(&args, "hex_b", "bytes_b")?;
        let base_a = args.get("base_a").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'base_a'".into()))?;
        let base_b = args.get("base_b").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'base_b'".into()))?;
        let diff = rustre_diff_semantic::SemanticDiffer::diff_function_pair(&bytes_a, base_a, &bytes_b, base_b);
        Ok(ToolResult::text(json!({
            "addr_a": diff.addr_a,
            "addr_b": diff.addr_b,
            "similarity": diff.similarity,
            "is_equivalent": diff.is_equivalent,
            "added_calls": diff.added_calls,
            "removed_calls": diff.removed_calls,
            "added_constants": diff.added_constants,
            "removed_constants": diff.removed_constants,
            "description": diff.description,
        }).to_string()))
    }
}

// --- pe-rebuild extra: find_pe_candidates / calculate_pe_checksum / infer_characteristics ---

pub struct PeRebuildFindPeCandidatesTool;

impl PeRebuildFindPeCandidatesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_rebuild_find_pe_candidates".to_string(),
            description: "Scan hex-encoded dump for PE header candidate offsets via rustre_pe_rebuild::find_pe_candidates.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": { "hex": { "type": "string" } }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeRebuildFindPeCandidatesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let bytes: Vec<u8> = (0..hex.len()).step_by(2)
            .filter_map(|i| hex.get(i..i+2).and_then(|s| u8::from_str_radix(s, 16).ok()))
            .collect();
        let cands = rustre_pe_rebuild::pe_reconstructor::find_pe_candidates(&bytes);
        let count = cands.len();
        Ok(ToolResult::text(json!({
            "candidates": cands,
            "count": count,
            "bytes": bytes.len(),
        }).to_string()))
    }
}

