/// Emit SMT-LIB2 for a bitvector constant using `rustre_symb_z3::emit_smtlib2`.
pub struct SymbZ3EmitConstTool;

impl SymbZ3EmitConstTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "symb_z3_emit_const".to_string(),
            description: "Emit SMT-LIB2 text for a bitvector constant.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "value": { "type": "integer" },
                    "bits":  { "type": "integer" }
                },
                "required": ["value", "bits"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SymbZ3EmitConstTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args.get("value").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let bits = args.get("bits").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'bits'".to_string()))? as usize;
        let expr = rustre_symb_z3::SymExpr::Const(value, bits);
        let smt = rustre_symb_z3::emit_smtlib2(&expr);
        Ok(ToolResult::text(
            json!({
                "smtlib2": smt,
                "bit_width": expr.bit_width(),
                "source": "rustre_symb_z3::emit_smtlib2",
            })
            .to_string(),
        ))
    }
}

