/// Wraps `rustre_pe_editor::CertificateHeader::new` + `to_bytes`.
pub struct PeEditorCertificateHeaderTool;

impl PeEditorCertificateHeaderTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "pe_editor_certificate_header".to_string(),
            description: "Build a WIN_CERTIFICATE header for a payload length \
                          (rustre_pe_editor::CertificateHeader)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "payload_len": { "type": "integer" }
                },
                "required": ["payload_len"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeEditorCertificateHeaderTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let payload_len = args
            .get("payload_len")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'payload_len'".to_string()))?;
        let payload_len = u32::try_from(payload_len)
            .map_err(|_| McpError::InvalidParams("payload_len exceeds u32".to_string()))?;
        let hdr = rustre_pe_editor::CertificateHeader::new(payload_len);
        let bytes = hdr.to_bytes();
        Ok(ToolResult::text(
            json!({
                "dw_length": hdr.dw_length,
                "w_revision": hdr.w_revision,
                "w_certificate_type": hdr.w_certificate_type,
                "header_hex": hex_encode(&bytes),
                "source": "rustre_pe_editor::CertificateHeader",
            })
            .to_string(),
        ))
    }
}

