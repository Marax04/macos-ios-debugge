/// Parse a .NET `MethodDef`/`MemberRef` method signature blob (hex-encoded) into structured info.
pub struct DotnetMetadataParseMethodSigBlobTool;

impl DotnetMetadataParseMethodSigBlobTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "dotnet_metadata_parse_method_sig_blob".to_string(),
            description:
                "Parse a .NET MethodDef/MemberRef signature blob (hex-encoded) via \
                 rustre_dotnet_metadata::parse_method_sig_blob."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "blob_hex": { "type": "string" } },
                "required": ["blob_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DotnetMetadataParseMethodSigBlobTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("blob_hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'blob_hex'".to_string()))?;
        let bytes = libfuzzer_hex_str_to_bytes(hex)?;
        let info = rustre_dotnet_metadata::parse_method_sig_blob(&bytes)
            .map_err(|e| McpError::InternalError(format!("parse_method_sig_blob: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "calling_conv": info.calling_conv,
                "is_instance": info.is_instance,
                "is_generic": info.is_generic,
                "generic_count": info.generic_count,
                "return_type": info.return_type,
                "params": info.params,
                "source": "rustre_dotnet_metadata::parse_method_sig_blob",
            })
            .to_string(),
        ))
    }
}

