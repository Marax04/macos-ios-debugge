// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ti-misp Ã¢â‚¬â€ MispDistributionLevel::from_value Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct TiMispDistributionLevelFromValueTool;

impl TiMispDistributionLevelFromValueTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ti_misp_distribution_level_from_value".to_string(),
            description:
                "Parse a numeric MISP distribution level (0..=5) into MispDistributionLevel."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "value": {"type": "integer"} },
                "required": ["value"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TiMispDistributionLevelFromValueTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let v = args
            .get("value")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let v8 = u8::try_from(v)
            .map_err(|_| McpError::InvalidParams("value out of u8 range".to_string()))?;
        let parsed = rustre_ti_misp::MispDistributionLevel::from_value(v8);
        Ok(ToolResult::text(
            json!({
                "value": v8,
                "recognised": parsed.is_some(),
                "level": parsed.as_ref().map(|l| l.to_string()),
                "source": "rustre_ti_misp::MispDistributionLevel::from_value",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ti-misp Ã¢â‚¬â€ MispThreatLevelId::from_value Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

