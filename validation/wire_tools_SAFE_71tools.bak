/// Merge multiple PCAP byte streams via `rustre_net_pcap::merge_pcap_files`.
pub struct NetPcapMergeFilesTool;

impl NetPcapMergeFilesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_pcap_merge_files".to_string(),
            description:
                "Merge multiple PCAP byte streams into one via \
                 rustre_net_pcap::merge_pcap_files. Input: array of hex strings."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["files_hex"],
                "properties": {
                    "files_hex": { "type": "array", "items": { "type": "string" } }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetPcapMergeFilesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arr = args
            .get("files_hex")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'files_hex'".into()))?;
        let mut bufs: Vec<Vec<u8>> = Vec::with_capacity(arr.len());
        for v in arr {
            let s = v
                .as_str()
                .ok_or_else(|| McpError::InvalidParams("files_hex entries must be strings".into()))?;
            let bytes = crate::hex_decode(s)
                .map_err(|e| McpError::InvalidParams(format!("hex decode: {e}")))?;
            bufs.push(bytes);
        }
        let refs: Vec<&[u8]> = bufs.iter().map(Vec::as_slice).collect();
        let out = rustre_net_pcap::merge_pcap_files(&refs)
            .map_err(|e| McpError::InternalError(format!("merge failed: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "output_bytes": out.len(),
                "input_count": refs.len(),
                "source": "rustre_net_pcap::merge_pcap_files",
            })
            .to_string(),
        ))
    }
}

