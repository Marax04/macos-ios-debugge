#[async_trait]
impl ToolHandler for DotnetEncodeTokenTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let table = args.get("table").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'table'".into()))?;
        let row = args.get("row").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'row'".into()))?;
        let table_u8 = u8::try_from(table).map_err(|_| McpError::InvalidParams("'table' out of range".into()))?;
        let row_u32 = u32::try_from(row).map_err(|_| McpError::InvalidParams("'row' out of range".into()))?;
        let token = rustre_dotnet::encode_token(table_u8, row_u32);
        Ok(ToolResult::text(json!({ "table": table_u8, "row": row_u32, "token": token }).to_string()))
    }
}

