// --- rustre-fuzz-libfuzzer wrappers ----------------------------------------

fn libfuzzer_hex_str_to_bytes(s: &str) -> Result<Vec<u8>, McpError> {
    let s = s.trim();
    if s.len() % 2 != 0 {
        return Err(McpError::InvalidParams("hex length must be even".to_string()));
    }
    let mut out = Vec::with_capacity(s.len() / 2);
    let bytes = s.as_bytes();
    let mut i = 0;
    while i < bytes.len() {
        let hi = (bytes[i] as char).to_digit(16)
            .ok_or_else(|| McpError::InvalidParams("invalid hex".to_string()))?;
        let lo = (bytes[i + 1] as char).to_digit(16)
            .ok_or_else(|| McpError::InvalidParams("invalid hex".to_string()))?;
        out.push(((hi << 4) | lo) as u8);
        i += 2;
    }
    Ok(out)
}

/// Apply AFL bucketing to a coverage bitmap via `bucket_bitmap`.
pub struct FuzzLibfuzzerBucketBitmapTool;

impl FuzzLibfuzzerBucketBitmapTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "fuzz_libfuzzer_bucket_bitmap".to_string(),
            description:
                "Apply AFL bucketing to a coverage bitmap (hex-encoded) via \
                 rustre_fuzz_libfuzzer::coverage_feedback::bucket_bitmap."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "bitmap_hex": { "type": "string" } },
                "required": ["bitmap_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FuzzLibfuzzerBucketBitmapTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("bitmap_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'bitmap_hex'".to_string()))?;
        let bytes = libfuzzer_hex_str_to_bytes(hex)?;
        let bucketed = rustre_fuzz_libfuzzer::coverage_feedback::bucket_bitmap(&bytes);
        let hex_out: String = bucketed.iter().map(|b| format!("{b:02x}")).collect();
        Ok(ToolResult::text(
            json!({
                "len": bucketed.len(),
                "bucketed_hex": hex_out,
                "source": "rustre_fuzz_libfuzzer::coverage_feedback::bucket_bitmap",
            })
            .to_string(),
        ))
    }
}

/// Count new bucketed bits between two coverage bitmaps.
pub struct FuzzLibfuzzerCountNewBitsBucketedTool;

impl FuzzLibfuzzerCountNewBitsBucketedTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "fuzz_libfuzzer_count_new_bits_bucketed".to_string(),
            description:
                "Count edges whose bucketed hit-count differs between global and current bitmaps \
                 via rustre_fuzz_libfuzzer::coverage_feedback::count_new_bits_bucketed."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "global_hex": { "type": "string" },
                    "current_hex": { "type": "string" }
                },
                "required": ["global_hex", "current_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FuzzLibfuzzerCountNewBitsBucketedTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let g = args.get("global_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'global_hex'".to_string()))?;
        let c = args.get("current_hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'current_hex'".to_string()))?;
        let g_b = libfuzzer_hex_str_to_bytes(g)?;
        let c_b = libfuzzer_hex_str_to_bytes(c)?;
        let n = rustre_fuzz_libfuzzer::coverage_feedback::count_new_bits_bucketed(&g_b, &c_b);
        Ok(ToolResult::text(
            json!({
                "new_bits": n,
                "source": "rustre_fuzz_libfuzzer::coverage_feedback::count_new_bits_bucketed",
            })
            .to_string(),
        ))
    }
}

/// Parse sanitizer output to extract crash kind and fault address.
pub struct FuzzLibfuzzerParseSanitizerOutputTool;

impl FuzzLibfuzzerParseSanitizerOutputTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
