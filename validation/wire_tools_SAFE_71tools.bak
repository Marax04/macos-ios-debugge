#[async_trait]
impl ToolHandler for IlLiftDiffAddressMapsTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let left = rustre_il_lift::AddressMap::new();
        let right = rustre_il_lift::AddressMap::new();
        let diff = rustre_il_lift::diff_address_maps(&left, &right);
        Ok(ToolResult::text(
            json!({
                "ok": true,
                "only_in_left": diff.only_in_left.len(),
                "only_in_right": diff.only_in_right.len(),
