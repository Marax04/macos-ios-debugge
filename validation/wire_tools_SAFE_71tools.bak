/// Batch-demangle a list of mangled symbols in parallel.
pub struct DemangleBatchParallelTool;

impl DemangleBatchParallelTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "demangle_batch_parallel".to_string(),
            description:
                "Demangle a batch of mangled symbols in parallel, auto-detecting ABI for each \
                 (delegates to rustre_demangle::batch_demangle_parallel)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "symbols": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["symbols"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DemangleBatchParallelTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let syms_val = args
            .get("symbols")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'symbols' array".to_string()))?;
        let symbols: Vec<String> = syms_val
            .iter()
            .filter_map(|v| v.as_str().map(std::string::ToString::to_string))
            .collect();
        let results = rustre_demangle::batch_demangle_parallel(&symbols);
        let items: Vec<Value> = results
            .into_iter()
            .map(|r| json!({ "mangled": r.mangled, "demangled": r.demangled }))
            .collect();
        Ok(ToolResult::text(
            json!({
                "count": symbols.len(),
                "results": items,
                "source": "rustre_demangle::batch_demangle_parallel",
            })
            .to_string(),
        ))
    }
}

/// Render a demangled symbol as a display string (falls back to mangled on empty).
pub struct DemangleResultDisplayTool;

impl DemangleResultDisplayTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "demangle_result_display".to_string(),
            description:
                "Auto-demangle a symbol and return its human-readable display string, \
                 falling back to the mangled form when empty \
                 (delegates to rustre_demangle::DemangleResult::to_display_string)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "mangled": { "type": "string" } },
                "required": ["mangled"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DemangleResultDisplayTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mangled = args
            .get("mangled")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mangled'".to_string()))?;
        let results = rustre_demangle::batch_demangle(&[mangled]);
        let display = results
            .first()
            .map(rustre_demangle::DemangleResult::to_display_string)
            .unwrap_or_else(|| mangled.to_string());
        Ok(ToolResult::text(
            json!({
                "mangled": mangled,
                "display": display,
                "source": "rustre_demangle::DemangleResult::to_display_string",
            })
            .to_string(),
        ))
    }
}

