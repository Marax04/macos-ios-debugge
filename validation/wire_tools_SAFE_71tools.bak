            "uuid": s.uuid, "attribute_uuid": s.attribute_uuid,
            "sighting_type": s.sighting_type, "is_false_positive": s.is_false_positive(),
            "date_sighting": s.date_sighting,
            "source": "rustre_ti_misp::MispSighting::new",
        }).to_string()))
    }
}

