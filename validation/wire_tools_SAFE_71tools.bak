pub struct DebugMacosStopReasonAddressTool;
impl DebugMacosStopReasonAddressTool { #[must_use] pub fn definition() -> ToolDefinition { ToolDefinition { name: "debug_macos_stop_reason_address".to_string(), description: "Report MacosStopReason::address for a synthesized breakpoint/single-step/exception.".to_string(), input_schema: json!({ "type": "object", "properties": { "kind": {"type":"string"}, "address": {"type":"integer"}, "code": {"type":"integer"} }, "required":["kind"] }), parameters: Value::Null } } }
#[async_trait]
impl ToolHandler for DebugMacosStopReasonAddressTool { async fn call(&self, args: Value) -> Result<ToolResult, McpError> { let kind = args.get("kind").and_then(Value::as_str).ok_or_else(|| McpError::InvalidParams("missing 'kind'".into()))?; let addr = args.get("address").and_then(Value::as_u64).unwrap_or(0); let code = args.get("code").and_then(Value::as_u64).unwrap_or(0); let reason = match kind { "breakpoint" => rustre_debug_macos::MacosStopReason::Breakpoint { address: addr }, "single_step" => rustre_debug_macos::MacosStopReason::SingleStep { address: addr }, "exception" => rustre_debug_macos::MacosStopReason::Exception { exc_type: rustre_debug_macos::MachExceptionType::from_u32(1), code, subcode: 0 }, "exited" => rustre_debug_macos::MacosStopReason::Exited { exit_code: 0 }, _ => return Err(McpError::InvalidParams(format!("unknown kind '{kind}'"))) }; Ok(ToolResult::text(json!({ "kind": kind, "address": reason.address(), "is_exit": reason.is_exit(), "source": "rustre_debug_macos::MacosStopReason::address" }).to_string())) } }

