/// Convert a numeric PCAP link-type code to its symbolic name via
/// `rustre_net_pcap::LinkType::from_u16`.
pub struct NetPcapLinkTypeFromU16Tool;

impl NetPcapLinkTypeFromU16Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_pcap_link_type_from_u16".to_string(),
            description:
                "Resolve a PCAP link-layer type numeric code to its symbolic name \
                 (e.g. 1 => Ethernet) via rustre_net_pcap::LinkType."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["code"],
                "properties": {
                    "code": { "type": "integer", "minimum": 0, "maximum": 65535 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetPcapLinkTypeFromU16Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let code_u = args
            .get("code")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'code'".into()))?;
        let code = u16::try_from(code_u)
            .map_err(|_| McpError::InvalidParams("'code' out of u16 range".into()))?;
        let lt = rustre_net_pcap::LinkType::from_u16(code);
        Ok(ToolResult::text(
            json!({
                "code": code,
                "link_type": lt.to_string(),
                "roundtrip": lt.as_u16(),
                "source": "rustre_net_pcap::LinkType::from_u16",
            })
            .to_string(),
        ))
    }
}

/// Parse a PCAP byte stream via `rustre_net_pcap::PcapFile::parse` and
/// return record count + total captured bytes + network header info.
pub struct NetPcapFileParseInfoTool;

impl NetPcapFileParseInfoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "net_pcap_file_parse_info".to_string(),
            description:
                "Parse a PCAP byte stream via rustre_net_pcap::PcapFile::parse \
                 and report record_count, total_bytes, network, and snaplen."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NetPcapFileParseInfoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let file = rustre_net_pcap::PcapFile::parse(&data)
            .map_err(|e| McpError::InternalError(format!("pcap parse failed: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "record_count": file.record_count(),
                "total_bytes": file.total_bytes(),
                "network": file.header.network,
                "snaplen": file.header.snaplen,
                "source": "rustre_net_pcap::PcapFile::parse",
            })
            .to_string(),
        ))
    }
}

