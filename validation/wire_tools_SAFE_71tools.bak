        let name = args.get("name").and_then(Value::as_str).unwrap_or("word").to_string();
        let size = args.get("size").and_then(Value::as_u64).unwrap_or(2) as usize;
        let mut db = rustre_decompiler_ghidra::GhidraDataTypeDb::new();
