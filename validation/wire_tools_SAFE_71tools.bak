        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ rustre-emu-qiling Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Build a Linux x86-64 Qiling emulator and report its arch and stack layout.
pub struct EmuQilingLinuxX8664Tool;

impl EmuQilingLinuxX8664Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_qiling_linux_x86_64".to_string(),
            description:
                "Instantiate a Linux x86-64 Qiling-style emulator with default syscall stubs and a mapped stack. Returns arch, entry point, stack base/size."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "rootfs": { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuQilingLinuxX8664Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let rootfs = args
            .get("rootfs")
            .and_then(Value::as_str)
            .unwrap_or("/");
        let emu = rustre_emu_qiling::linux_x86_64(rootfs)
            .map_err(|e| McpError::InvalidParams(format!("qiling init failed: {e}")))?;
        let env = emu.process_env();
        Ok(ToolResult::text(
            json!({
                "arch": format!("{:?}", emu.arch()),
                "entry_point": env.entry_point,
                "stack_base": env.stack_base,
                "stack_size": env.stack_size,
                "source": "rustre_emu_qiling::linux_x86_64",
            })
            .to_string(),
        ))
    }
}

/// Build a bare-metal shellcode runner and report its entry point.
pub struct EmuQilingShellcodeRunnerTool;

impl EmuQilingShellcodeRunnerTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "emu_qiling_shellcode_runner".to_string(),
            description:
                "Instantiate a bare-metal Qiling emulator for the given arch with a shellcode blob preloaded at 0x10000. Returns entry point and arch."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "arch":          { "type": "string" },
                    "shellcode":     { "type": "array", "items": { "type": "integer" } },
                    "shellcode_hex": { "type": "string" }
                },
                "required": ["arch"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for EmuQilingShellcodeRunnerTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arch_str = args
            .get("arch")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'arch'".into()))?;
        let arch = match arch_str.to_ascii_lowercase().as_str() {
            "x86_64" | "x86-64" | "x64" => rustre_emu::EmulatorArch::X86_64,
            "x86" | "x86_32" | "i386" => rustre_emu::EmulatorArch::X86_32,
            other => {
                return Err(McpError::InvalidParams(format!(
                    "unsupported arch: {other}"
                )));
            }
        };
        let shellcode = extract_byte_array(&args, "shellcode", "shellcode_hex")
            .unwrap_or_default();
        let emu = rustre_emu_qiling::shellcode_runner(arch, &shellcode)
            .map_err(|e| McpError::InvalidParams(format!("shellcode runner failed: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "arch": format!("{:?}", emu.arch()),
                "entry_point": emu.process_env().entry_point,
                "shellcode_len": shellcode.len(),
                "source": "rustre_emu_qiling::shellcode_runner",
            })
            .to_string(),
        ))
    }
}

