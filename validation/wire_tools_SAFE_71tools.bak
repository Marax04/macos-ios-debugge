// ─── extra mobile_ipa wire tools ───

fn __ipa_hex_decode(s: &str) -> Vec<u8> {
    let cleaned: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    let cb = cleaned.as_bytes();
    let mut out = Vec::with_capacity(cb.len() / 2);
    let mut i = 0;
    while i + 1 < cb.len() {
        let hi = (cb[i] as char).to_digit(16).unwrap_or(0);
        let lo = (cb[i + 1] as char).to_digit(16).unwrap_or(0);
        out.push(((hi << 4) | lo) as u8);
        i += 2;
    }
    out
}

