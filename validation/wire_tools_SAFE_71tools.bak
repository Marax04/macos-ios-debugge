// TTD_QUERY_EXTRA_TOOLS_MARK
// (elf wrappers added, triage-entropy shannon wrappers added)
//
// Each tool here exposes a previously-implemented analysis primitive
// (gap A / D / F / G / H / I / J / K) as a structured-output MCP tool.
// Handlers are thin wrappers that delegate to the underlying analysis
// crate and return JSON suitable for direct consumption by external
// clients (Claude, IDE plugins, agents).

use async_trait::async_trait;
use rustre_mcp_server::{McpError, ToolDefinition, ToolHandler, ToolResult};
use serde_json::{json, Value};

use crate::{args_to_bytes, hex_encode};

include!("ttd_recorder_extra.rs");
include!("decompiler_type_extra.rs");
include!("dataflow_extra.rs");

// â”€â”€â”€ dataflow wrappers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn parse_liveness_cfg(args: &Value) -> Result<Vec<rustre_analysis_dataflow::LivenessCfgNode>, McpError> {
    let arr = args.get("cfg_nodes").and_then(Value::as_array)
        .ok_or_else(|| McpError::InvalidParams("missing 'cfg_nodes'".into()))?;
    let mut out = Vec::with_capacity(arr.len());
    for v in arr {
        let bb = v.get("bb_id").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'bb_id'".into()))? as u32;
        let succs: Vec<u32> = v.get("successors").and_then(Value::as_array)
            .map(|a| a.iter().filter_map(|x| x.as_u64().map(|n| n as u32)).collect())
            .unwrap_or_default();
        let gen_v: Vec<u32> = v.get("gen").and_then(Value::as_array)
            .map(|a| a.iter().filter_map(|x| x.as_u64().map(|n| n as u32)).collect())
            .unwrap_or_default();
        let kill_v: Vec<u32> = v.get("kill").and_then(Value::as_array)
            .map(|a| a.iter().filter_map(|x| x.as_u64().map(|n| n as u32)).collect())
            .unwrap_or_default();
        out.push((bb, succs, gen_v, kill_v));
    }
    Ok(out)
}

pub struct AnalysisDataflowComputeLivenessTool;

impl AnalysisDataflowComputeLivenessTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_dataflow_compute_liveness".to_string(),
            description: "Compute per-block live_in/live_out via backward worklist dataflow.".to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "cfg_nodes": { "type": "array" } },
                "required": ["cfg_nodes"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisDataflowComputeLivenessTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let cfg = parse_liveness_cfg(&args)?;
        let sets = rustre_analysis_dataflow::compute_liveness(&cfg);
        let mut blocks: Vec<Value> = sets.into_iter().map(|(id, (li, lo))| {
            json!({ "bb_id": id, "live_in": li, "live_out": lo })
        }).collect();
        blocks.sort_by_key(|v| v.get("bb_id").and_then(Value::as_u64).unwrap_or(0));
        Ok(ToolResult::text(json!({
            "blocks": blocks,
            "source": "rustre_analysis_dataflow::compute_liveness",
        }).to_string()))
    }
}

