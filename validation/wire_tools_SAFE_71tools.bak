/// Read little-endian u64 from hex bytes via `rustre_deobf_vm::read_u64_le`.
pub struct DeobfVmReadU64LeTool;

impl DeobfVmReadU64LeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "deobf_vm_read_u64_le".to_string(),
            description: "Read a little-endian u64 from the first 8 bytes of a hex-encoded byte slice.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": { "hex": { "type": "string" } }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DeobfVmReadU64LeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let bytes: Vec<u8> = (0..hex.len()).step_by(2)
            .filter_map(|i| hex.get(i..i+2).and_then(|s| u8::from_str_radix(s, 16).ok()))
            .collect();
        let v = rustre_deobf_vm::read_u64_le(&bytes);
        Ok(ToolResult::text(json!({ "value": v, "input_len": bytes.len() }).to_string()))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ deobf_vm_read_u32_le Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Read little-endian u32 from hex bytes via `rustre_deobf_vm::read_u32_le`.
pub struct DeobfVmReadU32LeTool;

impl DeobfVmReadU32LeTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "deobf_vm_read_u32_le".to_string(),
            description: "Read a little-endian u32 from the first 4 bytes of a hex-encoded byte slice.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": { "hex": { "type": "string" } }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DeobfVmReadU32LeTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args.get("hex").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let bytes: Vec<u8> = (0..hex.len()).step_by(2)
            .filter_map(|i| hex.get(i..i+2).and_then(|s| u8::from_str_radix(s, 16).ok()))
            .collect();
        let v = rustre_deobf_vm::read_u32_le(&bytes);
        Ok(ToolResult::text(json!({ "value": v, "input_len": bytes.len() }).to_string()))
    }
}

