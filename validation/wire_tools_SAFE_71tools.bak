#[async_trait]
impl ToolHandler for YaraParserParseWireTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let source = args.get("source").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing source".into()))?;
        match rustre_yara::YaraParser::parse(source) {
            Ok(rs) => {
                let names: Vec<String> = rs.rules.iter().map(|r| r.name.clone()).collect();
                Ok(ToolResult::text(json!({
                    "rule_count": rs.rule_count(),
                    "rule_names": names,
                    "imports": rs.imports,
                    "source": "rustre_yara::YaraParser::parse",
                }).to_string()))
            }
            Err(e) => Err(McpError::InvalidParams(format!("parse error: {e}"))),
        }
    }
}

