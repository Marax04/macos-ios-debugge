// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap D extra Ã¢â‚¬â€ call_graph_root_functions / string_ref_counts Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

fn extract_u64_array(args: &Value, key: &str) -> Result<Vec<u64>, McpError> {
    let arr = args
        .get(key)
        .and_then(Value::as_array)
        .ok_or_else(|| McpError::InvalidParams(format!("missing '{key}'")))?;
    arr.iter()
        .map(|v| {
            v.as_u64()
                .ok_or_else(|| McpError::InvalidParams(format!("{key}: not integer")))
        })
        .collect()
}

pub struct AnalysisXrefCallGraphRootFunctionsTool;

impl AnalysisXrefCallGraphRootFunctionsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_xref_call_graph_root_functions".to_string(),
            description:
                "Return call-graph root functions: entries from `function_entries` \
                 that have **zero** incoming direct CALL xrefs in the static scan \
                 of the supplied code bytes. Note: based on E8 direct-call scanning \
                 only; functions reached solely via indirect dispatch will appear as \
                 roots. Supply the full set of detected function entries for accurate \
                 results."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["function_entries"],
                "properties": {
                    "bytes":            { "type": "array", "items": { "type": "integer" } },
                    "hex":              { "type": "string" },
                    "base":             { "type": "integer", "description": "Base VA of the code buffer" },
                    "arch":             { "type": "string", "enum": ["x86", "x86_64"] },
                    "function_entries": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "description": "All discovered function-entry VAs"
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisXrefCallGraphRootFunctionsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let entries = extract_u64_array(&args, "function_entries")?;
        let idx = build_xref_index(&args)?;
        let roots = idx.root_functions(&entries);
        Ok(ToolResult::text(
            json!({
                "roots": roots,
                "count": roots.len(),
                "function_entries_count": entries.len(),
            })
            .to_string(),
        ))
    }
}

pub struct AnalysisXrefStringRefCountsTool;

impl AnalysisXrefStringRefCountsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_xref_string_ref_counts".to_string(),
            description:
                "Count how many xrefs target each supplied string-literal address \
                 in the static scan of the supplied code bytes. Pass the discovered \
                 string base addresses from rustre-analysis-string; this tool only \
                 aggregates references, it does not perform string discovery."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["string_addrs"],
                "properties": {
                    "bytes":        { "type": "array", "items": { "type": "integer" } },
                    "hex":          { "type": "string" },
                    "base":         { "type": "integer" },
                    "arch":         { "type": "string", "enum": ["x86", "x86_64"] },
                    "string_addrs": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "description": "Base VAs of string literals to count refs for"
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisXrefStringRefCountsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let addrs = extract_u64_array(&args, "string_addrs")?;
        let idx = build_xref_index(&args)?;
        let counts = idx.count_string_refs(addrs.iter().copied());
        let total_refs: usize = counts.values().sum();
        let mut counts_obj = serde_json::Map::new();
        for addr in &addrs {
            let c = counts.get(addr).copied().unwrap_or(0);
            counts_obj.insert(addr.to_string(), Value::from(c));
        }
        Ok(ToolResult::text(
            json!({
                "counts": Value::Object(counts_obj),
                "total_refs": total_refs,
                "string_count": addrs.len(),
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap F Ã¢â‚¬â€ analysis_fn_detect_extra (find leaf fns missing from .pdata) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct AnalysisFnDetectExtraTool;

impl AnalysisFnDetectExtraTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_fn_detect_extra".to_string(),
            description:
                "Find extra (leaf) functions present in .text but not covered \
                 by .pdata RUNTIME_FUNCTION entries. Caller supplies raw \
                 .pdata + .text bytes plus the .text base VA and PE image base."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["pdata", "text", "text_base", "image_base"],
                "properties": {
                    "pdata":      { "type": "array", "items": { "type": "integer" } },
                    "pdata_hex":  { "type": "string" },
                    "text":       { "type": "array", "items": { "type": "integer" } },
                    "text_hex":   { "type": "string" },
                    "text_base":  { "type": "integer" },
                    "image_base": { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisFnDetectExtraTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_analysis_fn::{find_extra_pdata_funcs, parse_pdata};
        use rustre_core::address::{Address, AddressRange};

        let pdata = extract_byte_array(&args, "pdata", "pdata_hex")?;
        let text = extract_byte_array(&args, "text", "text_hex")?;
        let text_base = args
            .get("text_base")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'text_base'".into()))?;
        let image_base = args
            .get("image_base")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'image_base'".into()))?;

        let entries = parse_pdata(&pdata);
        let text_range = AddressRange::new(
            Address::new(text_base),
            Address::new(text_base + text.len() as u64),
        );
        let (extras, stats) =
            find_extra_pdata_funcs(Address::new(image_base), text_range, &text, &entries);

        let extras_json: Vec<Value> = extras
            .iter()
            .map(|fb| {
                json!({
                    "start_va": fb.start.as_u64(),
                    "end_va":   fb.end.map(|e| e.as_u64()),
                    "size":     fb.byte_size(),
                    "prologue": fb.name.clone().unwrap_or_default(),
                    "confidence": format!("{:?}", fb.confidence),
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "extras": extras_json,
                "stats": {
                    "gaps_scanned": stats.gaps_scanned,
                    "prologue_matches": stats.prologue_matches,
                    "candidates_validated": stats.candidates_validated,
                    "pdata_count": stats.pdata_count,
                }
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap J Ã¢â‚¬â€ decompiler_core_batch_decompile Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct DecompilerCoreBatchDecompileTool;

impl DecompilerCoreBatchDecompileTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "decompiler_core_batch_decompile".to_string(),
            description:
                "Decompile every detected function in a binary on-disk via \
                 BatchDecompiler. Writes per-function .c files plus summary.json \
                 to `out_dir` and returns success/fail stats."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["binary_path", "out_dir"],
                "properties": {
                    "binary_path":   { "type": "string" },
                    "out_dir":       { "type": "string" },
                    "threads":       { "type": "integer", "minimum": 0 },
                    "max_functions": { "type": "integer", "minimum": 0 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DecompilerCoreBatchDecompileTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_decompiler::batch_decompiler::{BatchConfig, BatchDecompiler};

        let binary_path = args
            .get("binary_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'binary_path'".into()))?
            .to_string();
        let out_dir = args
            .get("out_dir")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'out_dir'".into()))?
            .to_string();

        let mut cfg = BatchConfig::default();
        if let Some(t) = args.get("threads").and_then(Value::as_u64) {
            cfg.threads = t as usize;
        }
        if let Some(m) = args.get("max_functions").and_then(Value::as_u64) {
            cfg.max_functions = m as usize;
        }

        let result = BatchDecompiler::decompile_all_from_binary(
            std::path::Path::new(&binary_path),
            std::path::Path::new(&out_dir),
            &cfg,
        )
        .map_err(|e| McpError::InternalError(format!("batch decompile failed: {e}")))?;

        Ok(ToolResult::text(
            json!({
                "binary_path": binary_path,
                "out_dir": out_dir,
                "decompiled": result.stats.functions_decompiled,
                "failed":     result.stats.functions_failed,
                "elapsed_ms": result.elapsed_ms,
                "success_rate": result.success_rate(),
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap A Ã¢â‚¬â€ flirt_apply_auto Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct FlirtApplyAutoTool;

impl FlirtApplyAutoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "flirt_apply_auto".to_string(),
            description:
                "Apply the built-in baseline FLIRT signature packs (MSVC CRT + \
                 Rust stdlib) to a PE on disk and return the resolved renames \
                 plus library-vs-user classification."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["binary_path"],
                "properties": {
                    "binary_path": { "type": "string" },
                    "min_confidence": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100,
                        "description": "Override DEFAULT_MIN_CONFIDENCE (70)"
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FlirtApplyAutoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_core::address::{Address, AddressRange};
        use rustre_core::binary_view::{Memory, Segment};
        use rustre_core::permissions::Permissions;
        use rustre_loader_pe::flirt_autoname;

        let binary_path = args
            .get("binary_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'binary_path'".into()))?;
        let min_conf = args
            .get("min_confidence")
            .and_then(Value::as_u64)
            .map(|n| n as u8)
            .unwrap_or(flirt_autoname::DEFAULT_MIN_CONFIDENCE);

        // Load via decompiler entry which routes through rustre-loader-pe.
        let load = rustre_decompiler::load_binary(std::path::Path::new(binary_path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        // Build a Memory map from RichLoadResult's sections + raw data so the
        // flirt scanner can walk executable bytes.
        let mut mem = Memory::new();
        for s in &load.sections {
            let off = s.raw_offset as usize;
            let sz = s.raw_size as usize;
            if off >= load.data.len() {
                continue;
            }
            let end = (off + sz).min(load.data.len());
            let data = load.data[off..end].to_vec();
            // Treat any section named like a code section as exec; this hook
            // intentionally errs on the side of inclusion so signature scans
            // do not silently skip a section.
            let mut perms = Permissions::READ;
            let is_code = s.name == ".text"
                || s.name == "__text"
                || s.name == "CODE"
                || s.name.starts_with(".text");
            if is_code {
                perms |= Permissions::EXECUTE;
            }
            mem.add_segment(Segment {
                range: AddressRange::new(
                    Address::new(s.virtual_addr),
                    Address::new(s.virtual_addr + u64::from(s.virtual_size)),
                ),
                permissions: perms,
                data,
            });
        }

        let packs = flirt_autoname::baseline_packs();
        let (renames, stats) = flirt_autoname::apply_packs(&mem, &packs, min_conf);

        // Feature K Ã¢â‚¬â€ propagate library/user classification into a freshly
        // built FunctionTable; every FLIRT rename becomes a FunctionDef and
        // its `is_library` flag is flipped by the propagation pass.
        let mut table = rustre_core::binary_view::FunctionTable::new();
        for r in &renames {
            table.add_function(rustre_core::binary_view::FunctionDef::new(
                Address::new(r.address),
                r.name.clone(),
            ));
        }
        let marks: Vec<rustre_flirt_apply::LibraryMark> = renames
            .iter()
            .filter(|r| !r.lib.is_empty())
            .map(|r| rustre_flirt_apply::LibraryMark {
                address: r.address,
                lib_name: r.lib.clone(),
            })
            .collect();
        let prop_stats =
            rustre_analysis_fn::apply_library_marks(&mut table, &marks, &[]);

        let renames_json: Vec<Value> = renames
            .iter()
            .map(|r| {
                let lo = table
                    .get_function_at(Address::new(r.address))
                    .and_then(|f| f.library_origin.clone());
                json!({
                    "address":        r.address,
                    "address_hex":    format!("0x{:x}", r.address),
                    "name":           r.name,
                    "lib":            r.lib,
                    "confidence":     r.confidence,
                    "pattern_length": r.pattern_length,
                    "classification": if lo.is_some() { "library" } else { "user" },
                    "library_origin": lo,
                })
            })
            .collect();

        let by_lib = table.library_breakdown();

        Ok(ToolResult::text(
            json!({
                "binary_path":    binary_path,
                "min_confidence": min_conf,
                "renames":        renames_json,
                "stats": {
                    "scanned": stats.scanned,
                    "matched": stats.matched,
                    "applied": stats.applied,
                    "skipped": stats.skipped,
                },
                "pack_count":      packs.len(),
                "library_symbols": renames.len(),
                "library_count":   table.count_library(),
                "user_count":      table.count_user(),
                "by_lib":          by_lib,
                "propagation": {
                    "considered":           prop_stats.considered,
                    "marked":               prop_stats.marked,
                    "missing":              prop_stats.missing,
                    "thunk_targets_marked": prop_stats.thunk_targets_marked,
                },
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ feature K Ã¢â‚¬â€ function_list_by_kind Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct FunctionListByKindTool;

impl FunctionListByKindTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "function_list_by_kind".to_string(),
            description:
                "After flirt_apply_auto labels functions as library code, list \
                 functions filtered by kind (library / user / all) and \
                 optionally by library name. Mirrors the library-vs-user split \
                 shown by mainstream disassemblers."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["binary_path"],
                "properties": {
                    "binary_path":    { "type": "string" },
                    "kind":           { "type": "string", "enum": ["library", "user", "all"] },
                    "lib_name":       { "type": "string" },
                    "limit":          { "type": "integer", "minimum": 0 },
                    "min_confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for FunctionListByKindTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_core::address::{Address, AddressRange};
        use rustre_core::binary_view::{FunctionDef, FunctionTable, Memory, Segment};
        use rustre_core::permissions::Permissions;
        use rustre_loader_pe::flirt_autoname;

        let binary_path = args
            .get("binary_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'binary_path'".into()))?;
        let kind = args
            .get("kind")
            .and_then(Value::as_str)
            .unwrap_or("all")
            .to_string();
        let lib_filter = args
            .get("lib_name")
            .and_then(Value::as_str)
            .map(str::to_string);
        let limit = args
            .get("limit")
            .and_then(Value::as_u64)
            .map(|n| n as usize)
            .unwrap_or(usize::MAX);
        let min_conf = args
            .get("min_confidence")
            .and_then(Value::as_u64)
            .map(|n| n as u8)
            .unwrap_or(flirt_autoname::DEFAULT_MIN_CONFIDENCE);

        let load = rustre_decompiler::load_binary(std::path::Path::new(binary_path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        let mut mem = Memory::new();
        for s in &load.sections {
            let off = s.raw_offset as usize;
            let sz = s.raw_size as usize;
            if off >= load.data.len() {
                continue;
            }
            let end = (off + sz).min(load.data.len());
            let data = load.data[off..end].to_vec();
            let mut perms = Permissions::READ;
            let is_code = s.name == ".text"
                || s.name == "__text"
                || s.name == "CODE"
                || s.name.starts_with(".text");
            if is_code {
                perms |= Permissions::EXECUTE;
            }
            mem.add_segment(Segment {
                range: AddressRange::new(
                    Address::new(s.virtual_addr),
                    Address::new(s.virtual_addr + u64::from(s.virtual_size)),
                ),
                permissions: perms,
                data,
            });
        }

        let packs = flirt_autoname::baseline_packs();
        let (renames, _) = flirt_autoname::apply_packs(&mem, &packs, min_conf);

        let mut table = FunctionTable::new();
        for r in &renames {
            table.add_function(FunctionDef::new(Address::new(r.address), r.name.clone()));
        }
        let marks: Vec<rustre_flirt_apply::LibraryMark> = renames
            .iter()
            .filter(|r| !r.lib.is_empty())
            .map(|r| rustre_flirt_apply::LibraryMark {
                address: r.address,
                lib_name: r.lib.clone(),
            })
            .collect();
        let _ = rustre_analysis_fn::apply_library_marks(&mut table, &marks, &[]);

        let total = table.len();
        let lib_count = table.count_library();
        let user_count = table.count_user();
        let by_lib = table.library_breakdown();

        let filtered: Vec<&FunctionDef> = match kind.as_str() {
            "library" => table.iter_library().collect(),
            "user" => table.iter_user().collect(),
            _ => table.iter_functions().collect(),
        };
        let mut rows: Vec<Value> = filtered
            .into_iter()
            .filter(|f| match &lib_filter {
                Some(lib) => f.library_origin.as_deref() == Some(lib.as_str()),
                None => true,
            })
            .map(|f| {
                json!({
                    "address":        f.address.as_u64(),
                    "address_hex":    format!("0x{:x}", f.address.as_u64()),
                    "name":           f.name,
                    "is_library":     f.is_library,
                    "library_origin": f.library_origin,
                })
            })
            .collect();

        if rows.len() > limit {
            rows.truncate(limit);
        }

        Ok(ToolResult::text(
            json!({
                "binary_path": binary_path,
                "kind":        kind,
                "lib_name":    lib_filter,
                "total":       total,
                "library":     lib_count,
                "user":        user_count,
                "by_lib":      by_lib,
                "functions":   rows,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap H Ã¢â‚¬â€ noreturn_infer Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct NoreturnInferTool;

impl NoreturnInferTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "noreturn_infer".to_string(),
            description:
                "Run the gap-H NoreturnDetector against a caller-supplied list \
                 of function records. Returns the addresses inferred as \
                 noreturn (panic/abort/ExitProcess/tail-callers thereof)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["functions"],
                "properties": {
                    "functions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["address"],
                            "properties": {
                                "address": { "type": "integer" },
                                "name":    { "type": "string" },
                                "body_hex":{ "type": "string" }
                            }
                        }
                    },
                    "arch": { "type": "string", "enum": ["x86_64", "x86_32", "arm64"] },
                    "propagation_threshold": { "type": "number" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for NoreturnInferTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_analysis_fn::noreturn_detector::{
            DetectorArch, FunctionRecord, NoreturnDetector,
        };
        use rustre_core::address::Address;

        let arch = match args.get("arch").and_then(Value::as_str).unwrap_or("x86_64") {
            "x86_32" => DetectorArch::X86_32,
            "arm64" => DetectorArch::Arm64,
            _ => DetectorArch::X86_64,
        };
        let threshold = args
            .get("propagation_threshold")
            .and_then(Value::as_f64)
            .map(|f| f as f32)
            .unwrap_or(0.80);

        let mut det = NoreturnDetector::new().with_arch(arch).with_threshold(threshold);

        let arr = args
            .get("functions")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'functions'".into()))?;
        for v in arr {
            let addr = v
                .get("address")
                .and_then(Value::as_u64)
                .ok_or_else(|| McpError::InvalidParams("function missing 'address'".into()))?;
            let name = v
                .get("name")
                .and_then(Value::as_str)
                .unwrap_or("")
                .to_string();
            let body = v
                .get("body_hex")
                .and_then(Value::as_str)
                .map(|s| crate::hex_decode(s).unwrap_or_default())
                .unwrap_or_default();
            let mut rec = FunctionRecord::new(Address::new(addr), body);
            if !name.is_empty() {
                rec.name = Some(name);
            }
            det.add_function(rec);
        }

        let noreturn = det.run();
        let mut sorted: Vec<u64> = noreturn.into_iter().collect();
        sorted.sort_unstable();

        Ok(ToolResult::text(
            json!({
                "noreturn_count": sorted.len(),
                "noreturn_addresses": sorted,
                "propagation_threshold": threshold,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap I Ã¢â‚¬â€ recover_structs (lifts to MCP via raw instructions) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct RecoverStructsTool;

impl RecoverStructsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "decompiler_recover_structs".to_string(),
            description:
                "Run the gap-I struct-field recovery pass over a function. \
                 Returns recovered struct candidates (stack frames, heap roots, \
                 register-rooted memory clusters) with field offsets and widths."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["binary_path", "addr"],
                "properties": {
                    "binary_path": { "type": "string" },
                    "addr":        { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for RecoverStructsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let binary_path = args
            .get("binary_path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'binary_path'".into()))?;
        let addr = args
            .get("addr")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".into()))?;

        let mut opts = rustre_decompiler::DecompOptions::default();
        opts.passes.emit_struct_fields = true;

        let func =
            rustre_decompiler::decompile_function_from_binary(
                std::path::Path::new(binary_path),
                addr,
                opts,
            )
            .map_err(|e| McpError::InternalError(format!("decompile failed: {e}")))?;

        // Surface recovered structs from the function's variables and annotations.
        let vars: Vec<Value> = func
            .variables
            .iter()
            .map(|v| {
                json!({
                    "name": v.name,
                    "type": v.type_str,
                    "is_parameter": v.is_parameter,
                    "storage": format!("{:?}", v.storage),
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "binary_path": binary_path,
                "addr":        addr,
                "name":        func.name,
                "variables":   vars,
                "variable_count": func.variables.len(),
                "source": func.pseudo_code,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ gap E Ã¢â‚¬â€ stack_frame_report (async wrapper around builtin sync tool) Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct StackFrameReportAsyncTool;

impl StackFrameReportAsyncTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "decompiler_stack_frame_report".to_string(),
            description:
                "Build a stack-frame report (locals, prologue/epilogue, \
                 struct-on-stack candidates) for a function from a \
                 caller-supplied instruction list."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["function_addr", "instructions"],
                "properties": {
                    "function_addr": { "type": "integer" },
                    "instructions":  { "type": "array" },
                    "arch":          { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for StackFrameReportAsyncTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use crate::builtin_tools::StackFrameReportTool;
        use crate::tool_executor::ToolHandler as SyncToolHandler;
        let v = StackFrameReportTool
            .execute(&args)
            .map_err(|e| McpError::InternalError(e))?;
        Ok(ToolResult::text(v.to_string()))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ patch_pe_security_summary Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `pe_security_summary_from_path` as an MCP tool.
///
/// When no in-memory session buffer is available the MCP wrapper must load the
/// binary from the caller-supplied `path` Ã¢â‚¬â€ exactly what `_from_path` does.
pub struct PatchPeSecuritySummaryTool;

impl PatchPeSecuritySummaryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_pe_security_summary".to_string(),
            description:
                "Parse a PE binary and return its security flags (ASLR, DEP, CFG, \
                 SEH, signing) from the optional-header DllCharacteristics field."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the PE binary" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchPeSecuritySummaryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let summary = rustre_patch::pe_security_summary_from_path(path)
            .map_err(|e| McpError::InternalError(format!("pe_security_summary: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path": path,
                "aslr":                 summary.flags.aslr(),
                "dep":                  summary.flags.dep(),
                "cfg":                  summary.flags.cfg(),
                "force_integrity":      summary.flags.force_integrity(),
                "no_seh":               summary.flags.no_seh(),
                "no_isolation":         summary.flags.no_isolation(),
                "no_bind":              summary.flags.no_bind(),
                "terminal_server_aware":summary.flags.terminal_server_aware(),
                "is_64bit":             summary.is_64bit,
                "dll_characteristics":  summary.dll_characteristics,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ patch_patch_find_code_caves Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `find_code_caves_from_path` as an MCP tool.
///
/// Loads the file at `path` directly so the tool works without an active
/// session buffer, mirroring the `loader_pe_*` path-accepting convention.
pub struct PatchFindCodeCavesTool;

impl PatchFindCodeCavesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_patch_find_code_caves".to_string(),
            description:
                "Scan a PE or ELF binary for executable code caves (aligned runs \
                 of 0x00/0xCC/0x90 padding bytes) suitable for inline detour stubs."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path":     { "type": "string",  "description": "Absolute path to the binary" },
                    "min_size": { "type": "integer",  "description": "Minimum cave size in bytes (default 16)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchFindCodeCavesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let min_size = args
            .get("min_size")
            .and_then(Value::as_u64)
            .map(|n| n as usize)
            .unwrap_or(16);
        let caves = rustre_patch::find_code_caves_from_path(path, min_size)
            .map_err(|e| McpError::InternalError(format!("find_code_caves: {e}")))?;
        let caves_json: Vec<Value> = caves
            .iter()
            .map(|c| {
                json!({
                    "section":        c.section,
                    "file_offset":    c.file_offset,
                    "virtual_address":c.virtual_address,
                    "size":           c.size,
                    "fill_byte":      c.fill_byte,
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "path":     path,
                "min_size": min_size,
                "count":    caves_json.len(),
                "caves":    caves_json,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ triage_entropy_packing_indicators Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Expose `PackingDetector::detect_packing_indicators_from_path` as an MCP tool.
///
/// Loads the binary from `path` and walks the real PE import descriptor table
/// to count DLLs, so the import-count heuristic works on large PEs whose
/// import tables fall beyond any fixed probe window.
pub struct TriageEntropyPackingIndicatorsTool;

impl TriageEntropyPackingIndicatorsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "triage_entropy_packing_indicators".to_string(),
            description:
                "Detect common packing/obfuscation indicators in a binary: high \
                 .text entropy, UPX magic, known packer section names, few \
                 real imports (PE import-descriptor walk), and data overlays."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the binary" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TriageEntropyPackingIndicatorsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let indicators =
            rustre_triage_entropy::PackingDetector::detect_packing_indicators_from_path(path)
                .map_err(|e| McpError::InternalError(format!("packing_indicators: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path":              path,
                "is_likely_packed":  !indicators.is_empty(),
                "indicator_count":   indicators.len(),
                "indicators":        indicators,
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ demangle Ã¢â‚¬â€ is_constructor / is_destructor Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Return `true` if the mangled symbol denotes a constructor.
pub struct DemangleIsConstructorTool;

impl DemangleIsConstructorTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "demangle_is_constructor".to_string(),
            description:
                "Return true if the given mangled symbol names a C++/Rust constructor \
                 (delegates to rustre_demangle::is_constructor)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "mangled": { "type": "string" }
                },
                "required": ["mangled"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DemangleIsConstructorTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let mangled = args
            .get("mangled")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'mangled'".to_string()))?;
        let is_ctor = rustre_demangle::is_constructor(mangled);
        Ok(ToolResult::text(
            json!({
                "mangled": mangled,
                "is_constructor": is_ctor,
                "source": "rustre_demangle::is_constructor",
            })
            .to_string(),
        ))
