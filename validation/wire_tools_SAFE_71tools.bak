/// Expose `rustre_arch_luajit::instr_op` as an MCP tool.
pub struct LuajitInstrOpTool;

impl LuajitInstrOpTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "luajit_instr_op".to_string(),
            description: "Extract the opcode byte from a raw 32-bit LuaJIT instruction word.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["word"],
                "properties": {
                    "word": { "type": "integer", "description": "Raw 32-bit LuaJIT instruction word" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LuajitInstrOpTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let word = args.get("word").and_then(Value::as_u64).ok_or_else(|| {
            McpError::InvalidParams("missing 'word' (integer)".to_string())
        })?;
        let word = u32::try_from(word & 0xffff_ffff).unwrap_or(0);
        let op = rustre_arch_luajit::instr_op(word);
        Ok(ToolResult::text(
            json!({ "op": op, "hex": format!("{:02X}", op) }).to_string(),
        ))
    }
}

