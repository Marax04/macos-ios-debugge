fn hex_to_bytes_swin(hex: &str) -> Vec<u8> {
    let cleaned: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
    (0..cleaned.len()).step_by(2)
        .filter_map(|i| cleaned.get(i..i+2).and_then(|b| u8::from_str_radix(b, 16).ok()))
        .collect()
}

