/// Check whether TTD recording is available on the current platform.
pub struct TtdRecorderCheckPlatformSupportTool;

impl TtdRecorderCheckPlatformSupportTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_recorder_check_platform_support".to_string(),
            description: "Return whether the host platform supports TTD recording \
                (delegates to rustre_ttd_recorder::check_platform_support)."
                .to_string(),
            input_schema: json!({ "type": "object", "properties": {} }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdRecorderCheckPlatformSupportTool {
    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let (supported, message) = match rustre_ttd_recorder::check_platform_support() {
            Ok(()) => (true, String::from("supported")),
            Err(e) => (false, e.to_string()),
        };
        Ok(ToolResult::text(
            json!({
                "supported": supported,
                "message": message,
                "source": "rustre_ttd_recorder::check_platform_support",
            })
            .to_string(),
        ))
    }
}

/// Validate a TTD trace file path.
pub struct TtdRecorderValidateTraceTool;

impl TtdRecorderValidateTraceTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ttd_recorder_validate_trace".to_string(),
            description: "Validate a TTD trace file at the given path \
                (rustre_ttd_recorder::TtdTraceValidation::validate)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string" } },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TtdRecorderValidateTraceTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let res = rustre_ttd_recorder::TtdTraceValidation::validate(path)
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        let val = serde_json::to_value(&res)
            .map_err(|e| McpError::InternalError(e.to_string()))?;
        Ok(ToolResult::text(
            json!({
                "validation": val,
                "source": "rustre_ttd_recorder::TtdTraceValidation::validate",
            })
            .to_string(),
        ))
    }
}

