// ── rustre-mobile-ios extra wrappers ────────────────────────────────────────
fn __ios_hex_decode(s: &str) -> Vec<u8> { let clean: String = s.chars().filter(|c| !c.is_whitespace()).collect(); let mut out = Vec::with_capacity(clean.len()/2); let b = clean.as_bytes(); let mut i = 0; while i + 1 < b.len() { if let (Some(h), Some(l)) = ((b[i] as char).to_digit(16), (b[i+1] as char).to_digit(16)) { out.push(((h<<4)|l) as u8); } i += 2; } out }

