/// Wrap `ApktoolError` variants and return their `Display` string.
pub struct MobileApktoolErrorDisplayTool;

impl MobileApktoolErrorDisplayTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mobile_apktool_error_display".to_string(),
            description:
                "Format a rustre_mobile_apktool::ApktoolError variant as its Display string."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "variant": {
                        "type": "string",
                        "enum": ["not_found", "decode", "build", "io"]
                    },
                    "message": { "type": "string" }
                },
                "required": ["variant", "message"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MobileApktoolErrorDisplayTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let variant = args
            .get("variant")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'variant'".into()))?;
        let message = args
            .get("message")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'message'".into()))?
            .to_string();
        let err = match variant {
            "not_found" => rustre_mobile_apktool::ApktoolError::NotFound(message),
            "decode" => rustre_mobile_apktool::ApktoolError::Decode(message),
            "build" => rustre_mobile_apktool::ApktoolError::Build(message),
            "io" => rustre_mobile_apktool::ApktoolError::Io(message),
            other => {
                return Err(McpError::InvalidParams(format!(
                    "unknown variant '{other}'"
                )));
            }
        };
        Ok(ToolResult::text(
            json!({
                "variant": variant,
                "display": err.to_string(),
                "source": "rustre_mobile_apktool::ApktoolError::Display",
            })
            .to_string(),
        ))
    }
}

