/// Look up a base-schema migration by version number.
pub struct DbBaseMigrationsFindByVersionTool;

impl DbBaseMigrationsFindByVersionTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "db_base_migrations_find_by_version".to_string(),
            description:
                "Return the (version, name) of the canonical base-schema migration \
                 with the given `version`, or null if none matches."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["version"],
                "properties": {
                    "version": { "type": "integer", "minimum": 0 }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for DbBaseMigrationsFindByVersionTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let version = args
            .get("version")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'version'".into()))?;
        let v32 = u32::try_from(version)
            .map_err(|_| McpError::InvalidParams("'version' out of u32 range".into()))?;
        let migs = rustre_db::base_migrations();
        let found = migs
            .iter()
            .find(|m| m.version.0 == v32)
            .map(|m| json!({ "version": m.version.0, "name": m.name }));
        Ok(ToolResult::text(
            json!({
                "query":  v32,
                "found":  found,
                "source": "rustre_db::base_migrations",
            })
            .to_string(),
        ))
    }
}

// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ ADB wrappers Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

pub struct AdbComputeCrc32Tool;

impl AdbComputeCrc32Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_compute_crc32".to_string(),
            description: "Compute the ADB wire-protocol CRC (byte-sum mod 2^32) over a hex-encoded payload."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": {
                    "hex": { "type": "string", "description": "Hex-encoded payload bytes" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbComputeCrc32Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let clean: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
        if clean.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex length must be even".into()));
        }
        let mut bytes = Vec::with_capacity(clean.len() / 2);
        for i in (0..clean.len()).step_by(2) {
            let b = u8::from_str_radix(&clean[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))?;
            bytes.push(b);
        }
        let crc = rustre_adb::compute_crc32(&bytes);
        Ok(ToolResult::text(
            json!({ "len": bytes.len(), "crc32": crc }).to_string(),
        ))
    }
}

