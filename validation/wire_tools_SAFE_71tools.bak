/// Add an IOC to a fresh ThreatIndicatorDatabase and look it up by value.
pub struct ThreatintelIndicatorLookupTool;

impl ThreatintelIndicatorLookupTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "threatintel_indicator_lookup".to_string(),
            description:
                "Insert a single SHA-256 IOC into a fresh ThreatIndicatorDatabase \
                 and return the number of matches for its value."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "value": { "type": "string" },
                    "threat_name": { "type": "string" }
                },
                "required": ["value"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ThreatintelIndicatorLookupTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let value = args
            .get("value")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'value'".to_string()))?;
        let threat_name = args
            .get("threat_name")
            .and_then(Value::as_str)
            .unwrap_or("unknown");
        let mut db = rustre_threatintel::ThreatIndicatorDatabase::new();
        db.add_ioc(rustre_threatintel::ThreatIoc::new(
            rustre_threatintel::IocType::Sha256,
            value,
            threat_name,
            0.8,
            "wire-tool",
        ));
        let hits = db.lookup(value).len();
        Ok(ToolResult::text(
            json!({
                "value": value,
                "matches": hits,
                "db_size": db.len(),
                "source": "rustre_threatintel::ThreatIndicatorDatabase::lookup",
            })
            .to_string(),
        ))
    }
}

