            name: "symb_z3_prove_equiv_reflex".to_string(),
            description: "Prove Const(v,bits) == Const(v,bits).".to_string(),
            input_schema: json!({"type":"object","properties":{"v":{"type":"integer"},"bits":{"type":"integer"}}}),
            parameters: Value::Null,
        }
    }
}
