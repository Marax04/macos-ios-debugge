/// Expose `rustre_arch_bpf::lookup_helper` as an MCP tool.
pub struct BpfLookupHelperTool;

impl BpfLookupHelperTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "bpf_lookup_helper".to_string(),
            description: "Look up a BPF helper by its numeric ID.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["id"],
                "properties": {
                    "id": { "type": "integer", "description": "Helper ID" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for BpfLookupHelperTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let id = args
            .get("id")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'id'".into()))? as u32;
        let out = match rustre_arch_bpf::lookup_helper(id) {
            Some(h) => json!({
                "found": true,
                "id": h.id,
                "name": h.name,
                "proto": h.proto,
                "may_sleep": h.may_sleep,
                "pkt_access": h.pkt_access,
            }),
            None => json!({ "found": false }),
        };
        Ok(ToolResult::text(out.to_string()))
    }
}

