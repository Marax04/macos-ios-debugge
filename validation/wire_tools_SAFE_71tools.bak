fn win32_entry_to_json(e: &rustre_syscalls_windows::Win32ApiEntry) -> Value {
    json!({
        "name":      e.name,
        "module":    e.module,
        "category":  format!("{:?}", e.category),
        "arg_count": e.arg_count,
        "is_wide":   e.is_wide,
    })
}

pub struct SyscallsWindowsLookupWin32ApiTool;

impl SyscallsWindowsLookupWin32ApiTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "syscalls_windows_lookup_win32_api".to_string(),
            description:
                "Look up a Win32 API entry by exact name in the built-in Win32 API database."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": { "name": { "type": "string" } },
                "required": ["name"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SyscallsWindowsLookupWin32ApiTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args
            .get("name")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'name'".into()))?;
        let entry = rustre_syscalls_windows::lookup_win32_api(name);
        Ok(ToolResult::text(
            json!({
                "found":  entry.is_some(),
                "entry":  entry.map(win32_entry_to_json),
                "source": "rustre_syscalls_windows::lookup_win32_api",
            })
            .to_string(),
        ))
