// Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬ triage_entropy_shannon_path Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬Ã¢â€â‚¬

/// Compute Shannon entropy (f64, 0.0-8.0) of a file at `path`.
pub struct TriageEntropyShannonPathTool;

impl TriageEntropyShannonPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "triage_entropy_shannon_path".to_string(),
            description: "Compute Shannon entropy (f64, 0.0-8.0) of a whole file at `path`.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": { "path": { "type": "string" } }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TriageEntropyShannonPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args.get("path").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let data = std::fs::read(path)
            .map_err(|e| McpError::InternalError(format!("read {path}: {e}")))?;
        let h = rustre_triage_entropy::shannon_entropy(&data);
        Ok(ToolResult::text(json!({ "path": path, "size": data.len(), "entropy": h }).to_string()))
    }
}

