            name: "emu_base_mem_perms_flags".into(),
            description: "Decode a MemPerms bitmask into READ/WRITE/EXEC booleans.".into(),
            input_schema: json!({"type":"object","properties":{"bits":{"type":"integer"}},"required":["bits"]}),
            parameters: Value::Null,
        }
    }
