            name: "mem_page_index".to_string(),
            description: "Compute the page index for an address given a page size (rustre_mem::page_index).".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["addr", "page_size"],
                "properties": {
                    "addr": { "type": "integer", "description": "Address (u64)" },
                    "page_size": { "type": "integer", "description": "Page size (non-zero)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MemPageIndexTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let addr = args.get("addr").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".into()))?;
        let page_size = args.get("page_size").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'page_size'".into()))?;
        if page_size == 0 {
            return Err(McpError::InvalidParams("'page_size' must be non-zero".into()));
        }
        let idx = rustre_mem::page_index(rustre_core::address::Address::new(addr), page_size);
        Ok(ToolResult::text(
            json!({ "addr": addr, "page_size": page_size, "page_index": idx, "source": "rustre_mem::page_index" }).to_string(),
        ))
    }
}

