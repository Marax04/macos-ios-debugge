/// import tables fall beyond any fixed probe window.
pub struct TriageEntropyPackingIndicatorsTool;

impl TriageEntropyPackingIndicatorsTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "triage_entropy_packing_indicators".to_string(),
            description:
                "Detect common packing/obfuscation indicators in a binary: high \
                 .text entropy, UPX magic, known packer section names, few \
                 real imports (PE import-descriptor walk), and data overlays."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the binary" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for TriageEntropyPackingIndicatorsTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let indicators =
            rustre_triage_entropy::PackingDetector::detect_packing_indicators_from_path(path)
                .map_err(|e| McpError::InternalError(format!("packing_indicators: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path":              path,
                "is_likely_packed":  !indicators.is_empty(),
                "indicator_count":   indicators.len(),
                "indicators":        indicators,
            })
            .to_string(),
        ))
    }
}

