// ─── PPC encoders (rustre_arch_ppc) ────────────────────────────────────────

/// Expose `rustre_arch_ppc::encode_bl` as an MCP tool.
pub struct PpcEncodeBlTool;

impl PpcEncodeBlTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ppc_encode_bl".to_string(),
            description: "Encode a PowerPC BL (branch-and-link) instruction from a 4-byte-aligned displacement.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["disp"],
                "properties": {
                    "disp": { "type": "integer", "description": "Signed branch displacement (bytes, multiple of 4)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PpcEncodeBlTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let disp = args.get("disp").and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'disp'".into()))?;
        let d = i32::try_from(disp)
            .map_err(|_| McpError::InvalidParams("'disp' out of i32 range".into()))?;
        if d % 4 != 0 {
            return Err(McpError::InvalidParams("'disp' must be a multiple of 4".into()));
        }
        let encoded = rustre_arch_ppc::encode_bl(d);
        Ok(ToolResult::text(
            json!({ "disp": d, "encoded": encoded, "hex": format!("{encoded:08X}") }).to_string(),
        ))
    }
}

/// Expose `rustre_arch_ppc::encode_lis` as an MCP tool.
pub struct PpcEncodeLisTool;

impl PpcEncodeLisTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "ppc_encode_lis".to_string(),
            description: "Encode a PowerPC LIS rd,imm (load-immediate-shifted) instruction.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["rd", "imm"],
                "properties": {
                    "rd": { "type": "integer", "description": "Destination GPR (0..=31)" },
                    "imm": { "type": "integer", "description": "Signed 16-bit immediate" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PpcEncodeLisTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let rd = args.get("rd").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'rd'".into()))?;
        let imm = args.get("imm").and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'imm'".into()))?;
        let rd_u = u32::try_from(rd)
            .map_err(|_| McpError::InvalidParams("'rd' out of u32 range".into()))?;
        let imm_i = i32::try_from(imm)
            .map_err(|_| McpError::InvalidParams("'imm' out of i32 range".into()))?;
        if !(-32768..=32767).contains(&imm_i) {
            return Err(McpError::InvalidParams("'imm' out of signed 16-bit range".into()));
        }
        let encoded = rustre_arch_ppc::encode_lis(rd_u, imm_i);
        Ok(ToolResult::text(
            json!({ "rd": rd_u, "imm": imm_i, "encoded": encoded, "hex": format!("{encoded:08X}") }).to_string(),
        ))
    }
}

