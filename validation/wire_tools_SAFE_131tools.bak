// ─── rustre-arch-x86: disassemble_and_lift / lift_to_llil wrappers ──────────

/// Decode + lift every instruction via [`rustre_arch_x86::disassemble_and_lift`].
pub struct ArchX86DisassembleAndLiftTool;

impl ArchX86DisassembleAndLiftTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_x86_disassemble_and_lift".to_string(),
            description:
                "Linear-decode + lift every instruction in the byte buffer \
                 using rustre_arch_x86::disassemble_and_lift."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "ip":    { "type": "integer" },
                    "bits":  { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchX86DisassembleAndLiftTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let ip = args.get("ip").and_then(Value::as_u64).unwrap_or(0);
        let bits_u = args.get("bits").and_then(Value::as_u64).unwrap_or(64);
        let bits: u8 = u8::try_from(bits_u)
            .map_err(|_| McpError::InvalidParams("bits out of range".into()))?;
        let out = rustre_arch_x86::disassemble_and_lift(&data, ip, bits);
        let items: Vec<Value> = out
            .into_iter()
            .map(|(addr, ops)| json!({ "ip": addr, "op_count": ops.len() }))
            .collect();
        Ok(ToolResult::text(
            json!({
                "count": items.len(),
                "instructions": items,
                "bytes": data.len(),
                "ip": ip,
                "bits": bits,
                "source_hex": hex_encode(&data),
            })
            .to_string(),
        ))
    }
}

/// Decode one iced-x86 instruction and lift via [`rustre_arch_x86::lift_to_llil`].
pub struct ArchX86LiftToLlilTool;

impl ArchX86LiftToLlilTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_x86_lift_to_llil".to_string(),
            description:
                "Decode one x86 instruction from bytes and lift it to LLIL \
                 via rustre_arch_x86::lift_to_llil."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "ip":    { "type": "integer" },
                    "bits":  { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchX86LiftToLlilTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let ip = args.get("ip").and_then(Value::as_u64).unwrap_or(0);
        let bits_u = args.get("bits").and_then(Value::as_u64).unwrap_or(64);
        let bits: u32 = u32::try_from(bits_u)
            .map_err(|_| McpError::InvalidParams("bits out of range".into()))?;
        if data.is_empty() {
            return Err(McpError::InvalidParams("empty byte buffer".into()));
        }
        let mut decoder = iced_x86::Decoder::with_ip(
            bits,
            &data,
            ip,
            iced_x86::DecoderOptions::NONE,
        );
        let instr = decoder.decode();
        if instr.is_invalid() {
            return Err(McpError::InvalidParams(format!(
                "iced-x86 could not decode bytes at {:#x}",
                ip
            )));
        }
        let ops = rustre_arch_x86::lift_to_llil(&instr);
        Ok(ToolResult::text(
            json!({
                "ip": instr.ip(),
                "len": instr.len(),
                "op_count": ops.len(),
                "bytes": data.len(),
                "bits": bits,
                "source_hex": hex_encode(&data),
            })
            .to_string(),
        ))
    }
}

