// ─── patch_pe_security_summary ──────────────────────────────────────────────

/// Expose `pe_security_summary_from_path` as an MCP tool.
///
/// When no in-memory session buffer is available the MCP wrapper must load the
/// binary from the caller-supplied `path` — exactly what `_from_path` does.
pub struct PatchPeSecuritySummaryTool;

impl PatchPeSecuritySummaryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_pe_security_summary".to_string(),
            description:
                "Parse a PE binary and return its security flags (ASLR, DEP, CFG, \
                 SEH, signing) from the optional-header DllCharacteristics field."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path": { "type": "string", "description": "Absolute path to the PE binary" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchPeSecuritySummaryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let summary = rustre_patch::pe_security_summary_from_path(path)
            .map_err(|e| McpError::InternalError(format!("pe_security_summary: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "path": path,
                "aslr":                 summary.flags.aslr(),
                "dep":                  summary.flags.dep(),
                "cfg":                  summary.flags.cfg(),
                "force_integrity":      summary.flags.force_integrity(),
                "no_seh":               summary.flags.no_seh(),
                "no_isolation":         summary.flags.no_isolation(),
                "no_bind":              summary.flags.no_bind(),
                "terminal_server_aware":summary.flags.terminal_server_aware(),
                "is_64bit":             summary.is_64bit,
                "dll_characteristics":  summary.dll_characteristics,
            })
            .to_string(),
        ))
    }
}

// ─── patch_patch_find_code_caves ─────────────────────────────────────────────

/// Expose `find_code_caves_from_path` as an MCP tool.
///
/// Loads the file at `path` directly so the tool works without an active
/// session buffer, mirroring the `loader_pe_*` path-accepting convention.
pub struct PatchFindCodeCavesTool;

impl PatchFindCodeCavesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "patch_patch_find_code_caves".to_string(),
            description:
                "Scan a PE or ELF binary for executable code caves (aligned runs \
                 of 0x00/0xCC/0x90 padding bytes) suitable for inline detour stubs."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["path"],
                "properties": {
                    "path":     { "type": "string",  "description": "Absolute path to the binary" },
                    "min_size": { "type": "integer",  "description": "Minimum cave size in bytes (default 16)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PatchFindCodeCavesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let min_size = args
            .get("min_size")
            .and_then(Value::as_u64)
            .map(|n| n as usize)
            .unwrap_or(16);
        let caves = rustre_patch::find_code_caves_from_path(path, min_size)
            .map_err(|e| McpError::InternalError(format!("find_code_caves: {e}")))?;
        let caves_json: Vec<Value> = caves
            .iter()
            .map(|c| {
                json!({
                    "section":        c.section,
                    "file_offset":    c.file_offset,
                    "virtual_address":c.virtual_address,
                    "size":           c.size,
                    "fill_byte":      c.fill_byte,
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "path":     path,
                "min_size": min_size,
                "count":    caves_json.len(),
                "caves":    caves_json,
            })
            .to_string(),
        ))
    }
}

