    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "mips_gpr_name".to_string(),
            description: "Return the canonical MIPS GPR name for a register index (0..31)."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "index": { "type": "integer", "minimum": 0, "maximum": 31 }
                },
                "required": ["index"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for MipsGprNameTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let idx = args
            .get("index")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'index' (0..31)".into()))?;
        let idx_us = usize::try_from(idx)
            .map_err(|_| McpError::InvalidParams("'index' out of range".into()))?;
        if idx_us > 31 {
            return Err(McpError::InvalidParams("'index' must be 0..31".into()));
        }
        let name = rustre_arch_mips::gpr(idx_us);
        Ok(ToolResult::text(
            json!({ "index": idx_us, "name": name }).to_string(),
        ))
    }
}

fn wire_hex_decode_cil(s: &str) -> Result<Vec<u8>, McpError> {
    let cleaned: String = s.chars().filter(|c| !c.is_whitespace()).collect();
    let cleaned = cleaned.strip_prefix("0x").unwrap_or(&cleaned).to_string();
    if cleaned.len() % 2 != 0 {
        return Err(McpError::InvalidParams("hex string has odd length".into()));
    }
    (0..cleaned.len())
        .step_by(2)
        .map(|i| {
            u8::from_str_radix(&cleaned[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))
        })
        .collect()
}

/// Decode a .NET compressed unsigned integer from a signature blob.
pub struct ArchCilDecodeCompressedUintTool;

impl ArchCilDecodeCompressedUintTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_cil_decode_compressed_uint".to_string(),
            description:
                "Decode a .NET ECMA-335 compressed unsigned integer from a signature blob via \
                 rustre_arch_cil::decode_compressed_uint. Returns (value, bytes_consumed)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "data_hex": { "type": "string", "description": "Signature blob bytes as hex string" }
                },
                "required": ["data_hex"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchCilDecodeCompressedUintTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let s = args
            .get("data_hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'data_hex' string".into()))?;
        let bytes = wire_hex_decode_cil(s)?;
        match rustre_arch_cil::decode_compressed_uint(&bytes) {
            Ok((value, consumed)) => Ok(ToolResult::text(
                json!({
                    "value": value,
                    "consumed": consumed,
                    "source": "rustre_arch_cil::decode_compressed_uint",
                })
                .to_string(),
            )),
            Err(e) => Err(McpError::InvalidParams(format!("decode error: {e}"))),
        }
    }
}

