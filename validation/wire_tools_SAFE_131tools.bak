}

#[async_trait]
impl ToolHandler for LuajitInstrOpTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let word = args.get("word").and_then(Value::as_u64).ok_or_else(|| {
            McpError::InvalidParams("missing 'word' (integer)".to_string())
        })?;
        let word = u32::try_from(word & 0xffff_ffff).unwrap_or(0);
