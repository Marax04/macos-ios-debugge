//! Cross-cutting MCP tool wrappers wired during the wire-mcp phase.
//!
//! Each tool here exposes a previously-implemented analysis primitive
//! (gap A / D / F / G / H / I / J / K) as a structured-output MCP tool.
//! Handlers are thin wrappers that delegate to the underlying analysis
//! crate and return JSON suitable for direct consumption by external
//! clients (Claude, IDE plugins, agents).

use async_trait::async_trait;
use rustre_mcp_server::{McpError, ToolDefinition, ToolHandler, ToolResult};
use serde_json::{json, Value};

use crate::{args_to_bytes, hex_encode};

// ─── Shared helpers ─────────────────────────────────────────────────────────

fn extract_byte_array(
    args: &Value,
    key: &str,
    hex_key: &str,
) -> Result<Vec<u8>, McpError> {
    if let Some(arr) = args.get(key).and_then(Value::as_array) {
        return arr
            .iter()
            .map(|v| {
                v.as_u64()
                    .ok_or_else(|| McpError::InvalidParams(format!("{key}: not integer")))
                    .and_then(|n| {
                        u8::try_from(n).map_err(|_| {
                            McpError::InvalidParams(format!("{key}: byte out of range"))
                        })
                    })
            })
            .collect();
    }
    if let Some(hex) = args.get(hex_key).and_then(Value::as_str) {
        return crate::hex_decode(hex);
    }
    Err(McpError::InvalidParams(format!(
        "missing '{key}' or '{hex_key}'"
    )))
}

// ─── gap G — loader_core_md5 ────────────────────────────────────────────────

/// Compute the canonical MD5 used by the loader / triage pipelines.
///
/// Mirrors `rustre_loader::md5`, which is the same MD5 that triage
/// embeds into `TriageResult.md5` / `TriageReport.md5`.
pub struct LoaderCoreMd5Tool;

impl LoaderCoreMd5Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "loader_core_md5".to_string(),
            description:
                "Compute MD5 over arbitrary bytes using the canonical loader \
                 hash routine (same digest used by triage and RichLoadResult)."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for LoaderCoreMd5Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let data = args_to_bytes(&args)?;
        let digest = rustre_loader::md5(&data);
        Ok(ToolResult::text(
            json!({
                "md5": digest,
                "bytes": data.len(),
                "source": "rustre_loader::md5",
            })
            .to_string(),
        ))
    }
}

// ─── gap D — analysis_xref_call_graph / get_xrefs_to / get_xrefs_from ───────

fn build_xref_index(args: &Value) -> Result<rustre_analysis_xref::BinaryXrefIndex, McpError> {
    let code = args_to_bytes(args)?;
    let base = args.get("base").and_then(Value::as_u64).unwrap_or(0);
    let arch = args
        .get("arch")
        .and_then(Value::as_str)
        .unwrap_or("x86_64");
    Ok(rustre_analysis_xref::BinaryXrefIndex::build_from_binary(
        &code, base, arch,
    ))
}

/// Build the inter-procedural call graph from a byte buffer.
pub struct AnalysisXrefCallGraphTool;

impl AnalysisXrefCallGraphTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_xref_call_graph".to_string(),
            description:
                "Build a directed call-graph (edges = E8/E9/Jcc + indirect FF /2 \
                 placeholders) from raw code bytes via rustre-analysis-xref."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "base":  { "type": "integer", "description": "Base VA of the code buffer" },
                    "arch":  { "type": "string", "enum": ["x86", "x86_64"] }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisXrefCallGraphTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let idx = build_xref_index(&args)?;
        let mut nodes: std::collections::BTreeSet<u64> = std::collections::BTreeSet::new();
        let mut edges: Vec<Value> = Vec::new();
        for src in idx.all_sources() {
            for x in idx.xrefs_from(src) {
                if matches!(
                    x.kind,
                    rustre_analysis_xref::SimpleXrefKind::Call
                        | rustre_analysis_xref::SimpleXrefKind::Jump
                ) {
                    nodes.insert(x.from);
                    nodes.insert(x.to);
                    edges.push(json!({
                        "from": x.from,
                        "to": x.to,
                        "kind": format!("{:?}", x.kind),
                        "instr_len": x.instr_len,
                    }));
                }
            }
        }
        Ok(ToolResult::text(
            json!({
                "node_count": nodes.len(),
                "edge_count": edges.len(),
                "nodes": nodes.into_iter().collect::<Vec<_>>(),
                "edges": edges,
                "total_xrefs": idx.total(),
            })
            .to_string(),
        ))
    }
}

pub struct AnalysisXrefGetXrefsToTool;

impl AnalysisXrefGetXrefsToTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_xref_get_xrefs_to".to_string(),
            description:
                "Return every xref whose target is `addr` (callers + jumpers + \
                 data refs). Scans bytes via rustre-analysis-xref."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["addr"],
                "properties": {
                    "bytes": { "type": "array", "items": { "type": "integer" } },
                    "hex":   { "type": "string" },
                    "base":  { "type": "integer" },
                    "arch":  { "type": "string" },
                    "addr":  { "type": "integer" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisXrefGetXrefsToTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let addr = args
            .get("addr")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'addr'".into()))?;
        let idx = build_xref_index(&args)?;
        let xrefs: Vec<Value> = idx
            .xrefs_to(addr)
            .iter()
            .map(|x| {
                json!({
                    "from": x.from,
                    "to": x.to,
                    "kind": format!("{:?}", x.kind),
                    "instr_len": x.instr_len,
                })
            })
            .collect();
        Ok(ToolResult::text(
            json!({
                "addr": addr,
                "count": xrefs.len(),
                "xrefs": xrefs,
                "callers": idx.callers_of(addr),
            })
            .to_string(),
        ))
    }
}

