/// Expose `rustre_arch_6502::cycles` as an MCP tool.
pub struct Arch6502CyclesTool;

impl Arch6502CyclesTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch6502_cycles".to_string(),
            description: "Return base cycle count for a 6502 opcode, plus optional page-crossing penalty.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["opcode"],
                "properties": {
                    "opcode": { "type": "integer", "description": "Opcode byte (0-255)" },
                    "crossed_page": { "type": "boolean", "description": "Whether a page boundary is crossed" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for Arch6502CyclesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let opcode = args.get("opcode").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'opcode'".into()))?;
        let crossed_page = args.get("crossed_page").and_then(Value::as_bool).unwrap_or(false);
        let opcode_u8 = u8::try_from(opcode & 0xFF).unwrap_or(0);
        let cycles = rustre_arch_6502::cycles(opcode_u8, crossed_page);
        Ok(ToolResult::text(json!({
            "opcode": opcode_u8,
            "crossed_page": crossed_page,
            "cycles": cycles
        }).to_string()))
    }
}

