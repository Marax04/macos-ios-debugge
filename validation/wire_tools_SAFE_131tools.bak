        ToolDefinition {
            name: "pe_editor_cert_header_bytes".to_string(),
            description:
                "Serialize a WIN_CERTIFICATE header via \
                 rustre_pe_editor::CertificateHeader::new(payload_len).to_bytes() \
                 and return the 8-byte little-endian header as hex."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "payload_len": {"type": "integer", "minimum": 0, "description": "PKCS#7 payload length in bytes"}
                },
                "required": ["payload_len"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for PeCertHeaderBytesTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let payload_len = args.get("payload_len").and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'payload_len' u32".into()))?;
        let payload_len = u32::try_from(payload_len)
            .map_err(|_| McpError::InvalidParams("payload_len exceeds u32".into()))?;
        let hdr = rustre_pe_editor::CertificateHeader::new(payload_len);
        let bytes = hdr.to_bytes();
        Ok(ToolResult::text(
            json!({
                "dw_length": hdr.dw_length,
                "w_revision": hdr.w_revision,
                "w_certificate_type": hdr.w_certificate_type,
                "bytes_hex": pe_editor_hex_encode(&bytes),
                "source": "rustre_pe_editor::CertificateHeader::new().to_bytes()",
            })
            .to_string(),
        ))
    }
}

