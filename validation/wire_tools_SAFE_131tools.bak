// ─── rustre-hex-pattern wire tools ──────────────────────────────────────────

pub struct HexPatternCrc16IbmTool;

impl HexPatternCrc16IbmTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_pattern_crc16_ibm".to_string(),
            description:
                "Compute CRC-16/IBM (poly 0x8005, reflected) over the input bytes via \
                 rustre_hex_pattern::crc16_ibm."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "bytes": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "description": "Byte values (u8) to hash"
                    }
                },
                "required": ["bytes"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexPatternCrc16IbmTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let arr = args
            .get("bytes")
            .and_then(Value::as_array)
            .ok_or_else(|| McpError::InvalidParams("missing 'bytes' array".into()))?;
        let mut buf = Vec::with_capacity(arr.len());
        for v in arr {
            let n = v
                .as_u64()
                .ok_or_else(|| McpError::InvalidParams("byte not integer".into()))?;
            buf.push(
                u8::try_from(n)
                    .map_err(|_| McpError::InvalidParams("byte out of u8 range".into()))?,
            );
        }
        let crc = rustre_hex_pattern::crc16_ibm(&buf);
        Ok(ToolResult::text(
            json!({
                "len": buf.len(),
                "crc16": crc,
                "crc16_hex": format!("{crc:04X}"),
                "source": "rustre_hex_pattern::crc16_ibm",
            })
            .to_string(),
        ))
    }
}

pub struct HexPatternParseTool;

impl HexPatternParseTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "hex_pattern_parse".to_string(),
            description:
                "Parse an IDA/HxD-style pattern string via rustre_hex_pattern::Pattern::parse \
                 and report length, exact-byte count, wildcard count, specificity, and \
                 canonical hex form."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "pattern": {
                        "type": "string",
                        "description": "Pattern string with hex bytes and '?' wildcards"
                    }
                },
                "required": ["pattern"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for HexPatternParseTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let pat_str = args
            .get("pattern")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'pattern' string".into()))?;
        let pat = rustre_hex_pattern::Pattern::parse(pat_str)
            .map_err(|e| McpError::InvalidParams(format!("parse error: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "len": pat.len(),
                "exact_count": pat.exact_count(),
                "wildcard_count": pat.wildcard_count(),
                "specificity": pat.specificity(),
                "canonical": pat.to_hex_string(),
                "source": "rustre_hex_pattern::Pattern::parse",
            })
            .to_string(),
        ))
    }
}

