        let id = args
            .get("id")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'id'".into()))? as u32;
        let out = match rustre_arch_bpf::lookup_helper(id) {
            Some(h) => json!({
