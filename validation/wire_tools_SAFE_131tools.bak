/// Format a DEX parameter register name via `rustre_arch_dex::dex_preg`.
pub struct ArchDexPregTool;

impl ArchDexPregTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_dex_preg".to_string(),
            description: "Format a DEX parameter register name via rustre_arch_dex::dex_preg."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "n": { "type": "integer", "description": "Parameter register index (u8)" }
                },
                "required": ["n"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for ArchDexPregTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let n = args
            .get("n")
            .and_then(Value::as_u64)
            .ok_or_else(|| McpError::InvalidParams("missing 'n' (u8)".into()))?;
        let n = u8::try_from(n)
            .map_err(|_| McpError::InvalidParams("'n' out of u8 range".into()))?;
        let name = rustre_arch_dex::dex_preg(n);
        Ok(ToolResult::text(
            json!({
                "n": n,
                "name": name,
                "source": "rustre_arch_dex::dex_preg",
            })
            .to_string(),
        ))
    }
}

