/// Encode a SPARC CALL instruction word from a PC-relative displacement.
pub struct SparcEncodeCallTool;

impl SparcEncodeCallTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "arch_sparc_encode_call".to_string(),
            description: "Encode a SPARC Format 1 CALL instruction word from a 4-byte-aligned \
                          PC-relative displacement via rustre_arch_sparc::encode_call."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "disp": { "type": "integer", "description": "PC-relative displacement in bytes (i32, 4-byte aligned)" }
                },
                "required": ["disp"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SparcEncodeCallTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let disp = args
            .get("disp")
            .and_then(Value::as_i64)
            .ok_or_else(|| McpError::InvalidParams("missing 'disp' (i32)".into()))?;
        let disp_i32 = i32::try_from(disp)
            .map_err(|_| McpError::InvalidParams("'disp' out of i32 range".into()))?;
        if disp_i32 % 4 != 0 {
            return Err(McpError::InvalidParams(
                "'disp' must be 4-byte aligned".into(),
            ));
        }
        let word = rustre_arch_sparc::encode_call(disp_i32);
        Ok(ToolResult::text(
            json!({
                "disp": disp_i32,
                "word": word,
                "hex": format!("0x{word:08X}"),
                "source": "rustre_arch_sparc::encode_call",
            })
            .to_string(),
        ))
    }
}

