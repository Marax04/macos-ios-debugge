/// Expose `rustre_arch_68k::decode_68k` as an MCP tool: decode a single
/// Motorola 68k instruction from hex bytes at a given PC.
pub struct M68kDecodeInstrTool;

impl M68kDecodeInstrTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "m68k_decode_instr".to_string(),
            description: "Decode a single Motorola 68000 instruction from hex bytes at the given PC.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["bytes"],
                "properties": {
                    "bytes": { "type": "string", "description": "Instruction bytes (hex or base64)" },
                    "pc": { "type": "integer", "description": "Program counter of the instruction (default 0)" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for M68kDecodeInstrTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let bytes = args_to_bytes(&args)
            .map_err(|e| McpError::InvalidParams(format!("bad 'bytes': {e}")))?;
        let pc = args.get("pc").and_then(Value::as_u64).unwrap_or(0);
        let (mnemonic, operands, size, flags) = rustre_arch_68k::decode_68k(&bytes, pc)
            .map_err(|e| McpError::ToolError(format!("decode_68k failed: {e}")))?;
        Ok(ToolResult::text(
            json!({
                "pc": pc,
                "mnemonic": mnemonic,
                "operands": operands,
                "size": size,
                "flags": format!("{flags:?}"),
            })
            .to_string(),
        ))
    }
}

/// Expose `rustre_arch_68k::Mc68kVariant` capability queries as an MCP tool.
pub struct M68kVariantInfoTool;

impl M68kVariantInfoTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "m68k_variant_info".to_string(),
            description: "Report capability flags (FPU/MMU/32-bit/address-space) for a Motorola 68k variant.".to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["variant"],
                "properties": {
                    "variant": {
                        "type": "string",
                        "description": "One of: 68000, 68010, 68020, 68030, 68040, 68060, ColdFire"
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for M68kVariantInfoTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let name = args.get("variant").and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'variant'".into()))?;
        let v = match name {
            "68000" => rustre_arch_68k::Mc68kVariant::M68000,
            "68010" => rustre_arch_68k::Mc68kVariant::M68010,
            "68020" => rustre_arch_68k::Mc68kVariant::M68020,
            "68030" => rustre_arch_68k::Mc68kVariant::M68030,
            "68040" => rustre_arch_68k::Mc68kVariant::M68040,
            "68060" => rustre_arch_68k::Mc68kVariant::M68060,
            "ColdFire" | "coldfire" => rustre_arch_68k::Mc68kVariant::ColdFire,
            other => return Err(McpError::InvalidParams(format!("unknown variant '{other}'"))),
        };
        Ok(ToolResult::text(
            json!({
                "variant": v.name(),
                "has_fpu": v.has_fpu(),
                "has_mmu": v.has_mmu(),
                "is_32bit": v.is_32bit(),
                "has_bitfield": v.has_bitfield(),
                "address_space_bytes": v.address_space_bytes(),
            })
            .to_string(),
        ))
    }
}

