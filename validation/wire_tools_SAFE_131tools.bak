// ─── Adapter: bridge async ToolHandler -> sync McpToolHandler ───────────────

/// Adapts a [`Box<dyn ToolHandler>`] (async, returns `ToolResult`) to the
/// sync [`rustre_mcp_server::McpToolHandler`] trait expected by the
/// executor inside [`rustre_mcp_server::RustReMcpServer`].
///
/// The async `call` is driven on the current tokio runtime via
/// `Handle::block_on` (the MCP server's executor is invoked from synchronous
/// dispatch points but always runs inside a tokio runtime — see
/// `run_stdio` / `run_http`).
struct WireToolAdapter {
    name: String,
    inner: Box<dyn rustre_mcp_server::ToolHandler>,
}

impl rustre_mcp_server::McpToolHandler for WireToolAdapter {
    fn name(&self) -> &str {
        &self.name
    }

    fn execute(
        &self,
        params: Value,
    ) -> Result<Value, rustre_mcp_server::McpToolError> {
        // We are called from inside a tokio worker that is in turn driving
        // the rmcp `call_tool` future. Re-entering the *same* runtime via
        // `Handle::block_on` would deadlock (and `block_in_place` only
        // works on the multi-thread flavour, which the umbrella binary
        // happens to use but other embedders may not). Run the async
        // wire-tool body to completion on a tiny dedicated current-thread
        // runtime built in a separate OS thread instead — this is safe
        // regardless of which runtime called us and never re-enters the
        // outer scheduler.
        let inner = &*self.inner;
        let result = std::thread::scope(|s| {
            s.spawn(|| {
                let rt = tokio::runtime::Builder::new_current_thread()
                    .enable_all()
                    .build()
                    .expect("build dedicated current-thread runtime for wire tool");
                rt.block_on(inner.call(params))
            })
            .join()
            .expect("wire-tool worker thread panicked")
        });
        match result {
            Ok(tr) => {
                // Flatten the ToolResult content blocks into a single JSON
                // value. Handlers in this module always emit a single
                // text content block holding a JSON string, so try to
                // re-parse it; fall back to the raw text otherwise.
                if let Some(rustre_mcp_server::ContentBlock::Text { text }) =
                    tr.content.first()
                {
                    if let Ok(v) = serde_json::from_str::<Value>(text) {
                        return Ok(v);
                    }
                    return Ok(Value::String(text.clone()));
                }
                Ok(serde_json::json!({ "is_error": tr.is_error }))
            }
            Err(e) => Err(rustre_mcp_server::McpToolError::ExecutionFailed(
                e.to_string(),
            )),
        }
    }
}

/// Map a wire-tool [`ToolDefinition`] to a server [`McpToolDef`] in the
/// `Analysis` category (good default — all current wire tools are analysis
/// or triage primitives).
fn wire_def_to_catalog(def: &rustre_mcp_server::ToolDefinition) -> rustre_mcp_server::McpToolDef {
    rustre_mcp_server::McpToolDef::new(
        def.name.clone(),
        def.description.clone(),
        def.input_schema.clone(),
        rustre_mcp_server::ToolCategory::Analysis,
    )
}

/// Install every handler returned by [`all_wire_handlers`] into the given
/// server, registering each one in both the catalog and the executor.
///
/// Callers should invoke this once, before wrapping the inner server in the
/// rmcp facade (`RustREMcpServer::from_inner`), so the freshly added tools
/// are visible to `list_tools`.
pub fn wire_into_server(server: &mut rustre_mcp_server::RustReMcpServer) {
    for (def, handler) in all_wire_handlers() {
        let catalog = wire_def_to_catalog(&def);
        let adapter = WireToolAdapter {
            name: def.name.clone(),
            inner: handler,
        };
        server.register_external_tool(catalog, Box::new(adapter));
    }
}

// ─── survey_binary — aggregator tool ────────────────────────────────────────

/// One-shot binary triage aggregator.
///
/// Accepts `session_id` (ignored for now — reserved for future session store
/// integration) and `path` (required: on-disk file to load transiently).
/// Calls multiple sub-routines and merges their results into a single JSON
/// object.  Every sub-call is wrapped so that a failure in one step never
/// aborts the overall response — the error string is placed under that key.
pub struct SurveyBinaryTool;

impl SurveyBinaryTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "survey_binary".to_string(),
            description:
                "One-shot binary triage: load a file and merge results from \
                 the loader, import/section tables, string extraction, function \
                 detection, entropy analysis, and call-target scan into a single \
                 JSON object.  Sub-call failures are recorded per-key rather than \
                 aborting the whole response."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "session_id": {
                        "type": "string",
                        "description": "Reserved: session identifier (unused — pass path instead)"
                    },
                    "path": {
                        "type": "string",
                        "description": "Absolute path to the binary file to survey"
                    }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for SurveyBinaryTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_analysis_fn::{
            CallTargetCollector, DetectedArch, MemorySlice, detect_functions,
        };
        use rustre_core::address::Address;
        use rustre_triage::{FileKind, StringHeuristics, analyze_section_entropy, detect_file_kind};

        // ── Resolve path ───────────────────────────────────────────────────
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;

        // ── Load the binary ────────────────────────────────────────────────
        let load = rustre_decompiler::load_binary(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        let data: &[u8] = &load.data;

        // ── Detect format ──────────────────────────────────────────────────
        let file_kind = detect_file_kind(data);

        // ── loader ─────────────────────────────────────────────────────────
        // Use RichLoadResult fields (already parsed by rustre_decompiler::load_binary)
        // and augment PE files with extra detail via rustre_loader_pe::PeInfo.
        let loader_val: Value = (|| -> Value {
            let base = json!({
                "kind": format!("{file_kind:?}"),
                "format": load.format,
                "arch": load.arch,
                "bits": load.bits,
                "endian": load.endian,
                "entry_point": load.entry_point,
                "base_address": load.base_address,
                "section_count": load.sections.len(),
                "import_count": load.imports.len(),
                "export_count": load.exports.len(),
            });
            // For PE files, attempt to add richer loader data.
            match file_kind {
                FileKind::Pe32
                | FileKind::Pe64
                | FileKind::Exe
                | FileKind::Dll
                | FileKind::Sys => {
                    match rustre_loader_pe::PeInfo::parse(data) {
                        Ok(info) => json!({
                            "kind": format!("{file_kind:?}"),
                            "format": load.format,
                            "arch": format!("{:?}", info.machine),
                            "bits": load.bits,
                            "endian": "little",
                            "entry_point": info.entry_point,
                            "image_base": info.image_base,
                            "is_dll": info.is_dll(),
                            "is_64bit": info.is_64bit(),
                            "checksum": info.checksum,
                            "section_count": info.sections.len(),
                            "import_count": info.imports.len(),
                            "export_count": info.exports.len(),
                        }),
                        Err(e) => {
                            let mut v = base;
                            v["pe_parse_warning"] = json!(e);
                            v
                        }
                    }
                }
                _ => base,
            }
        })();

        // ── imports ────────────────────────────────────────────────────────
        let imports_val: Value = (|| -> Value {
            let imports: Vec<Value> = load
                .imports
                .iter()
                .map(|i| {
                    json!({
                        "dll": i.dll,
                        "name": i.name,
                        "addr": i.addr,
                        "ordinal": i.ordinal,
                    })
                })
                .collect();
            json!({
                "count": imports.len(),
                "imports": imports,
            })
        })();

        // ── sections ───────────────────────────────────────────────────────
        let sections_val: Value = (|| -> Value {
            let sections: Vec<Value> = load
                .sections
                .iter()
                .map(|s| {
                    json!({
                        "name": s.name,
                        "virtual_addr": s.virtual_addr,
                        "virtual_size": s.virtual_size,
                        "raw_offset": s.raw_offset,
                        "raw_size": s.raw_size,
                        "flags": s.flags,
                    })
                })
                .collect();
            json!({
                "count": sections.len(),
                "sections": sections,
            })
        })();

        // ── strings_top20 ──────────────────────────────────────────────────
        // Each hit is decorated with the computed virtual address (VA) by
        // resolving its file offset against the section table when one is
        // available; on formats with no section info we fall back to
        // `image_base + offset` so the VA field is always populated.
        let strings_val: Value = (|| -> Value {
            let all = StringHeuristics::extract_strings(data, 6);
            let image_base = load.base_address;
            let sections = &load.sections;
            let off_to_va = |off: u64| -> u64 {
                for s in sections {
                    let raw_off = s.raw_offset;
                    let raw_size = s.raw_size;
                    if off >= raw_off && off < raw_off + raw_size {
                        return image_base + s.virtual_addr + (off - raw_off);
                    }
                }
                image_base + off
            };
            let top: Vec<Value> = all
                .iter()
                .take(20)
                .map(|s| {
                    let off = s.offset as u64;
                    json!({
                        "value": s.value,
                        "offset": s.offset,
                        "va": off_to_va(off),
                        "encoding": format!("{:?}", s.encoding),
                    })
                })
                .collect();
            json!({
                "total": all.len(),
                "strings_top20": top,
            })
        })();

        // ── function_count ─────────────────────────────────────────────────
        let function_count_val: Value = (|| -> Value {
            let arch = match &load.arch as &str {
                "x86_64" | "amd64" | "x86-64" => DetectedArch::X86_64,
                "x86" | "i386" | "i686" => DetectedArch::X86_32,
                "arm64" | "aarch64" => DetectedArch::Arm64,
                _ => DetectedArch::Unknown,
            };
            let base = load.base_address;
            let mem = MemorySlice::new(Address::new(base), data);
            let set = detect_functions(arch, &mem);
            json!({
                "function_count": set.functions.len(),
                "arch": load.arch,
            })
        })();

        // ── entropy_top ────────────────────────────────────────────────────
        let entropy_val: Value = (|| -> Value {
            let mut blocks = analyze_section_entropy(data);
            blocks.sort_by(|a, b| b.entropy.partial_cmp(&a.entropy).unwrap_or(std::cmp::Ordering::Equal));
            let top: Vec<Value> = blocks
                .iter()
                .take(10)
                .map(|b| {
                    json!({
                        "name": b.name,
                        "offset": b.offset,
                        "size": b.size,
                        "entropy": b.entropy,
                        "rating": format!("{:?}", b.rating),
                    })
                })
                .collect();
            json!({
                "block_count": blocks.len(),
                "entropy_top": top,
            })
        })();

        // ── call_targets_count ─────────────────────────────────────────────
        let call_targets_val: Value = (|| -> Value {
            let arch = match &load.arch as &str {
                "x86_64" | "amd64" | "x86-64" => DetectedArch::X86_64,
                "x86" | "i386" | "i686" => DetectedArch::X86_32,
                "arm64" | "aarch64" => DetectedArch::Arm64,
                _ => DetectedArch::Unknown,
            };
            let base = load.base_address;
            let mem = MemorySlice::new(Address::new(base), data);
            let targets = CallTargetCollector::new(arch).collect(&mem);
            json!({ "call_targets_count": targets.len() })
        })();

        // ── Merge ──────────────────────────────────────────────────────────
        let result = json!({
            "path": path,
            "file_size": data.len(),
            "file_kind": format!("{file_kind:?}"),
            "loader": loader_val,
            "imports": imports_val,
            "sections": sections_val,
            "strings_top20": strings_val,
            "function_count": function_count_val,
            "entropy_top": entropy_val,
            "call_targets_count": call_targets_val,
        });

        Ok(ToolResult::text(result.to_string()))
    }
}

// ─── analysis_fn_detect_functions_path — path-based wrapper ────────────────

/// Path-based wrapper around `rustre_analysis_fn::detect_functions`.
///
/// The existing `analysis_fn_detect_extra` tool only accepts inline byte
/// arrays / hex strings, which is unusable on real binaries.  This tool
/// loads the file with `rustre_decompiler::load_binary`, picks the arch
/// out of the loader report, and emits per-function `(start, end,
/// confidence, source, name)` records that already carry virtual
/// addresses.
pub struct AnalysisFnDetectFunctionsPathTool;

impl AnalysisFnDetectFunctionsPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_fn_detect_functions_path".to_string(),
            description:
                "Detect function boundaries in a binary on disk.  Loads the \
                 file, infers architecture from the loader report, and runs \
                 the full multi-strategy detector.  Returns a list of \
                 functions with virtual addresses, confidence levels, and \
                 the detection source for each one."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Absolute path to the binary file"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Optional cap on the number of functions returned (default 5000)"
                    }
                },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisFnDetectFunctionsPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let limit = args
            .get("limit")
            .and_then(Value::as_u64)
            .map(|v| v as usize)
            .unwrap_or(5000);

        let load = rustre_decompiler::load_binary(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        // The whole-load detector iterates every executable section with the
        // correct VA, merges symbol-table hints, and deduplicates. Calling
        // `detect_functions` on a flat MemorySlice over `load.data` would
        // produce nonsense addresses because raw file offsets are not VAs.
        let boundaries = rustre_decompiler::detect_functions_in_load(&load);

        let total = boundaries.len();
        let funcs: Vec<Value> = boundaries
            .iter()
            .take(limit)
            .map(|f| {
                json!({
                    "start": f.start.as_u64(),
                    "end": f.end.map(|e| e.as_u64()),
                    "confidence": format!("{:?}", f.confidence),
                    "source": format!("{:?}", f.source),
                    "name": f.name,
                })
            })
            .collect();

        let result = json!({
            "path": path,
            "arch": load.arch,
            "image_base": load.base_address,
            "function_count": total,
            "returned": funcs.len(),
            "functions": funcs,
        });
        Ok(ToolResult::text(result.to_string()))
    }
}

// ─── analysis_string_scan_path — path-based wrapper ────────────────────────

/// Path-based wrapper around `rustre_analysis_string::StringScanner`.
///
/// Loads the binary, iterates the loader's section table, and runs the
/// scanner against each readable section with the correct section VA as
/// `base`, so every emitted `FoundString` carries an accurate virtual
/// address.  Useful for direct cross-referencing with disassembly output.
pub struct AnalysisStringScanPathTool;

impl AnalysisStringScanPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_string_scan_path".to_string(),
            description:
                "Scan a binary on disk for ASCII / UTF-8 / UTF-16 strings.  \
                 Walks the loader section table and reports each hit with \
                 its virtual address, encoding, length and value — \
                 equivalent to IDA's strings window."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Absolute path to the binary file"
                    },
                    "min_length": {
                        "type": "integer",
                        "description": "Minimum character count for a string to be reported (default 5)"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum number of strings returned (default 10000)"
                    }
                },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisStringScanPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_analysis_string::{StringScanner, StringScannerConfig};
        use rustre_core::address::Address;

        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let min_length = args
            .get("min_length")
            .and_then(Value::as_u64)
            .map(|v| v as usize)
            .unwrap_or(5);
        let limit = args
            .get("limit")
            .and_then(Value::as_u64)
            .map(|v| v as usize)
            .unwrap_or(10_000);

        let load = rustre_decompiler::load_binary(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        let image_base = load.base_address;
        let mut cfg = StringScannerConfig::default();
        cfg.min_length = min_length;
        let scanner = StringScanner::new(cfg);

        let mut all = Vec::new();
        if load.sections.is_empty() {
            // No section table — fall back to scanning the whole file as
            // one block based at `image_base`.
            all.extend(scanner.scan(Address::new(image_base), &load.data));
        } else {
            for sec in &load.sections {
                let start = usize::try_from(sec.raw_offset).unwrap_or(usize::MAX);
                let size = usize::try_from(sec.raw_size).unwrap_or(0);
                let end = start.saturating_add(size).min(load.data.len());
                if start >= end {
                    continue;
                }
                let va_base = image_base + sec.virtual_addr;
                all.extend(scanner.scan(Address::new(va_base), &load.data[start..end]));
            }
        }
        // Stable order by VA.
        all.sort_by_key(|s| s.address.as_u64());

        let total = all.len();
        let out: Vec<Value> = all
            .into_iter()
            .take(limit)
            .map(|s| {
                json!({
                    "va": s.address.as_u64(),
                    "length": s.length,
                    "encoding": format!("{:?}", s.encoding),
                    "value": s.value,
                })
            })
            .collect();

        let result = json!({
            "path": path,
            "image_base": image_base,
            "total": total,
            "returned": out.len(),
            "strings": out,
        });
        Ok(ToolResult::text(result.to_string()))
    }
}

// ─── analysis_crypto_scan_path — findcrypt with section-resolved VA ────────

/// Path-based findcrypt: scans every loader section for known crypto
/// constants (AES S-box, SHA-1/256/512 IV+K, MD5 IVs, RSA exponents,
/// Curve25519 / NIST primes, ChaCha20 sigma, …) and reports each hit with
/// its file offset, section-resolved virtual address, endianness, and
/// matched algorithm set. Additionally runs a BigNum / RSA-modulus
/// heuristic that flags long runs of zero bytes followed by high-entropy
/// blocks — typical of embedded RSA keys or DH primes the constant table
/// can't catch.
pub struct AnalysisCryptoScanPathTool;

impl AnalysisCryptoScanPathTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "analysis_crypto_scan_path".to_string(),
            description:
                "Findcrypt-style scan. Loads the binary, walks every \
                 section, matches against the full crypto-constant table \
                 (LE+BE), and additionally flags BigNum / RSA-modulus \
                 candidates via a zero-block heuristic. Each hit carries \
                 a section-resolved VA suitable for cross-reference with \
                 disassembly."
                    .to_string(),
            input_schema: json!({
                "type": "object",
                "properties": {
                    "path": {
                        "type": "string",
                        "description": "Absolute path to the binary file"
                    },
                    "min_confidence": {
                        "type": "integer",
                        "description": "Filter out constants below this confidence (0..100, default 0)"
                    },
                    "bignum_min_zeros": {
                        "type": "integer",
                        "description": "Minimum run length of zero bytes to flag a BigNum candidate (default 48)"
                    },
                    "limit": {
                        "type": "integer",
                        "description": "Maximum total findings returned (default 5000)"
                    }
                },
                "required": ["path"]
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AnalysisCryptoScanPathTool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        use rustre_crypto_id::constant_scanner::{ConstSectionInfo, ConstantScanner};

        let path = args
            .get("path")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'path'".into()))?;
        let min_conf = args
            .get("min_confidence")
            .and_then(Value::as_u64)
            .map(|v| v as u8)
            .unwrap_or(0);
        let bignum_min_zeros = args
            .get("bignum_min_zeros")
            .and_then(Value::as_u64)
            .map(|v| v as usize)
            .unwrap_or(48);
        let limit = args
            .get("limit")
            .and_then(Value::as_u64)
            .map(|v| v as usize)
            .unwrap_or(5000);

        let load = rustre_decompiler::load_binary(std::path::Path::new(path))
            .map_err(|e| McpError::InternalError(format!("load failed: {e}")))?;

        let sections: Vec<ConstSectionInfo> = load
            .sections
            .iter()
            .map(|s| ConstSectionInfo {
                file_offset: s.raw_offset,
                file_size: s.raw_size,
                virtual_address: load.base_address + s.virtual_addr,
            })
            .collect();

        let mut scanner = ConstantScanner::new();
        scanner.set_min_confidence(min_conf);
        let hits = scanner.scan_with_sections(&load.data, &sections);

        let mut findings: Vec<Value> = hits
            .iter()
            .map(|h| {
                json!({
                    "kind": "constant",
                    "name": h.constant_name,
                    "algorithms": h.algorithms,
                    "constant_type": format!("{:?}", h.constant_type),
                    "endian": format!("{:?}", h.endian),
                    "confidence": h.confidence,
                    "file_offset": h.file_offset,
                    "length": h.length,
                    "va": h.va,
                })
            })
            .collect();

        // BigNum / RSA-modulus heuristic: scan each section for a window
        // that starts with `bignum_min_zeros` consecutive zero bytes
        // immediately preceding a high-entropy ≥64-byte payload. Real RSA
        // moduli embedded as little-endian arrays show exactly this
        // shape; so do DH/ECDH primes encoded with leading zero padding.
        for sec in &load.sections {
            let start = usize::try_from(sec.raw_offset).unwrap_or(usize::MAX);
            let size = usize::try_from(sec.raw_size).unwrap_or(0);
            let end = start.saturating_add(size).min(load.data.len());
            if start >= end { continue; }
            let slice = &load.data[start..end];
            let mut i = 0usize;
            while i + bignum_min_zeros + 64 <= slice.len() {
                if slice[i] != 0 { i += 1; continue; }
                let mut zlen = 0usize;
                while i + zlen < slice.len() && slice[i + zlen] == 0 { zlen += 1; }
                if zlen >= bignum_min_zeros {
                    let tail_start = i + zlen;
                    let tail_end = (tail_start + 256).min(slice.len());
                    let tail = &slice[tail_start..tail_end];
                    // Reject tails that are themselves mostly zero or
                    // low-entropy ascii: count distinct nonzero bytes.
                    let mut seen = [false; 256];
                    let mut distinct = 0usize;
                    for &b in tail { if b != 0 && !seen[b as usize] { seen[b as usize] = true; distinct += 1; } }
                    if distinct >= 24 {
                        let file_off = start + i;
                        let va = load.base_address + sec.virtual_addr + i as u64;
                        findings.push(json!({
                            "kind": "bignum_candidate",
                            "name": "BIGNUM_ZERO_PADDED",
                            "algorithms": ["RSA", "DH", "ECDH"],
                            "constant_type": "FieldPrime",
                            "endian": "Neutral",
                            "confidence": 55,
                            "file_offset": file_off,
                            "length": zlen + tail.len(),
                            "va": va,
                            "zero_run": zlen,
                            "tail_distinct_bytes": distinct,
                        }));
                    }
                    i += zlen.max(1);
                } else {
                    i += zlen.max(1);
                }
            }
        }

        let total = findings.len();
        findings.truncate(limit);

        let result = json!({
            "path": path,
            "image_base": load.base_address,
            "section_count": load.sections.len(),
            "total": total,
            "returned": findings.len(),
            "findings": findings,
        });
        Ok(ToolResult::text(result.to_string()))
    }
}

// Re-export the silenced `hex_encode` helper as `pub use` so it is wired in
// via the wire module (avoids a dead-code warning for the import above when
// no future tool consumes it).
#[allow(dead_code)]
pub(crate) fn _ensure_hex_encode_wired() -> String {
    hex_encode(&[0u8])
}
