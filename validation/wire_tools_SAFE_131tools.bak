    async fn call(&self, _args: Value) -> Result<ToolResult, McpError> {
        let migs = rustre_db::base_migrations();
        let entries: Vec<Value> = migs
            .iter()
            .map(|m| json!({ "version": m.version.0, "name": m.name }))
            .collect();
        Ok(ToolResult::text(
            json!({
                "count":      entries.len(),
                "migrations": entries,
                "source":     "rustre_db::base_migrations",
            })
            .to_string(),
        ))
    }
}

// ─── ADB wrappers ───────────────────────────────────────────────────────────

pub struct AdbComputeCrc32Tool;

impl AdbComputeCrc32Tool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
            name: "adb_compute_crc32".to_string(),
            description: "Compute the ADB wire-protocol CRC (byte-sum mod 2^32) over a hex-encoded payload."
                .to_string(),
            input_schema: json!({
                "type": "object",
                "required": ["hex"],
                "properties": {
                    "hex": { "type": "string", "description": "Hex-encoded payload bytes" }
                }
            }),
            parameters: Value::Null,
        }
    }
}

#[async_trait]
impl ToolHandler for AdbComputeCrc32Tool {
    async fn call(&self, args: Value) -> Result<ToolResult, McpError> {
        let hex = args
            .get("hex")
            .and_then(Value::as_str)
            .ok_or_else(|| McpError::InvalidParams("missing 'hex'".into()))?;
        let clean: String = hex.chars().filter(|c| !c.is_whitespace()).collect();
        if clean.len() % 2 != 0 {
            return Err(McpError::InvalidParams("hex length must be even".into()));
        }
        let mut bytes = Vec::with_capacity(clean.len() / 2);
        for i in (0..clean.len()).step_by(2) {
            let b = u8::from_str_radix(&clean[i..i + 2], 16)
                .map_err(|e| McpError::InvalidParams(format!("bad hex: {e}")))?;
            bytes.push(b);
        }
        let crc = rustre_adb::compute_crc32(&bytes);
        Ok(ToolResult::text(
            json!({ "len": bytes.len(), "crc32": crc }).to_string(),
        ))
    }
}

pub struct AdbParseLogcatTool;

impl AdbParseLogcatTool {
    #[must_use]
    pub fn definition() -> ToolDefinition {
        ToolDefinition {
