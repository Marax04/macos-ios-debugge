        ));
        c.remove_breakpoint(ZKind::Software, 0x1_0000, 4).unwrap();
        let sent = c.transport().sent_str();
        assert!(sent.contains("Z0,10000,4"));
        assert!(sent.contains("z0,10000,4"));
    }

